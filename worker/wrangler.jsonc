{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ptechsolutions-intercom",
  "account_id": "a60af2542282e283101650bebed42dcf",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Flue generates one Durable Object class per agent; the migration history
  // is user-owned — append new entries, never rewrite deployed tags.
  "migrations": [
    { "tag": "flue-class-FlueIntercomAgent", "new_sqlite_classes": ["FlueIntercomAgent"] },
  ],

  // The work queue's watchdog (src/cloudflare.ts): reap lapsed leases and mail
  // Ali about approved work no node can take.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Workers Logs: request lines and console output, queryable after the fact
  // (what ChatGPT asked /mcp for when it refused the server, for instance).
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Non-secret configuration. Secrets (API keys, tokens) are NEVER listed
  // here — set them with `wrangler secret put NAME` (see README.md).
  "vars": {
    "CONTACT_FROM_EMAIL": "intercom@ptechsolutions.net",
    "PORTAL_FROM_EMAIL": "portal@ptechsolutions.net",
    "ADMIN_EMAIL": "malipetek@gmail.com",
    "SITE_URL": "https://malipetek.dev",
    "PORTAL_URL": "https://ptechsolutions.net",
    // The redirect_uri origin for Cloudflare/GitHub OAuth. Must be a callback
    // the OAuth client lists; switch to https://ptechsolutions.net after adding
    // https://ptechsolutions.net/api/portal/cloudflare/callback to it.
    "OAUTH_CALLBACK_BASE": "https://malipetek.dev",
    // Email Routing: send reply@ (subaddressing on) and new@ to this Worker.
    "REPLY_ADDRESS": "reply@ptechsolutions.net",
    // Outreach mail: cold and warm email, and the inbox replies land in.
    "MARKETING_FROM_EMAIL": "hello@malipetek.dev",
    // Amazon SES, when the desk's sender is set to it (keys are secrets).
    "AWS_SES_REGION": "us-east-1",
  },

  // A path on the zone that already resolves, so nothing depends on
  // *.workers.dev — which one machine's resolver refuses outright.
  "routes": [
    { "pattern": "malipetek.dev/api/*", "zone_name": "malipetek.dev" }
  ],

  // Client portal store. Create once with:
  //   wrangler d1 create malipetek-portal
  // paste the returned database_id below, then apply the schema:
  //   wrangler d1 migrations apply malipetek-portal --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "malipetek-portal",
      "database_id": "d659e9f0-75fb-4b7a-8611-ca10b0218189",
      "migrations_dir": "migrations",
    },
    // Public agentic coding knowledgebase. Owned by the standalone
    // agentic-coding-kb Worker historically; the site now reads the same
    // database and this Worker is the only writer.
    {
      "binding": "KB_DB",
      "database_name": "agentic-coding-kb",
      "database_id": "70a1d6f4-f3b9-4b31-b372-e9bc5d78a20c",
    },
  ],

  // Per-IP rate limiting. Create the namespace once with:
  //   wrangler kv namespace create RATE_LIMIT
  // then paste the returned id below.
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "b4c27da115ed4625841a4b30d7e8fbec" },
  ],

  // Ticket attachments (src/files.ts). Create once with:
  //   wrangler r2 bucket create malipetek-portal-files
  // Hosted site deploys (src/sites.ts), served by the malipetek-sites Worker:
  //   wrangler r2 bucket create malipetek-sites
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "malipetek-portal-files" },
    { "binding": "SITES", "bucket_name": "malipetek-sites" },
  ],

  // Workers AI: m2m100, the translation bridge's fallback engine (src/translate.ts).
  // DeepSeek is the main one: `wrangler secret put DEEPSEEK_API_KEY`.
  "ai": { "binding": "AI" },

  // Cloudflare Email Service. Requires ptechsolutions.net (portal mail) and
  // malipetek.dev (outreach) to be onboarded to Email Sending — the sender
  // address must live on an onboarded domain.
  // destination_address pins every send to Ali's inbox.
  "send_email": [
    { "name": "EMAIL", "destination_address": "malipetek@gmail.com" },
    // Portal mail to clients (magic links, replies, status changes). No
    // destination pin, so the sender is pinned instead.
    { "name": "MAILER", "allowed_sender_addresses": ["portal@ptechsolutions.net"] },
    // Outreach (src/marketing.ts). A separate sender so a cold-email problem
    // cannot damage the portal's reputation, and so the admin views can tell
    // the two streams apart.
    { "name": "MARKETING", "allowed_sender_addresses": ["hello@malipetek.dev"] },
  ],
}
