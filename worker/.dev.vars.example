# Copy to worker/.dev.vars for `vite dev`. Never commit the real file.
# Anything that is a real credential belongs in `wrangler secret put` for deploy.

OPENROUTER_API_KEY=

# Leave empty to skip Turnstile verification while developing.
TURNSTILE_SECRET_KEY=

# Optional — handoffs are only stored when both are set.
DIRECTUS_URL=https://directus.example.com
DIRECTUS_TOKEN=

# Used to sign short-lived chat session tokens and derive conversation ids.
# Any long random string.
SESSION_SECRET=change-me-in-production

CONTACT_FROM_EMAIL=intercom@malipetek.dev

# Client portal, local only: magic links point at the Astro dev server, and
# /auth/request returns the link in its response so you can click it without
# real email. Never set DEV_RETURN_LINK in production.
SITE_URL=http://localhost:4321
DEV_RETURN_LINK=1

# Fleet node API (see fleet/README.md). Any string locally.
RUNNER_TOKEN=dev-runner-token
