# Front-end build-time config for the intercom. These are PUBLIC values (they
# end up in the browser bundle), so no secrets belong here.
#
# Leave PUBLIC_CHAT_ENDPOINT unset to use the offline mock in
# src/lib/chatBackend.js. Point it at the Worker (see worker/README.md) to go
# live. PUBLIC_TURNSTILE_SITEKEY is the Turnstile *site* key (not the secret).
PUBLIC_CHAT_ENDPOINT=
PUBLIC_TURNSTILE_SITEKEY=
