---
/*
 * The assistant page, shared by /agents and /<locale>/agents: how a client
 * lets their own AI assistant work in their account. One action: copy the
 * agent instructions (src/lib/agentInstructions.js) and paste them into the
 * assistant. ChatGPT and Claude get a plugin each, coming; other assistants
 * open the same instructions from a link, like the footer's "Ask AI".
 */
import '../styles/kb.css';
import { AGENT_INSTRUCTIONS, AGENT_INSTRUCTIONS_URL } from '../lib/agentInstructions.js';

interface Props {
  t: (key: string, vars?: Record<string, string | number>) => string;
  /** The page's language; the route's own links stay on it. */
  locale: string;
}

const { t } = Astro.props;

/** The ask the other assistants open with: read the instructions, then help. */
const ask = encodeURIComponent(
  `Read ${AGENT_INSTRUCTIONS_URL} and help me connect my AI assistant to my malipetek.dev account.`,
);
const OTHERS = [
  { label: 'Perplexity', href: `https://www.perplexity.ai/search/new?q=${ask}` },
  { label: 'Google', href: `https://www.google.com/search?udm=50&aep=11&q=${ask}` },
  { label: 'Grok', href: `https://grok.com/?q=${ask}` },
];
---

<main class="wrap kb assistant">
  <header class="kb-head">
    <p class="kb-kicker">{t('site.assistant.kicker')}</p>
    <h1>{t('site.assistant.heading')}</h1>
    <p class="kb-lede">{t('site.assistant.lede')}</p>
    <div class="assistant-copy">
      <button
        class="btn btn--solid"
        type="button"
        data-copy-agent={AGENT_INSTRUCTIONS}
        data-label={t('site.assistant.copy')}
      >
        {t('site.assistant.copy')}
      </button>
      <p class="assistant-note">
        {t('site.assistant.copyNote')}
        <a href="/agents.md">agents.md</a>
      </p>
    </div>
  </header>

  <section class="kb-block">
    <h2>{t('site.assistant.plugins.title')}</h2>
    <ul class="assistant-plugins">
      {['ChatGPT', 'Claude'].map((name) => (
        <li>
          <strong>{name}</strong>
          <span class="assistant-soon">{t('site.assistant.plugins.soon')}</span>
        </li>
      ))}
    </ul>
    <p class="assistant-note assistant-after">{t('site.assistant.plugins.body')}</p>
  </section>

  <section class="kb-block">
    <h2>{t('site.assistant.others.title')}</h2>
    <p class="assistant-others">
      <span>{t('site.assistant.others.body')}</span>
      {OTHERS.map((o) => (
        <a href={o.href} target="_blank" rel="noopener noreferrer">{o.label}</a>
      ))}
    </p>
  </section>
</main>

<script>
  import { initCopyAgentInstructions } from '../scripts/copy-agent-instructions';
  initCopyAgentInstructions();
</script>

<style>
  .assistant-copy {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    margin-top: 1.4rem;
  }

  .assistant-copy .btn {
    font: inherit;
    cursor: pointer;
  }

  .assistant-note {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .assistant-after {
    margin-top: 0.9rem;
  }

  .assistant-plugins {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .assistant-plugins li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    border: 1px dashed var(--rule-strong);
    border-radius: 10px;
  }

  .assistant-soon {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-soft);
  }

  .assistant-others {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
    font-size: 15px;
  }

  .assistant-others span {
    color: var(--ink-soft);
  }
</style>
