---
/*
 * The assistant-setup page, shared by /agents and /<locale>/agents. Tool
 * names, URLs, the protocol version and the `cat_` key prefix stay as they
 * are in every language; the prose around them comes from the page catalog.
 */
import '../styles/kb.css';

interface Props {
  t: (key: string, vars?: Record<string, string | number>) => string;
  /** The page's language; the route's own links stay on it. */
  locale: string;
}

const { t } = Astro.props;

const PORTAL_TOOLS = [
  { name: 'portal_projects / portal_requests / portal_request', text: t('site.agents.tool.projects') },
  { name: 'portal_file_request', text: t('site.agents.tool.file') },
  { name: 'portal_reply', text: t('site.agents.tool.reply') },
  { name: 'portal_set_budget', text: t('site.agents.tool.budget') },
  { name: 'portal_withdraw', text: t('site.agents.tool.withdraw') },
];
---

<main class="wrap kb">
  <header class="kb-head">
    <p class="kb-kicker">{t('site.agents.kicker')}</p>
    <h1>{t('site.agents.heading')}</h1>
    <p class="kb-lede">
      <a href="/mcp"><code>https://malipetek.dev/mcp</code></a>
      <br />
      {t('site.agents.lede')}
    </p>
  </header>

  <section class="kb-block">
    <h2>{t('site.agents.connect.title')}</h2>
    <div class="kb-prose">
      <p>
        {t('site.agents.connect.url')} <code>https://malipetek.dev/mcp</code>.
        {t('site.agents.connect.discovery')}
        <a href="/.well-known/mcp-server.json"><code>/.well-known/mcp-server.json</code></a>.
      </p>

      <h3>{t('site.agents.chatgpt.title')}</h3>
      <p>
        {t('site.agents.chatgpt.before')}
        <strong>Settings → Connectors → Advanced → Developer mode</strong>{t('site.agents.chatgpt.after')}
      </p>
      <pre><code>Name:  malipetek.dev
URL:   https://malipetek.dev/mcp
Auth:  Bearer cat_…   # the key from your portal</code></pre>

      <h3>{t('site.agents.claude.title')}</h3>
      <p>
        {t('site.agents.claude.before')}
        <strong>Settings → Connectors → Add custom connector</strong>.
        {t('site.agents.claude.cursor')}
        <code>mcp.json</code>:
      </p>
      <pre><code>&#123; "mcpServers": &#123; "malipetek": &#123; "url": "https://malipetek.dev/mcp" &#125; &#125; &#125;</code></pre>

      <h3>{t('site.agents.noClient.title')}</h3>
      <pre><code>curl -s https://malipetek.dev/mcp -H 'content-type: application/json' \
  -H "authorization: Bearer cat_…" \
  -d '&#123;"jsonrpc":"2.0","id":1,"method":"tools/list"&#125;'</code></pre>
    </div>
  </section>

  <section class="kb-block">
    <h2>{t('site.agents.key.title')}</h2>
    <div class="kb-prose">
      <p>
        <a href="/portal">{t('site.agents.key.signin')}</a>
        {t('site.agents.key.body')}
      </p>
      <p>{t('site.agents.key.body2')}</p>
    </div>
  </section>

  <section class="kb-block">
    <h2>{t('site.agents.tools.title')}</h2>
    <ul class="kb-tool-list">
      {PORTAL_TOOLS.map((tool) => (
        <li>
          <code>{tool.name}</code>
          <span class="kb-tool-auth">{t('site.agents.tools.auth')}</span>
          <span class="kb-tool-text">{tool.text}</span>
        </li>
      ))}
    </ul>
    <p class="kb-entry-foot">
      {t('site.agents.tools.first')}
      {t('site.agents.tools.names')}
      <code>start_change</code>, <code>project_context</code>, <code>workspace_files</code>,
      <code>workspace_read</code>, <code>submit_change</code>,
      <code>preview_build</code>, <code>finish_change</code>, <code>site_publish</code>. {t('site.agents.tools.after')}
    </p>
  </section>

  <section class="kb-block">
    <h2>{t('site.agents.lab.title')}</h2>
    <div class="kb-prose">
      <p>
        {t('site.agents.lab.before')}
        <a href="https://lab.malipetek.dev">lab.malipetek.dev</a>.
        {t('site.agents.lab.endpoint')}
        <code>https://lab.malipetek.dev/mcp</code>{t('site.agents.lab.after')}
      </p>
      <p>
        {t('site.agents.lab.setup')}
        <a href="https://lab.malipetek.dev/kb/agents">lab.malipetek.dev/kb/agents</a>.
      </p>
    </div>
  </section>
</main>
