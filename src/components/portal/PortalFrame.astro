---
/*
 * The portal's first frame, drawn by the page itself. The portal is a React
 * island that mounts after the first paint, and a page transition takes its
 * picture of the new page at that paint: without this frame the "malipetek"
 * mark arriving from the site would have nowhere to go, and neither would the
 * machine the site's board shows.
 *
 * It is the shell the app draws either way — sidebar, the board's window, an
 * empty content area — so a visitor coming in from the site lands in the room
 * they will work in, signed in or not. ClientPortal removes it on mount, or
 * when the transition into the page ends.
 */
---

<script is:inline>
  // A transition drops out the moment one of its elements stops rendering,
  // so while one is bringing the mark here the frame keeps it and the app's
  // own copy waits hidden (client-portal.css); ClientPortal swaps them when
  // it ends.
  addEventListener("pagereveal", (e) => {
    // A page restored from the back/forward cache has no frame left.
    if (!e.viewTransition || !document.querySelector("[data-portal-frame]")) return;
    document.documentElement.dataset.portalArriving = "";
    window.portalArrival = e.viewTransition.finished;
  });
</script>
<div id="portal-frame" data-portal-frame aria-hidden="true">
  <div class="cp cp--guest">
    <header class="cp-topbar">
      <span class="cp-iconbtn"></span>
      <span class="cp-brand"><a class="cp-brand__root" href="/">malipetek</a><a class="cp-brand__site" href="/portal">/portal</a></span>
      <span class="cp-iconbtn"></span>
    </header>
    <aside class="cp-side">
      <span class="cp-brand cp-side__brand"><a class="cp-brand__root" href="/">malipetek</a><a class="cp-brand__site" href="/portal">/portal</a></span>
    </aside>
    <main class="cp-main">
      <div class="cp-view cp-view--board">
        <div class="cp-board cp-board--guest">
          <div class="cp-board__stage" data-board-window></div>
        </div>
      </div>
    </main>
  </div>
</div>
