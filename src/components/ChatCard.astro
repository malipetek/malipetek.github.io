---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---

<correspondence-card class="chat-panel">
  <header class="chat-head">
    <span>correspondence №&nbsp;<span class="corr-num">01</span></span>
    <span class="chat-status">desk copy</span>
  </header>
  <div class="chat-log" role="log" aria-live="polite" aria-label="Conversation with the desk copy"></div>
  <div class="chat-sugg">
    {['who are you', 'your stack', 'shopify work', 'hire you'].map((s) => (
      <button class="chat-chip" type="button">{s}</button>
    ))}
  </div>
  <form class="chat-form">
    <input type="text" name="note" placeholder="write a note…" autocomplete="off" maxlength="280" aria-label="Message" />
    <button type="submit" class="chat-send">send</button>
  </form>
  {!compact && <p class="chat-fineprint">answered locally by the desk copy · the real pipeline is pending</p>}
</correspondence-card>

<script>
  import { reply } from '../lib/chatBackend.js';

  const GREETING = 'Card found. I am the desk copy of Muhammet — rules, not a model, until the real pipeline gets wired back. Ask anyway.';

  document.querySelectorAll('correspondence-card').forEach((root) => {
    const logEl = root.querySelector('.chat-log');
    const form = root.querySelector('.chat-form');
    const input = form.querySelector('input');

    const addMsg = (who, text) => {
      const div = document.createElement('div');
      div.className = `chat-msg ${who}`;
      div.textContent = text;
      const meta = document.createElement('span');
      meta.className = 'chat-meta';
      const time = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      meta.textContent = who === 'me' ? `written ${time}` : `received ${time}`;
      div.appendChild(meta);
      logEl.appendChild(div);
      logEl.scrollTop = logEl.scrollHeight;
    };

    addMsg('them', GREETING);

    const send = async (text) => {
      if (!text.trim()) return;
      addMsg('me', text);
      input.value = '';
      const typing = document.createElement('div');
      typing.className = 'chat-msg them chat-typing';
      typing.innerHTML = '<i></i><i></i><i></i>';
      logEl.appendChild(typing);
      logEl.scrollTop = logEl.scrollHeight;
      const answer = await reply(text);
      typing.remove();
      addMsg('them', answer);
    };

    form.addEventListener('submit', (e) => { e.preventDefault(); send(input.value); });
    root.querySelectorAll('.chat-chip').forEach((chip) =>
      chip.addEventListener('click', () => send(chip.textContent)));
  });
</script>
