---
interface Props {
  greeting: string;
  suggestions?: string[];
  email: string;
  availability?: 'open' | 'limited' | 'closed';
}

const {
  greeting,
  suggestions = [],
  email,
  availability = 'limited',
} = Astro.props;

const greetingAttr = greeting.replace(/\s+/g, ' ').trim();

// Availability is a fact from site.yaml, so it belongs in the idle half of the
// field rather than buried in the conversation.
const AVAILABILITY = {
  open: 'Open to new work right now.',
  limited: 'Limited availability — notes still get read.',
  closed: 'Not taking new work right now — notes still get read.',
};
const availabilityText = AVAILABILITY[availability] ?? AVAILABILITY.limited;
---

<section
  class="intercom"
  id="talk"
  data-intercom
  data-greeting={greetingAttr}
  data-state="idle"
  aria-labelledby="intercom-title"
>
  <div class="intercom-inner">
    <div class="intercom-lead">
      <h2 class="intercom-title" id="intercom-title">Ring the bell.</h2>

      <button class="bell" type="button" data-bell aria-expanded="false" aria-controls="intercom-live">
        <svg
          class="bell-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6.2 9.4a5.8 5.8 0 0 1 11.6 0c0 3.6 1.2 5.1 1.9 5.9H4.3c.7-.8 1.9-2.3 1.9-5.9Z" />
          <path d="M10.3 18.7a1.8 1.8 0 0 0 3.4 0" />
          <path d="M12 3.6V2.4" />
        </svg>
        <span class="sr-only">Ring the bell and start a conversation with Ali's assistant</span>
      </button>

      <p class="intercom-fallback" data-fallback>
        Rather email? <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>

    <div class="intercom-idle" data-idle>
      {suggestions.length > 0 && (
        <div class="idle-ask">
          <h3 class="idle-title">Things people ask</h3>
          <div class="idle-chips">
            {suggestions.map((s) => (
              <button class="chat-chip" type="button" data-idle-chip>{s}</button>
            ))}
          </div>
        </div>
      )}
      <p class="idle-availability" data-availability>
        <span class="idle-dot" aria-hidden="true"></span>
        <span>{availabilityText}</span>
      </p>
    </div>

    <div class="intercom-live" id="intercom-live" data-live>
      <div class="intercom-live-inner">
        <div
          class="chat-log"
          data-log
          role="log"
          aria-live="off"
          aria-label="Conversation with Ali's assistant"
        ></div>

        {suggestions.length > 0 && (
          <div class="chat-suggestions" data-suggestions aria-label="Suggested questions">
            {suggestions.map((s) => (
              <button class="chat-chip" type="button" data-chip>{s}</button>
            ))}
          </div>
        )}

        <div class="composer" data-input>
          <form class="chat-form" data-form>
            <label class="sr-only" for="intercom-note">Message</label>
            <input
              id="intercom-note"
              type="text"
              name="note"
              placeholder="Write a note…"
              autocomplete="off"
              maxlength="500"
              data-note
            />
            <button type="submit" class="send" data-send>Send</button>
          </form>
        </div>

        <form class="handoff" data-handoff hidden>
          <p class="handoff-title">Leave a note for Ali</p>
          <div class="field">
            <label for="handoff-email">Your email</label>
            <input
              id="handoff-email"
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              data-handoff-email
            />
          </div>
          <div class="field">
            <label for="handoff-summary">Anything else he should know?</label>
            <textarea id="handoff-summary" name="summary" rows="3" data-handoff-summary></textarea>
          </div>
          <button type="submit" class="send send--wide" data-handoff-send>Send to Ali</button>
          <p class="handoff-error" data-handoff-error hidden></p>
        </form>

        <p class="sr-only" data-announce role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { streamAnswer, chunkText, sendHandoff } from '../lib/chatBackend.js';

  type Role = 'me' | 'them';
  type Msg = { role: Role; text: string };
  type State =
    | 'idle'
    | 'ringing'
    | 'typing'
    | 'streaming'
    | 'ready'
    | 'handoff'
    | 'sent'
    | 'error'
    | 'rate-limited';

  const root = document.querySelector<HTMLElement>('[data-intercom]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const bell = root.querySelector<HTMLButtonElement>('[data-bell]')!;
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const suggestions = root.querySelector<HTMLElement>('[data-suggestions]');
    const composer = root.querySelector<HTMLElement>('[data-input]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-note]')!;
    const sendBtn = root.querySelector<HTMLButtonElement>('[data-send]')!;
    const handoff = root.querySelector<HTMLFormElement>('[data-handoff]')!;
    const handoffEmail = root.querySelector<HTMLInputElement>('[data-handoff-email]')!;
    const handoffSummary = root.querySelector<HTMLTextAreaElement>('[data-handoff-summary]')!;
    const announceEl = root.querySelector<HTMLElement>('[data-announce]')!;
    const fallback = root.querySelector<HTMLElement>('[data-fallback]');
    const idleChips = root.querySelectorAll<HTMLButtonElement>('[data-idle-chip]');
    const handoffSendBtn = root.querySelector<HTMLButtonElement>('[data-handoff-send]')!;
    const handoffError = root.querySelector<HTMLElement>('[data-handoff-error]');

    const greeting = root.dataset.greeting ?? '';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const history: Msg[] = [];
    let state: State = 'idle';
    let typing: HTMLElement | null = null;
    let rateTimer: number | undefined;

    const setState = (next: State) => {
      state = next;
      root.dataset.state = next;
    };

    const scrollLog = () => {
      log.scrollTop = log.scrollHeight;
    };

    const addBubble = (role: Role, text = '') => {
      const el = document.createElement('div');
      el.className = `msg msg--${role}`;
      el.textContent = text;
      log.appendChild(el);
      scrollLog();
      return el;
    };

    const showTyping = () => {
      if (typing) return;
      typing = document.createElement('div');
      typing.className = 'msg msg--them msg--typing';
      typing.setAttribute('aria-hidden', 'true');
      typing.innerHTML = '<i></i><i></i><i></i>';
      log.appendChild(typing);
      scrollLog();
    };

    const hideTyping = () => {
      typing?.remove();
      typing = null;
    };

    const announce = (text: string) => {
      announceEl.textContent = '';
      requestAnimationFrame(() => {
        announceEl.textContent = text;
      });
    };

    /* Stream `text` into a bubble. Returns once the text is fully shown. */
    const streamBubble = async (text: string) => {
      let bubble: HTMLElement | null = null;
      if (reduce) {
        hideTyping();
        bubble = addBubble('them', text);
      } else {
        for (const chunk of chunkText(text)) {
          if (!bubble) {
            hideTyping();
            bubble = addBubble('them');
            bubble.classList.add('is-streaming');
            setState('streaming');
          }
          bubble.textContent += chunk;
          scrollLog();
          await wait(24 + Math.random() * 32);
        }
        if (!bubble) {
          hideTyping();
          bubble = addBubble('them', text);
        }
        bubble.classList.remove('is-streaming');
      }
      scrollLog();
      return bubble;
    };

    const showHandoff = (summary: string) => {
      setState('handoff');
      handoffSummary.value = summary;
      handoffEmail.value = '';
      composer.hidden = true;
      handoff.hidden = false;
      handoffEmail.focus({ preventScroll: true });
      announce('Ali can take it from here. Leave your email and anything else he should know. I filled in a summary you can edit.');
    };

    const noteError = () => {
      setState('error');
      fallback?.classList.add('is-alert');
      input.disabled = true;
      sendBtn.disabled = true;
      input.placeholder = 'Line down';
    };

    const noteRateLimited = () => {
      setState('rate-limited');
      input.disabled = true;
      sendBtn.disabled = true;
      announce('Too many notes for now. Give it a minute, or email instead.');
      window.clearTimeout(rateTimer);
      rateTimer = window.setTimeout(() => {
        input.disabled = false;
        sendBtn.disabled = false;
        setState('ready');
      }, 8000);
    };

    const ring = async () => {
      if (state !== 'idle') return;
      setState('ringing');
      bell.setAttribute('aria-expanded', 'true');
      bell.classList.add('is-ringing');
      root.classList.add('is-live');
      announce('Ringing.');
      if (!reduce) await wait(720);
      bell.classList.remove('is-ringing');
      setState('typing');
      showTyping();
      if (!reduce) await wait(520);
      await streamBubble(greeting);
      announce(greeting);
      setState('ready');
      input.focus({ preventScroll: true });
    };

    const send = async (raw: string) => {
      const text = raw.trim();
      if (!text) return;
      if (state === 'ringing' || state === 'typing' || state === 'streaming' || state === 'handoff' || state === 'sent') return;
      if (state === 'error') return;

      addBubble('me', text);
      announce(`You: ${text}`);
      history.push({ role: 'me', text });
      input.value = '';
      if (suggestions) suggestions.hidden = true;

      setState('typing');
      showTyping();
      if (!reduce) await wait(360);

      const prior = history.slice(0, -1);
      let bubble: HTMLElement | null = null;
      let end: { kind: string; handoff: string | null } | null = null;

      for await (const ev of streamAnswer(text, prior) as AsyncGenerator<
        { type: 'chunk'; text: string } | { type: 'end'; kind: string; handoff: string | null }
      >) {
        if (ev.type === 'chunk') {
          if (!bubble) {
            hideTyping();
            bubble = addBubble('them');
            bubble.classList.add('is-streaming');
            setState('streaming');
          }
          bubble.textContent += ev.text;
          scrollLog();
          if (!reduce) await wait(24 + Math.random() * 32);
        } else {
          end = ev;
        }
      }

      if (bubble) bubble.classList.remove('is-streaming');
      const finalText = bubble?.textContent ?? '';
      if (finalText) {
        history.push({ role: 'them', text: finalText });
        announce(finalText);
      }

      if (end?.kind === 'handoff') {
        if (!reduce) await wait(380);
        showHandoff(end.handoff ?? '');
        return;
      }
      if (end?.kind === 'error') return noteError();
      if (end?.kind === 'rate') return noteRateLimited();
      setState('ready');
    };

    /* ——— wiring ——— */

    bell.addEventListener('click', () => void ring());

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void send(input.value);
    });

    suggestions?.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((chip) => {
      chip.addEventListener('click', () => void send(chip.textContent ?? ''));
    });

    // The idle chips are the invitation: ring the bell, then ask that question.
    idleChips.forEach((chip) => {
      chip.addEventListener('click', async () => {
        if (state !== 'idle') return;
        await ring();
        void send(chip.textContent ?? '');
      });
    });

    handoff.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!handoff.reportValidity()) return;
      const emailValue = handoffEmail.value.trim();
      const summaryValue = handoffSummary.value.trim();
      handoffSendBtn.disabled = true;
      if (handoffError) handoffError.hidden = true;

      try {
        await sendHandoff({ email: emailValue, message: summaryValue, summary: summaryValue });
        history.push({ role: 'me', text: `Email: ${emailValue}` });
        handoff.hidden = true;
        composer.hidden = true;
        setState('sent');
        const sent = addBubble('them', 'Delivered. Ali reads these himself.');
        sent.classList.add('msg--sent');
        announce('Delivered. Ali reads these himself.');
      } catch {
        handoffSendBtn.disabled = false;
        fallback?.classList.add('is-alert');
        if (handoffError) {
          handoffError.hidden = false;
          handoffError.textContent = "Line's down — email instead.";
        }
        announce("Line's down — email instead.");
      }
    });

    /* ————————————————————————————————————————————————
       Demo/test hook — DEV ONLY. It renders a deterministic snapshot of
       every state for screenshots and manual review. Vite strips the whole
       block from production bundles.
       ———————————————————————————————————————————————— */
    if (import.meta.env.DEV) {
      const reset = () => {
      log.innerHTML = '';
      history.length = 0;
      hideTyping();
      handoff.hidden = true;
      composer.hidden = false;
      input.disabled = false;
      sendBtn.disabled = false;
      input.placeholder = 'Write a note…';
      if (suggestions) suggestions.hidden = false;
      fallback?.classList.remove('is-alert');
      root.classList.remove('is-live');
      bell.setAttribute('aria-expanded', 'false');
      bell.classList.remove('is-ringing');
      setState('idle');
    };

    const DEMO_QUESTION = 'Is he available for a project?';
    const DEMO_HANDOFF =
      'Not taking new contracts right now, but notes still get read. Say what you are building and it reaches me.';
    const DEMO_SUMMARY =
      'The visitor wrote: “Is he available for a project?” Reply with a time that works for you.';

    const simulate = (name: State) => {
      reset();
      if (name === 'idle') return;
      root.classList.add('is-live');
      bell.setAttribute('aria-expanded', 'true');
      if (name === 'ringing') {
        setState('ringing');
        bell.classList.add('is-ringing');
        return;
      }
      addBubble('me', DEMO_QUESTION);
      if (suggestions) suggestions.hidden = true;
      if (name === 'typing') {
        setState('typing');
        showTyping();
        return;
      }
      if (name === 'streaming') {
        const b = addBubble('them', 'Not taking new contracts right now, but notes');
        b.classList.add('is-streaming');
        setState('streaming');
        return;
      }
      if (name === 'handoff') {
        addBubble('them', DEMO_HANDOFF);
        handoffSummary.value = DEMO_SUMMARY;
        handoffEmail.value = '';
        composer.hidden = true;
        handoff.hidden = false;
        setState('handoff');
        return;
      }
      if (name === 'sent') {
        addBubble('them', DEMO_HANDOFF);
        handoffEmail.value = 'visitor@example.com';
        const s = addBubble('them', 'Delivered. Ali reads these himself.');
        s.classList.add('msg--sent');
        composer.hidden = true;
        setState('sent');
        return;
      }
      if (name === 'error') {
        addBubble('them', "Line's down — email instead.");
        noteError();
        return;
      }
      if (name === 'rate-limited') {
        addBubble('them', 'That is a lot of notes at once. Give it a minute, or email instead.');
        noteRateLimited();
      }
    };

      (window as unknown as Record<string, unknown>).__intercom = {
        get state() {
          return state;
        },
        ring,
        send,
        reset,
        simulate,
      };
    }
  }
</script>

<style>
  /* ————— the orange field (full-bleed) ————— */

  .intercom {
    --gutter: max(0px, (100vw - 78rem) / 2);
    margin-top: clamp(2.5rem, 6vw, 4rem);
    margin-inline: calc(-1 * (var(--pad) + var(--gutter)));
    padding-inline: calc(var(--pad) + var(--gutter));
    padding-block: clamp(2.25rem, 6vw, 3.75rem);
    background: var(--orange);
    color: var(--ink);
    border-block: 2px solid var(--ink);
  }

  .intercom-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  /* The lead and the idle/live panel share the row so the idle chips fill the
     right half of the orange field instead of leaving it empty. */
  .intercom-lead {
    grid-column: 1;
    grid-row: 1;
  }

  .intercom-idle,
  .intercom-live {
    grid-column: 2;
    grid-row: 1;
  }

  .intercom a {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }

  .intercom a:hover {
    /* On the orange field, invert instead of highlighting orange-on-orange. */
    background: var(--ink);
    color: var(--bone);
    text-decoration-color: var(--bone);
  }

  /* ————— lead: the line + the bell ————— */

  .intercom-title {
    margin: 0 0 clamp(1.2rem, 3vw, 2rem);
    font-size: clamp(2.75rem, 6.5vw, 5.25rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
  }

  .bell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 120px;
    padding: 0;
    background: var(--ink);
    color: var(--bone);
    border: 2px solid var(--ink);
    border-radius: 50%;
    cursor: pointer;
    transform-origin: 50% 14%;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .bell:hover {
    background: transparent;
    color: var(--ink);
  }

  .bell:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .bell.is-ringing {
    animation: bell-ring 0.72s var(--ease);
  }

  .bell-icon {
    width: 46px;
    height: 46px;
  }

  @keyframes bell-ring {
    0%,
    100% {
      transform: rotate(0deg);
    }
    15% {
      transform: rotate(-14deg);
    }
    32% {
      transform: rotate(11deg);
    }
    50% {
      transform: rotate(-8deg);
    }
    68% {
      transform: rotate(5deg);
    }
    85% {
      transform: rotate(-2deg);
    }
  }

  .intercom-fallback {
    margin: clamp(1.1rem, 3vw, 1.6rem) 0 0;
    font-size: 15px;
  }

  .intercom-fallback.is-alert {
    font-weight: 600;
  }

  /* ————— idle panel: things people ask + availability ————— */

  .intercom-idle {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 3vw, 1.6rem);
    align-self: stretch;
    padding-top: 0.35rem;
  }

  .intercom.is-live .intercom-idle {
    display: none;
  }

  .idle-title {
    margin: 0 0 0.7rem;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .idle-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .idle-availability {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: auto 0 0;
    font-size: 15px;
    max-width: 34ch;
  }

  .idle-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--bone);
  }

  /* ————— live panel (expands open) ————— */

  .intercom-live {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    /* Hidden from tab order and AT until the bell rings, then revealed at once
       while the grid row animates open. */
    visibility: hidden;
    transition: grid-template-rows var(--dur) var(--ease), opacity var(--dur) var(--ease),
      visibility 0s linear var(--dur);
  }

  .intercom.is-live .intercom-live {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition: grid-template-rows var(--dur) var(--ease), opacity var(--dur) var(--ease),
      visibility 0s;
  }

  .intercom-live-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  /* ————— bubbles ————— */

  .chat-log {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-height: min(50vh, 430px);
    min-height: 68px;
    overflow-y: auto;
    padding-block: 0.2rem;
    scrollbar-width: thin;
  }

  /* Bubbles are created in JS, so they live outside Astro's style scope.
     Namespace the global selectors under .intercom to keep them contained. */
  :global(.intercom .msg) {
    max-width: 88%;
    padding: 0.6em 0.85em;
    font-size: 15px;
    line-height: 1.45;
    background: var(--bone);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 16px;
    overflow-wrap: anywhere;
    animation: msg-in 180ms var(--ease) both;
  }

  :global(.intercom .msg--them) {
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }

  :global(.intercom .msg--me) {
    align-self: flex-end;
    background: #e5ded0;
    border-bottom-right-radius: 4px;
  }

  :global(.intercom .msg--sent) {
    font-weight: 600;
  }

  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
  }

  :global(.intercom .msg--typing) {
    display: inline-flex;
    align-items: center;
    gap: 0;
    padding: 0.75em 0.9em;
  }

  :global(.intercom .msg--typing i) {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 50%;
    background: currentColor;
    animation: chat-dot 0.9s infinite;
  }

  :global(.intercom .msg--typing i:nth-child(2)) {
    animation-delay: 0.15s;
  }

  :global(.intercom .msg--typing i:nth-child(3)) {
    animation-delay: 0.3s;
  }

  @keyframes chat-dot {
    0%,
    60%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  :global(.intercom .msg.is-streaming)::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 2px;
    background: var(--ink);
    vertical-align: -0.15em;
    animation: caret 1s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* ————— suggestions ————— */

  .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chat-suggestions[hidden] {
    display: none;
  }

  .chat-chip {
    font-size: 14px;
    color: var(--ink);
    background: transparent;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.42em 0.85em;
    cursor: pointer;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .chat-chip:hover {
    background: var(--ink);
    color: var(--bone);
  }

  /* ————— composer + handoff card (the one soft panel) ————— */

  .composer[hidden],
  .handoff[hidden] {
    display: none;
