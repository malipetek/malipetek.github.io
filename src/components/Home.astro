---
/*
 * The contracting homepage: the offer, how it works, and the intercom.
 *
 * The shelf, writing, work, knowledgebase and plugins moved to the lab
 * (src/components/Lab.astro) when malipetek.dev became the client portal's
 * site. One component per site, so neither has to explain the other.
 */
import Intercom from "./Intercom.astro";
import WorkshopScene from "./WorkshopScene.astro";
import { getCollection } from "astro:content";
import {
  BRING_YOUR_OWN,
  CONTRAST,
  DEFINITION,
  FROM_IDEA,
  KIND as OFFER_KIND,
  NEXT,
  PRICE_NOTE,
  PRICE_RULE,
  PRICE_WHY,
  HEADLINE,
  PRICE_HOOK,
  PUNCHLINE,
  SAFEGUARDS,
  SERVERLESS,
  STEPS,
  WHO,
  WHY_NOT,
} from "../lib/offer.js";
import { ATTENTION, HOURLY_USD, clock, money, timeCents } from "../lib/pricing.js";
import { copy } from "../lib/site.js";

const { t } = Astro.props;

/** What the quickest kind of job costs, the same arithmetic as offer.js. */
const QUICK_FIX = money(timeCents(ATTENTION.find((a) => a.key === "auto")?.typicalSeconds ?? 60));

const site = (await getCollection("site"))[0]?.data;
const intercomGreeting =
  site?.intercomGreeting ??
  "Ali's line. I'm the assistant that knows how he works. Tell me what you need built or fixed.";
const intercomSuggestions = site?.intercomSuggestions ?? [];
const email = site?.email ?? "malipetek@gmail.com";
const availability = site?.availability ?? "limited";
---

<div class="rails" aria-hidden="true"></div>
<WorkshopScene />

<section class="room room--masthead" data-station="hero">
  <div class="masthead-inner">
    <p class="masthead-who">
      <img
        class="masthead-portrait"
        src="/me.webp"
        alt="Muhammet Ali Petek"
        width="120"
        height="120"
        loading="eager"
      />
      <span>
        <strong>M. Ali Petek</strong>
        <span class="masthead-kind">{copy(t, "offer.kind", OFFER_KIND)}</span>
      </span>
    </p>
    <h1 class="masthead-name">{copy(t, "offer.headline.1", HEADLINE[0])}<br />{copy(t, "offer.headline.2", HEADLINE[1])}</h1>
    <div class="masthead-body">
      <p class="masthead-hook">{copy(t, "offer.next", NEXT)}</p>
      <p class="masthead-proof">{copy(t, "offer.priceHook", PRICE_HOOK, { price: QUICK_FIX })}</p>
      <p class="masthead-from-idea"><a href="/portal/start">{copy(t, "offer.fromIdea", FROM_IDEA)}</a></p>
      <div class="masthead-actions">
        <a class="btn btn--solid" href="/portal/start">{t("site.home.cta.next")}</a>
        <a class="btn" href="#how">{t("site.home.cta.how")}</a>
      </div>
      <p class="masthead-note"><strong>{copy(t, "offer.punchline.1", PUNCHLINE[0])} {copy(t, "offer.punchline.2", PUNCHLINE[1])}</strong> {copy(t, "offer.priceNote", PRICE_NOTE, { rate: HOURLY_USD })}</p>
    </div>
  </div>
</section>

<section class="room room--panel" id="how" data-station="how">
  <div class="plate frame">
    <div class="block-head">
      <h2><span class="room-no" aria-hidden="true">01</span>{t("site.home.how.title")}</h2>
      <p class="block-note">{copy(t, "offer.who", WHO)}</p>
    </div>

    <p class="define">
      {copy(t, "offer.define", DEFINITION)}
      <span class="define-contrast">{copy(t, "offer.contrast", CONTRAST)}</span>
    </p>

    <ol class="steps">
      {
        STEPS.map((step, i) => (
          <li class="step">
            <span class="step-no" aria-hidden="true">{i + 1}</span>
            <h3>{copy(t, `offer.step.${step.key}.title`, step.title)}</h3>
            <p>{copy(t, `offer.step.${step.key}.body`, step.body)}</p>
          </li>
        ))
      }
    </ol>

    <p class="byo">{copy(t, "offer.byo", BRING_YOUR_OWN)}</p>

    <div class="price">
      <div class="price-head">
        <h3>{t("site.home.price.title")}</h3>
        <p>{copy(t, "offer.priceRule", PRICE_RULE)}</p>
        <p>{copy(t, "offer.priceWhy", PRICE_WHY)}</p>
      </div>
      <div class="terms">
        {
          ATTENTION.map((a) => (
            <div class="term">
              <h3>
                {copy(t, `pricing.attention.${a.key}.name`, a.name)}
                <span>
                  {a.typicalSeconds
                    ? t("site.home.term.example", {
                        time: clock(a.typicalSeconds),
                        price: money(timeCents(a.typicalSeconds)),
                      })
                    : t("site.home.term.hourly", { price: money(timeCents(3600)) })}
                </span>
              </h3>
              <p>{copy(t, `pricing.attention.${a.key}.what`, a.what)}</p>
            </div>
          ))
        }
      </div>
      <p class="price-foot">
        <strong>{copy(t, "offer.serverless.title", SERVERLESS.title)}.</strong>
        {copy(t, "offer.serverless.body", SERVERLESS.body)}
      </p>
    </div>

    <div class="why">
      <h3 class="why-title">{t("site.home.why.title")}</h3>
      <div class="terms whys">
        {
          WHY_NOT.map((w) => (
            <div class="term">
              <h3>…{copy(t, `offer.why.${w.key}.instead`, w.instead)}?</h3>
              <p>{copy(t, `offer.why.${w.key}.answer`, w.answer, { price: QUICK_FIX })}</p>
            </div>
          ))
        }
      </div>
      <ul class="safeguards" aria-label={t("site.home.safeguards.label")}>
        {SAFEGUARDS.map((line, i) => <li>{copy(t, `offer.safeguard.${i + 1}`, line)}</li>)}
      </ul>
    </div>
  </div>
</section>

<Intercom
  greeting={intercomGreeting}
  suggestions={intercomSuggestions}
  email={email}
  availability={availability}
/>

<script>
  // On a direct load with a hash (e.g. /#talk), the browser's fragment scroll
  // races scroll restoration + snap proximity and can land one room short.
  // Re-assert the target once everything has settled.
  if (location.hash) {
    const land = () =>
      document
        .querySelector<HTMLElement>(location.hash)
        ?.scrollIntoView({ behavior: "instant", block: "start" });
    window.addEventListener("load", () => setTimeout(land, 60));
    setTimeout(land, 600);
  }
</script>

<style>
  /* The canvas is flat --bone where no station objects sit, so DOM text stays
     readable without extra backing. Opaque pieces (the intercom) cover the
     scene — that's the "2d on top" split. No z-index on main: the page rails
     (z 0), the transparent canvas (z 0, later in the DOM) and the rooms (z 1)
     must share one stacking context, so the props occlude the rails and the
     text sits over both. */

  /* Rooms are full-viewport; the layout's main padding would push the first
     room down. */
  :global(main) {
    padding-block: 0;
  }

  /* The intercom is the last room; its translucent orange field lets the
     beacon glow through. Needs position/z-index to paint over the fixed
     canvas. */
  :global(.intercom) {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  /* The category, defined where the reader first meets it. */
  .define {
    margin: 0 0 1.25rem;
    max-width: 64ch;
    font-size: 17px;
    line-height: 1.55;
  }
  .define-contrast {
    display: block;
    margin-top: 0.4rem;
    color: var(--ink-soft);
  }
  .byo {
    margin: 1rem 0 1.5rem;
    max-width: 64ch;
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* ————— masthead ————— */

  /* The backing below reaches past the text on purpose; on a phone that is
     past the viewport, and the page scrolled sideways. clip, not hidden, so
     the section does not become a scroll container. */
  .room--masthead {
    overflow-x: clip;
  }

  .masthead-inner {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    /* The diorama owns the right side on wide screens (see workshop3d). */
    max-width: min(100%, 46rem);
    /* Above the fixed scene layer (z-index 0), which otherwise draws over
       the text wherever the two overlap. */
    position: relative;
    z-index: 1;
  }

  /* A soft backing for the text: page colour, strongest behind the words and
     fading to nothing at the edges, so the diorama reads around it with no
     hard line, and never through the words. */
  .masthead-inner::before {
    content: "";
    position: absolute;
    inset: -3.5rem -5rem -3.5rem -4rem;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--bone) 92%, transparent) 62%,
      color-mix(in srgb, var(--bone) 60%, transparent) 80%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* Who is behind it: small, human, first — a pill badge above the headline. */
  .masthead-who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    margin: 0;
    padding: 5px 18px 5px 5px;
    font-size: 15px;
    line-height: 1.25;
    background: var(--bone);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .masthead-who strong {
    display: block;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  .masthead-kind {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .masthead-portrait {
    flex: none;
    width: 40px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }

  .masthead-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
    /* Optical: pull the H's stem onto the column edge. */
    margin-left: -0.04em;
  }

  .masthead-body {
    max-width: 52ch;
  }

  /* The answer to the headline, directly under it. It is a full sentence, so
     it sits at reading size and weight rather than the old tagline's shout,
     and keeps the marker as the page's lead line. */
  .masthead-hook {
    margin: 0 0 0.7rem;
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 46ch;
  }

  .masthead-hook::before {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.45em;
    background: var(--orange);
    vertical-align: 0.08em;
  }

  /* The price under it: the proof, one step down from the answer. */
  .masthead-proof {
    margin: 0 0 0.7rem;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  /* For the reader who has only an idea. */
  .masthead-from-idea {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .masthead-from-idea a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .masthead-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1rem, 2.5vw, 1.6rem);
  }

  .masthead-note {
    margin: 0.9rem 0 0;
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* ————— how it works ————— */

  #how .block-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }

  .step {
    padding: 1.25rem 1.25rem 1.4rem 0;
  }

  .step + .step {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .step-no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
  }

  /* The two steps a person does are the ones that carry the signal colour. */
  .step:nth-child(2) .step-no,
  .step:nth-child(4) .step-no {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--ink);
  }

  .step h3,
  .term h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .step p,
  .term p {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .price {
    border-top: 2px solid var(--ink);
  }

  .price-head {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    padding: 1rem 0;
  }

  .price-head h3 {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .price-head p {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
  }

  .price-head p + p {
    color: var(--ink-soft);
  }

  .price-foot {
    margin: 0.9rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--ink-soft);
  }

  .price-foot strong {
    color: var(--ink);
  }

  .terms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }

  .term {
    padding: 1.25rem 1.25rem 0 0;
  }

  .term + .term {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .term h3 span {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  /* ————— why not just… ————— */

  .why {
    margin-top: 1.6rem;
    border-top: 2px solid var(--ink);
  }

  .why-title {
    margin: 0;
    padding: 1rem 0;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .whys {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .safeguards {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0.8rem 0 0;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .safeguards li::before {
    content: '✓ ';
    color: var(--orange);
    font-weight: 700;
  }


  /* ————— tablet + mobile ————— */

  @media (max-width: 760px) {
    .steps,
    .terms,
    .price-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .step,
    .step + .step,
    .term,
    .term + .term {
      padding: 0.9rem 0;
      border-left: 0;
    }

    .step + .step,
    .term + .term {
      border-top: 1px solid var(--rule);
    }

    .step {
      display: grid;
      grid-template-columns: 2.4rem minmax(0, 1fr);
    }

    .step-no {
      grid-row: span 2;
      margin: 0;
    }
  }
</style>
