---
/*
 * The contracting homepage: the offer, how it works, and the intercom.
 *
 * The shelf, writing, work, knowledgebase and plugins moved to the lab
 * (src/components/Lab.astro) when malipetek.dev became the client portal's
 * site. One component per site, so neither has to explain the other.
 */
import Intercom from "./Intercom.astro";
import WorkshopScene from "./WorkshopScene.astro";
import { getCollection } from "astro:content";
import {
  BRING_YOUR_OWN,
  CONTRAST,
  KIND as OFFER_KIND,
  HEADLINE,
  PRICE_HOOK,
  PRICE_NOTE,
  PUNCHLINE,
  WHO,
} from "../lib/offer.js";
import { ATTENTION, HOURLY_USD, money, timeCents } from "../lib/pricing.js";
import { copy } from "../lib/site.js";

const { t } = Astro.props;

/** What the quickest kind of job costs, the same arithmetic as offer.js. */
const QUICK_FIX = money(timeCents(ATTENTION.find((a) => a.key === "auto")?.typicalSeconds ?? 60));

const site = (await getCollection("site"))[0]?.data;
const intercomGreeting =
  site?.intercomGreeting ??
  "Ali's line. I'm the assistant that knows how he works. Tell me what you need built or fixed.";
const intercomSuggestions = site?.intercomSuggestions ?? [];
const email = site?.email ?? "malipetek@gmail.com";
const availability = site?.availability ?? "limited";
---

<div class="rails" aria-hidden="true"></div>
<WorkshopScene />

<section class="room room--masthead" data-station="hero">
  <div class="masthead-inner">
    <p class="masthead-who">
      <img
        class="masthead-portrait"
        src="/me.webp"
        alt="Muhammet Ali Petek"
        width="120"
        height="120"
        loading="eager"
      />
      <span>
        <strong>M. Ali Petek</strong>
        <span class="masthead-kind">{copy(t, "offer.kind", OFFER_KIND)}</span>
      </span>
    </p>
    <h1 class="masthead-name">{copy(t, "offer.headline.1", HEADLINE[0])}<br />{copy(t, "offer.headline.2", HEADLINE[1])}</h1>
    <div class="masthead-body">
      <p class="masthead-hook">{copy(t, "offer.punchline.1", PUNCHLINE[0])} {copy(t, "offer.punchline.2", PUNCHLINE[1])}</p>
      <p class="masthead-proof">{copy(t, "offer.priceHook", PRICE_HOOK, { price: QUICK_FIX })}</p>
      <div class="masthead-actions">
        <a class="btn btn--solid" href="/portal#/new">{t("site.home.cta.next")}</a>
        <a class="btn" href="#how">{t("site.home.cta.how")}</a>
      </div>
    </div>
  </div>
</section>

<section class="room room--panel" id="how" data-station="how">
  <div class="plate frame">
    <div class="block-head">
      <h2><span class="room-no" aria-hidden="true">01</span>{t("site.home.how.title")}</h2>
      <p class="block-note">{copy(t, "offer.who", WHO)}</p>
    </div>

    <p class="value">{copy(t, "offer.contrast", CONTRAST)}</p>

    {/* How it runs: you build with your own AI, on a preview, and go live when
        you like. I am beside it, not in the way: you ask me when you want
        help, a review, or a push to production. */}
    <figure class="flow" role="img" aria-label={t("site.home.flow.alt")}>
      <svg class="flow-wide" viewBox="0 0 880 350" aria-hidden="true">
        <defs>
          <clipPath id="flow-me-wide"><circle cx="540" cy="268" r="50" /></clipPath>
          <marker id="flow-tip-wide" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" class="flow-tip" />
          </marker>
        </defs>
        <path class="flow-line" d="M122 124 L232 124" marker-end="url(#flow-tip-wide)" />
        <path class="flow-line" d="M366 124 L472 124" marker-end="url(#flow-tip-wide)" />
        <path class="flow-line" d="M608 124 L722 124" marker-end="url(#flow-tip-wide)" />
        <path class="flow-line flow-line--ask" d="M92 166 C 140 270, 360 276, 482 270" marker-end="url(#flow-tip-wide)" />
        <path class="flow-line flow-line--back" d="M540 214 L540 168" marker-end="url(#flow-tip-wide)" />
        <path class="flow-line flow-line--ship" d="M588 252 C 690 246, 770 214, 790 168" marker-end="url(#flow-tip-wide)" />

        <g class="flow-node">
          <circle cx="80" cy="124" r="40" class="flow-disc" />
          <circle cx="80" cy="113" r="10" class="flow-glyph" />
          <path d="M60 148 a20 17 0 0 1 40 0" class="flow-glyph" />
        </g>
        <g class="flow-node">
          <rect x="238" y="92" width="124" height="64" rx="12" class="flow-disc" />
          {[252, 288, 324].map((x) => (
            <g>
              <rect x={x} y="110" width="26" height="22" rx="5" class="flow-glyph" />
              <circle cx={x + 8} cy="121" r="2.4" class="flow-eye" />
              <circle cx={x + 18} cy="121" r="2.4" class="flow-eye" />
            </g>
          ))}
        </g>
        <g class="flow-node">
          <rect x="478" y="88" width="124" height="74" rx="8" class="flow-disc flow-disc--draft" />
          <path d="M478 104 H602" class="flow-glyph" />
          <circle cx="490" cy="96" r="2.4" class="flow-eye" />
          <circle cx="499" cy="96" r="2.4" class="flow-eye" />
          <path d="M500 124 H580 M500 138 H560" class="flow-glyph" />
        </g>
        <g class="flow-node">
          <rect x="728" y="88" width="124" height="74" rx="8" class="flow-disc" />
          <path d="M728 104 H852" class="flow-glyph" />
          <circle cx="740" cy="96" r="2.4" class="flow-eye" />
          <circle cx="749" cy="96" r="2.4" class="flow-eye" />
          <path d="M774 132 l12 11 l22 -24" class="flow-check" />
        </g>
        <circle cx="540" cy="268" r="54" class="flow-ring" />
        <image href="/me.webp" x="490" y="218" width="100" height="100" clip-path="url(#flow-me-wide)" preserveAspectRatio="xMidYMid slice" />

        <text x="80" y="62" class="flow-label">{t("site.home.flow.you")}</text>
        <text x="300" y="70" class="flow-label">{t("site.home.flow.ai")}</text>
        <text x="540" y="70" class="flow-label">{t("site.home.flow.preview")}</text>
        <text x="790" y="70" class="flow-label">{t("site.home.flow.live")}</text>
        <text x="652" y="300" class="flow-label flow-label--start">{t("site.home.flow.me")}</text>
        <text x="652" y="322" class="flow-label flow-label--start flow-label--soft">{t("site.home.flow.when")}</text>
      </svg>

      <svg class="flow-tall" viewBox="0 0 360 520" aria-hidden="true">
        <defs>
          <clipPath id="flow-me-tall"><circle cx="64" cy="350" r="40" /></clipPath>
          <marker id="flow-tip-tall" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" class="flow-tip" />
          </marker>
        </defs>
        <path class="flow-line" d="M180 98 L180 128" marker-end="url(#flow-tip-tall)" />
        <path class="flow-line" d="M180 192 L180 226" marker-end="url(#flow-tip-tall)" />
        <path class="flow-line" d="M180 294 L180 330" marker-end="url(#flow-tip-tall)" />
        <path class="flow-line flow-line--ask" d="M146 60 C 70 70, 50 200, 60 300" marker-end="url(#flow-tip-tall)" />
        <path class="flow-line flow-line--back" d="M100 334 L128 290" marker-end="url(#flow-tip-tall)" />
        <path class="flow-line flow-line--ship" d="M100 368 L128 380" marker-end="url(#flow-tip-tall)" />

        <g class="flow-node">
          <circle cx="180" cy="62" r="34" class="flow-disc" />
          <circle cx="180" cy="53" r="9" class="flow-glyph" />
          <path d="M163 83 a17 15 0 0 1 34 0" class="flow-glyph" />
        </g>
        <g class="flow-node">
          <rect x="132" y="134" width="96" height="54" rx="10" class="flow-disc" />
          {[142, 167, 192].map((x) => (
            <g>
              <rect x={x} y="150" width="20" height="18" rx="4" class="flow-glyph" />
              <circle cx={x + 6} cy="159" r="2" class="flow-eye" />
              <circle cx={x + 14} cy="159" r="2" class="flow-eye" />
            </g>
          ))}
        </g>
        <g class="flow-node">
          <rect x="132" y="232" width="96" height="60" rx="8" class="flow-disc flow-disc--draft" />
          <path d="M132 246 H228" class="flow-glyph" />
          <path d="M148 262 H210 M148 276 H194" class="flow-glyph" />
        </g>
        <g class="flow-node">
          <rect x="132" y="336" width="96" height="60" rx="8" class="flow-disc" />
          <path d="M132 350 H228" class="flow-glyph" />
          <path d="M160 372 l10 9 l20 -22" class="flow-check" />
        </g>
        <circle cx="64" cy="350" r="44" class="flow-ring" />
        <image href="/me.webp" x="24" y="310" width="80" height="80" clip-path="url(#flow-me-tall)" preserveAspectRatio="xMidYMid slice" />

        <text x="236" y="68" class="flow-label flow-label--start">{t("site.home.flow.you")}</text>
        <text x="236" y="166" class="flow-label flow-label--start">{t("site.home.flow.ai")}</text>
        <text x="236" y="267" class="flow-label flow-label--start">{t("site.home.flow.preview")}</text>
        <text x="236" y="371" class="flow-label flow-label--start">{t("site.home.flow.live")}</text>
        <text x="64" y="418" class="flow-label">{t("site.home.flow.me")}</text>
        <text x="64" y="438" class="flow-label flow-label--soft">{t("site.home.flow.when")}</text>
      </svg>
      <figcaption class="flow-caption">{copy(t, "offer.byo", BRING_YOUR_OWN)}</figcaption>
    </figure>

    <p class="value-price">{copy(t, "offer.priceNote", PRICE_NOTE, { rate: HOURLY_USD })}</p>
  </div>
</section>

<Intercom
  greeting={intercomGreeting}
  suggestions={intercomSuggestions}
  email={email}
  availability={availability}
/>

<script>
  // On a direct load with a hash (e.g. /#talk), the browser's fragment scroll
  // races scroll restoration + snap proximity and can land one room short.
  // Re-assert the target once everything has settled.
  if (location.hash) {
    const land = () =>
      document
        .querySelector<HTMLElement>(location.hash)
        ?.scrollIntoView({ behavior: "instant", block: "start" });
    window.addEventListener("load", () => setTimeout(land, 60));
    setTimeout(land, 600);
  }
</script>

<style>
  /* The canvas is flat --bone where no station objects sit, so DOM text stays
     readable without extra backing. Opaque pieces (the intercom) cover the
     scene — that's the "2d on top" split. No z-index on main: the page rails
     (z 0), the transparent canvas (z 0, later in the DOM) and the rooms (z 1)
     must share one stacking context, so the props occlude the rails and the
     text sits over both. */

  /* Rooms are full-viewport; the layout's main padding would push the first
     room down. */
  :global(main) {
    padding-block: 0;
  }

  /* The intercom is the last room; its translucent orange field lets the
     beacon glow through. Needs position/z-index to paint over the fixed
     canvas. */
  :global(.intercom) {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  /* ————— masthead ————— */

  /* The backing below reaches past the text on purpose; on a phone that is
     past the viewport, and the page scrolled sideways. clip, not hidden, so
     the section does not become a scroll container. */
  .room--masthead {
    overflow-x: clip;
  }

  .masthead-inner {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    /* The diorama owns the right side on wide screens (see workshop3d). */
    max-width: min(100%, 46rem);
    /* Above the fixed scene layer (z-index 0), which otherwise draws over
       the text wherever the two overlap. */
    position: relative;
    z-index: 1;
  }

  /* A soft backing for the text: page colour, strongest behind the words and
     fading to nothing at the edges, so the diorama reads around it with no
     hard line, and never through the words. */
  .masthead-inner::before {
    content: "";
    position: absolute;
    inset: -3.5rem -5rem -3.5rem -4rem;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--bone) 92%, transparent) 62%,
      color-mix(in srgb, var(--bone) 60%, transparent) 80%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* Who is behind it: small, human, first — a pill badge above the headline. */
  .masthead-who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    margin: 0;
    padding: 5px 18px 5px 5px;
    font-size: 15px;
    line-height: 1.25;
    background: var(--bone);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .masthead-who strong {
    display: block;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  .masthead-kind {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .masthead-portrait {
    flex: none;
    width: 40px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }

  .masthead-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
    /* Optical: pull the H's stem onto the column edge. */
    margin-left: -0.04em;
  }

  .masthead-body {
    max-width: 52ch;
  }

  /* The answer to the headline, directly under it. It is a full sentence, so
     it sits at reading size and weight rather than the old tagline's shout,
     and keeps the marker as the page's lead line. */
  .masthead-hook {
    margin: 0 0 0.7rem;
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 46ch;
  }

  .masthead-hook::before {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.45em;
    background: var(--orange);
    vertical-align: 0.08em;
  }

  /* The price under it: the proof, one step down from the answer. */
  .masthead-proof {
    margin: 0 0 0.7rem;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .masthead-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1rem, 2.5vw, 1.6rem);
  }

  /* ————— how it works ————— */

  #how .block-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  /* The value, in one sentence, above the picture of it. */
  .value {
    margin: 0 0 clamp(1rem, 2.5vw, 1.75rem);
    max-width: 40ch;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .flow {
    margin: 0;
  }

  .flow svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Wide picture on wide screens, a tall one on a phone. */
  .flow-tall {
    display: none !important;
  }

  @media (max-width: 640px) {
    .flow-wide {
      display: none !important;
    }
    .flow-tall {
      display: block !important;
      max-width: 360px;
      margin-inline: auto;
    }
  }

  .flow-disc {
    fill: var(--bone);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .flow-glyph {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .flow-eye {
    fill: var(--orange);
  }

  .flow-check {
    fill: none;
    stroke: var(--orange);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* I am the orange ring, beside the line rather than on it. */
  .flow-ring {
    fill: var(--bone);
    stroke: var(--orange);
    stroke-width: 3;
  }

  .flow-line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-dasharray: 5 7;
    animation: flow-run 1.4s linear infinite;
  }

  /* The agents' work comes back to me before anything ships. */
  .flow-line--back {
    stroke: var(--ink-soft);
  }

  .flow-line--ship {
    stroke: var(--orange);
    stroke-width: 2;
  }

  .flow-tip {
    fill: var(--ink);
  }

  .flow-label {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    fill: var(--ink);
    text-anchor: middle;
    letter-spacing: -0.01em;
  }

  .flow-tall .flow-label {
    font-size: 15px;
  }

  .flow-label--start {
    text-anchor: start;
  }

  .flow-label--soft {
    font-weight: 500;
    fill: var(--ink-soft);
  }

  /* The preview is a draft: drawn dashed, where the live site is solid. */
  .flow-disc--draft {
    stroke-dasharray: 5 4;
  }

  /* Asking me is optional: the faintest line in the picture. */
  .flow-line--ask {
    stroke: var(--ink-soft);
    stroke-dasharray: 2 6;
  }

  .flow-caption {
    margin: clamp(0.8rem, 2vw, 1.2rem) 0 0;
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
  }

  .flow-no {
    font-family: var(--font-mono);
    font-size: 0.8em;
    fill: var(--orange);
  }

  @keyframes flow-run {
    to {
      stroke-dashoffset: -24;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-line {
      animation: none;
    }
  }

  .value-price {
    margin: clamp(1rem, 2.5vw, 1.5rem) 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    color: var(--ink-soft);
  }
</style>
