---
/*
 * The contracting homepage: the offer, how it works, and the intercom.
 *
 * The shelf, writing, work, knowledgebase and plugins moved to the lab
 * (src/components/Lab.astro) when malipetek.dev became the client portal's
 * site. One component per site, so neither has to explain the other.
 */
import Intercom from "./Intercom.astro";
import WorkshopScene from "./WorkshopScene.astro";
import { getCollection } from "astro:content";
import {
  CONTRAST,
  KIND as OFFER_KIND,
  HEADLINE,
  PRICE_HOOK,
  PRICE_NOTE,
  PUNCHLINE,
  STEPS,
  WHO,
} from "../lib/offer.js";
import { ATTENTION, HOURLY_USD, money, timeCents } from "../lib/pricing.js";
import { copy } from "../lib/site.js";

const { t } = Astro.props;

/** What the quickest kind of job costs, the same arithmetic as offer.js. */
const QUICK_FIX = money(timeCents(ATTENTION.find((a) => a.key === "auto")?.typicalSeconds ?? 60));

/** The pipeline's four steps, in this language: the flow picture's labels. */
const steps = STEPS.map((step) => copy(t, `offer.step.${step.key}.title`, step.title));

const site = (await getCollection("site"))[0]?.data;
const intercomGreeting =
  site?.intercomGreeting ??
  "Ali's line. I'm the assistant that knows how he works. Tell me what you need built or fixed.";
const intercomSuggestions = site?.intercomSuggestions ?? [];
const email = site?.email ?? "malipetek@gmail.com";
const availability = site?.availability ?? "limited";
---

<div class="rails" aria-hidden="true"></div>
<WorkshopScene />

<section class="room room--masthead" data-station="hero">
  <div class="masthead-inner">
    <p class="masthead-who">
      <img
        class="masthead-portrait"
        src="/me.webp"
        alt="Muhammet Ali Petek"
        width="120"
        height="120"
        loading="eager"
      />
      <span>
        <strong>M. Ali Petek</strong>
        <span class="masthead-kind">{copy(t, "offer.kind", OFFER_KIND)}</span>
      </span>
    </p>
    <h1 class="masthead-name">{copy(t, "offer.headline.1", HEADLINE[0])}<br />{copy(t, "offer.headline.2", HEADLINE[1])}</h1>
    <div class="masthead-body">
      <p class="masthead-hook">{copy(t, "offer.punchline.1", PUNCHLINE[0])} {copy(t, "offer.punchline.2", PUNCHLINE[1])}</p>
      <p class="masthead-proof">{copy(t, "offer.priceHook", PRICE_HOOK, { price: QUICK_FIX })}</p>
      <div class="masthead-actions">
        <a class="btn btn--solid" href="/portal#/new">{t("site.home.cta.next")}</a>
        <a class="btn" href="#how">{t("site.home.cta.how")}</a>
      </div>
    </div>
  </div>
</section>

<section class="room room--panel" id="how" data-station="how">
  <div class="plate frame">
    <div class="block-head">
      <h2><span class="room-no" aria-hidden="true">01</span>{t("site.home.how.title")}</h2>
      <p class="block-note">{copy(t, "offer.who", WHO)}</p>
    </div>

    <p class="value">{copy(t, "offer.contrast", CONTRAST)}</p>

    {/* Me between you, the agents and your live site: the request comes to me,
        the agents build it, and nothing ships until I have checked it. The
        labels are the pipeline's own steps (offer.js STEPS), so the picture
        and the portal say the same thing in every language. */}
    <figure class="flow" role="img" aria-label={steps.map((s, i) => `${i + 1}. ${s}`).join(" ")}>
      <svg class="flow-wide" viewBox="0 0 880 340" aria-hidden="true">
        <defs>
          <clipPath id="flow-me-wide"><circle cx="440" cy="168" r="58" /></clipPath>
          <marker id="flow-tip-wide" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" class="flow-tip" />
          </marker>
        </defs>
        <path class="flow-line" d="M158 168 L372 168" marker-end="url(#flow-tip-wide)" />
        <path class="flow-line" d="M494 136 C 572 88, 626 78, 690 78" marker-end="url(#flow-tip-wide)" />
        <path class="flow-line flow-line--back" d="M700 108 C 630 124, 572 150, 502 168" marker-end="url(#flow-tip-wide)" />
        <path class="flow-line flow-line--ship" d="M494 202 C 572 252, 626 262, 690 262" marker-end="url(#flow-tip-wide)" />

        <g class="flow-node">
          <circle cx="110" cy="168" r="44" class="flow-disc" />
          <circle cx="110" cy="156" r="11" class="flow-glyph" />
          <path d="M88 194 a22 19 0 0 1 44 0" class="flow-glyph" />
        </g>
        <circle cx="440" cy="168" r="62" class="flow-ring" />
        <image href="/me.webp" x="382" y="110" width="116" height="116" clip-path="url(#flow-me-wide)" preserveAspectRatio="xMidYMid slice" />
        <g class="flow-node">
          <rect x="698" y="46" width="124" height="64" rx="12" class="flow-disc" />
          {[712, 748, 784].map((x) => (
            <g>
              <rect x={x} y="64" width="26" height="22" rx="5" class="flow-glyph" />
              <circle cx={x + 8} cy="75" r="2.4" class="flow-eye" />
              <circle cx={x + 18} cy="75" r="2.4" class="flow-eye" />
            </g>
          ))}
        </g>
        <g class="flow-node">
          <rect x="698" y="226" width="124" height="74" rx="8" class="flow-disc" />
          <path d="M698 242 H822" class="flow-glyph" />
          <circle cx="710" cy="234" r="2.4" class="flow-eye" />
          <circle cx="719" cy="234" r="2.4" class="flow-eye" />
          <path d="M744 270 l12 11 l22 -24" class="flow-check" />
        </g>

        <text x="110" y="240" class="flow-label"><tspan class="flow-no">1</tspan> {steps[0]}</text>
        <text x="440" y="262" class="flow-label"><tspan class="flow-no">2</tspan> {steps[1]}</text>
        <text x="760" y="140" class="flow-label"><tspan class="flow-no">3</tspan> {steps[2]}</text>
        <text x="760" y="326" class="flow-label"><tspan class="flow-no">4</tspan> {steps[3]}</text>
      </svg>

      <svg class="flow-tall" viewBox="0 0 360 560" aria-hidden="true">
        <defs>
          <clipPath id="flow-me-tall"><circle cx="180" cy="236" r="52" /></clipPath>
          <marker id="flow-tip-tall" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" class="flow-tip" />
          </marker>
        </defs>
        <path class="flow-line" d="M180 142 L180 172" marker-end="url(#flow-tip-tall)" />
        <path class="flow-line" d="M146 280 L104 374" marker-end="url(#flow-tip-tall)" />
        <path class="flow-line flow-line--ship" d="M214 280 L256 374" marker-end="url(#flow-tip-tall)" />

        <g class="flow-node">
          <circle cx="180" cy="62" r="38" class="flow-disc" />
          <circle cx="180" cy="52" r="10" class="flow-glyph" />
          <path d="M161 86 a19 16 0 0 1 38 0" class="flow-glyph" />
        </g>
        <circle cx="180" cy="236" r="56" class="flow-ring" />
        <image href="/me.webp" x="128" y="184" width="104" height="104" clip-path="url(#flow-me-tall)" preserveAspectRatio="xMidYMid slice" />
        <g class="flow-node">
          <rect x="34" y="384" width="112" height="58" rx="11" class="flow-disc" />
          {[46, 77, 108].map((x) => (
            <g>
              <rect x={x} y="400" width="26" height="22" rx="5" class="flow-glyph" />
              <circle cx={x + 8} cy="411" r="2.4" class="flow-eye" />
              <circle cx={x + 18} cy="411" r="2.4" class="flow-eye" />
            </g>
          ))}
        </g>
        <g class="flow-node">
          <rect x="214" y="384" width="112" height="66" rx="8" class="flow-disc" />
          <path d="M214 398 H326" class="flow-glyph" />
          <circle cx="225" cy="391" r="2.2" class="flow-eye" />
          <circle cx="233" cy="391" r="2.2" class="flow-eye" />
          <path d="M254 424 l10 9 l20 -22" class="flow-check" />
        </g>

        <text x="180" y="132" class="flow-label"><tspan class="flow-no">1</tspan> {steps[0]}</text>
        <text x="180" y="326" class="flow-label"><tspan class="flow-no">2</tspan> {steps[1]}</text>
        <text x="90" y="478" class="flow-label"><tspan class="flow-no">3</tspan> {steps[2]}</text>
        <text x="270" y="486" class="flow-label"><tspan class="flow-no">4</tspan> {steps[3]}</text>
      </svg>
    </figure>

    <p class="value-price">{copy(t, "offer.priceNote", PRICE_NOTE, { rate: HOURLY_USD })}</p>
  </div>
</section>

<Intercom
  greeting={intercomGreeting}
  suggestions={intercomSuggestions}
  email={email}
  availability={availability}
/>

<script>
  // On a direct load with a hash (e.g. /#talk), the browser's fragment scroll
  // races scroll restoration + snap proximity and can land one room short.
  // Re-assert the target once everything has settled.
  if (location.hash) {
    const land = () =>
      document
        .querySelector<HTMLElement>(location.hash)
        ?.scrollIntoView({ behavior: "instant", block: "start" });
    window.addEventListener("load", () => setTimeout(land, 60));
    setTimeout(land, 600);
  }
</script>

<style>
  /* The canvas is flat --bone where no station objects sit, so DOM text stays
     readable without extra backing. Opaque pieces (the intercom) cover the
     scene — that's the "2d on top" split. No z-index on main: the page rails
     (z 0), the transparent canvas (z 0, later in the DOM) and the rooms (z 1)
     must share one stacking context, so the props occlude the rails and the
     text sits over both. */

  /* Rooms are full-viewport; the layout's main padding would push the first
     room down. */
  :global(main) {
    padding-block: 0;
  }

  /* The intercom is the last room; its translucent orange field lets the
     beacon glow through. Needs position/z-index to paint over the fixed
     canvas. */
  :global(.intercom) {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  /* ————— masthead ————— */

  /* The backing below reaches past the text on purpose; on a phone that is
     past the viewport, and the page scrolled sideways. clip, not hidden, so
     the section does not become a scroll container. */
  .room--masthead {
    overflow-x: clip;
  }

  .masthead-inner {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    /* The diorama owns the right side on wide screens (see workshop3d). */
    max-width: min(100%, 46rem);
    /* Above the fixed scene layer (z-index 0), which otherwise draws over
       the text wherever the two overlap. */
    position: relative;
    z-index: 1;
  }

  /* A soft backing for the text: page colour, strongest behind the words and
     fading to nothing at the edges, so the diorama reads around it with no
     hard line, and never through the words. */
  .masthead-inner::before {
    content: "";
    position: absolute;
    inset: -3.5rem -5rem -3.5rem -4rem;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--bone) 92%, transparent) 62%,
      color-mix(in srgb, var(--bone) 60%, transparent) 80%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* Who is behind it: small, human, first — a pill badge above the headline. */
  .masthead-who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    margin: 0;
    padding: 5px 18px 5px 5px;
    font-size: 15px;
    line-height: 1.25;
    background: var(--bone);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .masthead-who strong {
    display: block;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  .masthead-kind {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .masthead-portrait {
    flex: none;
    width: 40px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }

  .masthead-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
    /* Optical: pull the H's stem onto the column edge. */
    margin-left: -0.04em;
  }

  .masthead-body {
    max-width: 52ch;
  }

  /* The answer to the headline, directly under it. It is a full sentence, so
     it sits at reading size and weight rather than the old tagline's shout,
     and keeps the marker as the page's lead line. */
  .masthead-hook {
    margin: 0 0 0.7rem;
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 46ch;
  }

  .masthead-hook::before {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.45em;
    background: var(--orange);
    vertical-align: 0.08em;
  }

  /* The price under it: the proof, one step down from the answer. */
  .masthead-proof {
    margin: 0 0 0.7rem;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .masthead-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1rem, 2.5vw, 1.6rem);
  }

  /* ————— how it works ————— */

  #how .block-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  /* The value, in one sentence, above the picture of it. */
  .value {
    margin: 0 0 clamp(1rem, 2.5vw, 1.75rem);
    max-width: 40ch;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .flow {
    margin: 0;
  }

  .flow svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Wide picture on wide screens, a tall one on a phone. */
  .flow-tall {
    display: none !important;
  }

  @media (max-width: 640px) {
    .flow-wide {
      display: none !important;
    }
    .flow-tall {
      display: block !important;
      max-width: 360px;
      margin-inline: auto;
    }
  }

  .flow-disc {
    fill: var(--bone);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .flow-glyph {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .flow-eye {
    fill: var(--orange);
  }

  .flow-check {
    fill: none;
    stroke: var(--orange);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* I am the ring in the middle: the one part in the signal colour. */
  .flow-ring {
    fill: var(--bone);
    stroke: var(--orange);
    stroke-width: 3;
  }

  .flow-line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-dasharray: 5 7;
    animation: flow-run 1.4s linear infinite;
  }

  /* The agents' work comes back to me before anything ships. */
  .flow-line--back {
    stroke: var(--ink-soft);
  }

  .flow-line--ship {
    stroke: var(--orange);
    stroke-width: 2;
  }

  .flow-tip {
    fill: var(--ink);
  }

  .flow-label {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    fill: var(--ink);
    text-anchor: middle;
    letter-spacing: -0.01em;
  }

  .flow-tall .flow-label {
    font-size: 15px;
  }

  .flow-no {
    font-family: var(--font-mono);
    font-size: 0.8em;
    fill: var(--orange);
  }

  @keyframes flow-run {
    to {
      stroke-dashoffset: -24;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-line {
      animation: none;
    }
  }

  .value-price {
    margin: clamp(1rem, 2.5vw, 1.5rem) 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    color: var(--ink-soft);
  }
</style>
