---
/*
 * The contact page's markup, shared by /contact and /<locale>/contact. `t` is
 * the page's catalog, so every label, the title's section and the form's
 * status messages follow the URL's language; the form script reads its copy
 * from data attributes for the same reason.
 */
import { localizedPath } from '../lib/site.js';

interface Props {
  t: (key: string, vars?: Record<string, string | number>) => string;
  locale: string;
}

const { t, locale } = Astro.props;
const endpoint = String(import.meta.env.PUBLIC_CHAT_ENDPOINT || '').replace(/\/+$/, '');
const mail = 'malipetek@gmail.com';
---

<header class="page-head">
  <h1>{t('site.contact.heading')}</h1>
  <p class="lede">{t('site.contact.lede')}</p>
</header>

<div class="contact-grid">
  <form
    class="contact-form"
    id="contact-form"
    data-endpoint={endpoint}
    data-msg-sent={t('site.contact.status.sent')}
    data-msg-sent-ali={t('site.contact.status.sentAli')}
    data-msg-required={t('site.contact.status.required')}
    data-msg-email={t('site.contact.status.email')}
    data-msg-offline={t('site.contact.status.offline')}
    data-msg-sending={t('site.contact.status.sending')}
    data-msg-rate-limited={t('site.contact.status.rateLimited')}
    data-msg-turnstile={t('site.contact.status.turnstile')}
    data-msg-failed={t('site.contact.status.failed')}
    data-msg-network={t('site.contact.status.network')}
  >
    <div class="field">
      <label for="cf-name">{t('site.contact.name')}</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="cf-email">{t('site.contact.email')}</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="cf-org">
        {t('site.contact.company')} <span class="opt">{t('site.contact.optional')}</span>
      </label>
      <input id="cf-org" name="company" type="text" autocomplete="organization" />
    </div>
    <div class="field">
      <label for="cf-msg">{t('site.contact.message')}</label>
      <textarea id="cf-msg" name="message" rows="7" required></textarea>
    </div>
    {/* honeypot — bots fill it, humans don't see it */}
    <div class="cf-hp" aria-hidden="true">
      <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="contact-actions">
      <button class="btn btn--solid" type="submit">{t('site.contact.send')}</button>
      <p class="contact-status" role="status" aria-live="polite"></p>
    </div>
  </form>

  <aside class="contact-aside">
    <h2>{t('site.contact.aside.title')}</h2>
    <dl class="direct">
      <div>
        <dt>{t('site.contact.email')}</dt>
        <dd><a href={`mailto:${mail}`}>{mail}</a></dd>
      </div>
      <div>
        <dt>{t('site.contact.aside.github')}</dt>
        <dd><a href="https://github.com/malipetek">github.com/malipetek</a></dd>
      </div>
      <div>
        <dt>{t('site.contact.aside.talk')}</dt>
        <dd>
          <a href={localizedPath(locale, '/#talk')}>{t('site.contact.aside.talk.link')}</a>
          {' '}{t('site.contact.aside.talk.note')}
        </dd>
      </div>
    </dl>
    <p class="aside-note">{t('site.contact.aside.note')}</p>
  </aside>
</div>

<script>
  import { getTurnstileToken } from '../lib/chatBackend.js';

  const form = document.getElementById('contact-form');
  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('.contact-status');
    const submit = form.querySelector('button[type="submit"]');
    const endpoint = form.dataset.endpoint || '';
    // Every line the form shows comes from the page's catalog, through the
    // data-msg-* attribute of the same name, so it answers in the page's
    // language.
    const msg = (name: string) => form.dataset[name] || '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      // honeypot: pretend to succeed and bail
      if (String(data.get('website') || '').trim()) {
        if (status) status.textContent = msg('msgSent');
        form.reset();
        return;
      }
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const company = String(data.get('company') || '').trim();
      const message = String(data.get('message') || '').trim();
      if (!name || !email || !message) {
        if (status) status.textContent = msg('msgRequired');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (status) status.textContent = msg('msgEmail');
        return;
      }
      if (!endpoint) {
        if (status) status.textContent = msg('msgOffline');
        return;
      }
      const text =
        `Name: ${name}\n` +
        (company ? `Company: ${company}\n` : '') +
        `Source: contact page\n\n${message}`;
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      if (status) status.textContent = msg('msgSending');
      try {
        // The Worker enforces Turnstile on /handoff; without a token every
        // message is refused with turnstile_failed.
        const turnstileToken = await getTurnstileToken().catch(() => '');
        const res = await fetch(`${endpoint}/handoff`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, message: text, summary: text.slice(0, 400), source: 'contact', turnstileToken }),
        });
        if (res.ok) {
          form.reset();
          if (status) status.textContent = msg('msgSentAli');
        } else {
          const err = await res.json().catch(() => ({}));
          if (status)
            status.textContent =
              err.error === 'rate_limited'
                ? msg('msgRateLimited')
                : err.error === 'turnstile_failed'
                  ? msg('msgTurnstile')
                  : msg('msgFailed');
        }
      } catch {
        if (status) status.textContent = msg('msgNetwork');
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: start;
  }

  .contact-form {
    display: grid;
    gap: 1.1rem;
    border-top: 2px solid var(--ink);
    padding-top: clamp(1.25rem, 3vw, 1.75rem);
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .field .opt {
    text-transform: none;
    letter-spacing: 0;
  }

  .field input,
  .field textarea {
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 2px solid var(--ink);
    border-radius: 0;
    padding: 0.65rem 0.8rem;
    width: 100%;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }

  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .cf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .contact-status {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .contact-aside h2 {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .direct {
    margin: 0;
    display: grid;
    gap: 0.9rem;
    border-top: 2px solid var(--ink);
    padding-top: 1.1rem;
  }

  .direct div {
    display: grid;
    gap: 0.15rem;
  }

  .direct dt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-soft);
  }

  .direct dd {
    margin: 0;
    font-size: 16px;
  }

  .aside-note {
    margin-top: 1.4rem;
    font-size: 14px;
    color: var(--ink-soft);
    max-width: 40ch;
  }

  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
