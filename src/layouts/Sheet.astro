---
import '../styles/sheet.css';
import DocNav from '../components/DocNav.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  sheet?: string;
}

const {
  title = 'Muhammet Ali Petek',
  description = 'Personal site and field log of a full-stack developer.',
  current = Astro.url.pathname,
  sheet = '1/1',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/me.webp" />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <!-- impeccable direction contract · seed 4cba959f · scope direction · mode experience · reroll 1 · register safer
    THESIS: the site is a dense technical document — one wide column of ruled tables and tight type; every pixel carries information, nothing is a metaphor.
    OWN-WORLD: datasheet paper #fbfaf6; ink #1c1b17; cobalt #2440c4 for links and mechanical elements only; red #b23a2e reserved for corrections and warnings; hairline rules; iA Writer faces, no hand face.
    STORY: a working engineer's spec sheet — doc number, revision, section numbers, tabular metadata; the visitor understands this person documents precisely and wastes nothing.
    FIRST VIEWPORT: document topbar with doc id and numbered section nav; spec title block with bordered fields; the log as a ruled table filling the column edge to edge.
    FORM: the spec sheet — safer register, user-picked after the field notebook read twee and wasteful. Signature move: the doc's own numbered-section grammar carries every page.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance. -->
    <div class="doc">
      <header class="doc-topbar">
        <span class="doc-id">MLP—01 <span>· personal site + field log</span></span>
        <DocNav current={current} />
      </header>
      <main class="doc-body">
        <slot />
      </main>
      <footer class="doc-foot">
        <span>MLP—01 · REV A · SHEET {sheet}</span>
        <span>set by swe-2 max</span>
        <span>© 2026 M. PETEK</span>
      </footer>
    </div>
  </body>
</html>
