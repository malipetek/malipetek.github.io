---
import "../styles/base.css";
import { siteT, localizedPath, copy } from "../lib/site.js";
import { SOURCE_LOCALE } from "../lib/locales.js";
import { contractingStructuredData } from "../lib/structuredData.js";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  /** Open Graph type — 'article' for blog entries, 'website' everywhere else. */
  type?: string;
  image?: string;
  imageAlt?: string;
  /** The page's language; English unless a localized route says otherwise. */
  locale?: string;
  /**
   * The page's locale-independent path, e.g. "/contact". A page that exists
   * once per language names it so that the canonical, the hreflang set, the
   * language picker and the navigation all address the same page in every
   * language. Leave it off for a page that exists once (legal, portal, lab).
   */
  path?: string;
  /** Every language this page exists in: renders hreflang links and the picker. */
  languagePicker?: { code: string; native: string }[];
  /**
   * Which of the two sites this page belongs to. malipetek.dev is the client
   * portal for vibe contracting; lab.malipetek.dev is Ali's developer lab.
   * Each has its own navigation, canonical origin and footer.
   */
  site?: "contracting" | "lab";
  /**
   * Off for a full-screen app (the client portal): no site header, footer or
   * main wrapper, only the slot. The app draws its own "malipetek" mark, and a
   * second one on the page would cancel the transition into it.
   */
  chrome?: boolean;
  /**
   * What the page must not paint without, as a CSS selector. The browser holds
   * the first frame until it is parsed, so a page transition into this page has
   * a real page to move into rather than an empty body. Defaults to the main
   * element Base draws; a full-screen app passes its own first frame.
   */
  expect?: string;
}

/*
 * "Ask AI about …": people often meet this site through an agent. Each link
 * pre-fills that agent with a description of the site the reader is on, so the
 * answer starts from what it is rather than from a bare domain name.
 */
const aiPrompts = {
  contracting: [
    "Summarize malipetek.dev and what it offers, then cite the site.",
    "It is a vibe contracting service: AI agents build and change websites for",
    "business owners, and Ali Petek, a human developer, approves the work.",
    "Cover how a client files a request, what the client portal shows, how the",
    "pricing works, and what is still in progress. Use up-to-date information",
    "from malipetek.dev.",
  ],
  lab: [
    "Summarize lab.malipetek.dev and what it offers, then cite the site.",
    "Focus on: the DeepSeek Harness plugins on /plugins (an agentic work queue,",
    "project and AI-workspace panels, git graph, action cards), the knowledgebase",
    "of real problems from agentic coding sessions, and the work that uses Claude",
    "Code, Devin and opencode as agents. Be specific about what each thing does,",
    "who it is for, and what is still in progress. Use up-to-date information",
    "from lab.malipetek.dev.",
  ],
};

const {
  title = "M. Ali Petek",
  description = "Self-serve software contracting by M. Ali Petek: human-approved, agent-built.",
  current,
  type = "website",
  image = "/me.webp",
  imageAlt = "Muhammet Ali Petek",
  locale = SOURCE_LOCALE,
  path,
  languagePicker = [],
  site = "contracting",
  chrome = true,
  expect = chrome ? "#main" : undefined,
} = Astro.props;

const t = siteT(locale);

const aiAsk = encodeURIComponent(aiPrompts[site].join(" "));
/** The assistants people actually reach for, each with the same pre-filled ask. */
const aiProviders = [
  { label: "ChatGPT", href: `https://chat.openai.com/?q=${aiAsk}` },
  { label: "Claude", href: `https://claude.ai/new?q=${aiAsk}` },
  { label: "Perplexity", href: `https://www.perplexity.ai/search/new?q=${aiAsk}` },
  { label: "Google", href: `https://www.google.com/search?udm=50&aep=11&q=${aiAsk}` },
  { label: "Grok", href: `https://grok.com/?q=${aiAsk}` },
];

// Each site knows its own absolute address; Astro.site is the contracting one.
const origin =
  site === "lab" ? "https://lab.malipetek.dev" : "https://malipetek.dev";

// A page that exists once per language names its own path, so this URL is the
// same for a build-time page and for any spelling of the request. Pages that
// exist once keep the address the request came in on.
const selfPath = path ? localizedPath(locale, path) : Astro.url.pathname;
const canonical = new URL(selfPath, origin);
const ogImage = new URL(image, origin);
const currentPath = current ?? selfPath;

// The contracting site's graph goes on every page; the homepage adds the
// service itself. The lab has its own structured data on the KB entries.
const jsonLd =
  site === "contracting"
    ? contractingStructuredData({
        canonical: canonical.href,
        title,
        description,
        locale,
        image: ogImage.href,
        t,
        home: path === "/",
      })
    : null;

// Where the picker and the alternates point: the same page, not the homepage.
const pickerPath = path ?? "/";

const contractingNav = [
  { href: localizedPath(locale, "/#how"), label: copy(t, "site.home.how.title", "How it works") },
  { href: localizedPath(locale, "/#talk"), label: t("site.nav.talk") },
  { href: localizedPath(locale, "/contact"), label: t("site.nav.contact") },
  { href: localizedPath(locale, "/agents"), label: copy(t, "site.nav.agents", "Connect your assistant") },
  // The developer lab is its own site; its name stays English everywhere.
  { href: "https://lab.malipetek.dev", label: "Lab" },
];

const labNav = [
  { href: "/kb", label: "Knowledgebase" },
  { href: "/plugins", label: "Plugins" },
  { href: "/blog", label: "Writing" },
  { href: "/experience", label: "Work" },
];

const nav = site === "lab" ? labNav : contractingNav;

const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

// The language menu shows the page's own language; the list holds every
// language this page exists in, the current one included.
const currentLanguage = languagePicker.find((l) => l.code === locale);
const otherLanguages = languagePicker.filter((l) => l.code !== locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Set the theme before first paint so a saved dark choice never flashes. */
    }
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
    {
      /* Same-origin page loads cross-fade, with the shared parts (the
         "malipetek" mark, the header, the nav mark, a list title and the
         heading it opens) held or moved in place: base.css, "page
         transitions". Browsers only do this within one origin, so a trip
         between malipetek.dev and lab.malipetek.dev stays a plain load. The
         opt-in is inline so it is in place before the first paint. */
    }
    {
      /* The page is not shown until its main part is parsed. A page arrives
         in pieces, and the browser may paint as soon as the head is in; a
         page transition takes its picture of the new page at that paint, and
         with an empty body it has nothing to move into. */
    }
    {expect && <link rel="expect" href={expect} blocking="render" />}
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
          types: page;
        }
      }
    </style>
    {
      /* The other site's pages are prerendered while a link to them is
         hovered, so the hop below lands at once (Chromium; the target opts
         in with Supports-Loading-Mode, src/worker.ts and _headers). */
    }
    <script
      is:inline
      type="speculationrules"
      set:html={JSON.stringify({
        prerender: [
          {
            where: {
              and: [
                { href_matches: site === "lab" ? "https://malipetek.dev/*" : "https://lab.malipetek.dev/*" },
                { not: { href_matches: "https://malipetek.dev/portal*" } },
              ],
            },
            eagerness: "moderate",
          },
        ],
      })}
    />
    <script is:inline>
      /*
       * malipetek.dev and lab.malipetek.dev are two origins, and browsers run
       * page transitions only within one. The hop between them is played in
       * two halves instead: the page being left fades its body and draws
       * "/lab" back into "malipetek", and the page arriving, seeing it came
       * from the other site, does the reverse. The mark sits in the same place
       * on both, so it reads as one move (base.css, "the hop between sites").
       */
      (() => {
        const SITES = ["https://malipetek.dev", "https://lab.malipetek.dev"];
        const other = (origin) => origin !== location.origin && SITES.includes(origin);
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const root = document.documentElement;
        // The slow-motion factor the CSS durations use (base.css --vt-slow).
        const slow = () => parseFloat(getComputedStyle(root).getPropertyValue("--vt-slow")) || 1;
        const play = () => {
          if (root.dataset.hop === "arrive") return;
          root.dataset.hop = "arrive";
          setTimeout(() => {
            if (root.dataset.hop === "arrive") delete root.dataset.hop;
          }, 900 * slow());
        };
        // The page this tab left for the other site; coming back to it with
        // Back plays the entrance too.
        const LEFT = "hop-left";
        const cameBack = sessionStorage.getItem(LEFT) === location.href;
        sessionStorage.removeItem(LEFT);

        let from = "";
        try {
          from = new URL(document.referrer).origin;
        } catch {}
        const type = performance.getEntriesByType("navigation")[0]?.type;
        if ((other(from) && type === "navigate") || (cameBack && type === "back_forward")) {
          // Hidden until the first frame is shown; a prerendered page shows
          // its first frame when it is opened, not while it waits.
          root.dataset.hop = "arriving";
          if ("onpagereveal" in window) addEventListener("pagereveal", play, { once: true });
          else play();
          // pagereveal nearly always fires, but if it does not (a prerender
          // activated without one, a navigation that skipped it) the parts
          // would stay invisible forever — bring them in regardless.
          setTimeout(() => {
            if (root.dataset.hop === "arriving") play();
          }, 1000 * slow());
        }

        addEventListener("click", (e) => {
          if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target.closest?.("a[href]");
          if (!a || (a.target && a.target !== "_self") || a.hasAttribute("download")) return;
          const url = new URL(a.href, location.href);
          if (!other(url.origin)) return;
          e.preventDefault();
          root.dataset.hop = "leave";
          sessionStorage.setItem(LEFT, location.href);
          const leftAt = performance.now();
          setTimeout(() => location.assign(url.href), 170 * slow());
          // A navigation that starts and is then aborted (a stopped load, a
          // beforeunload prompt, a prerender that never activates) leaves the
          // page faded forever — timers may never run once a navigation has
          // started. The way back is a real event: a gesture on a page that is
          // still here means the hop did not happen.
          const revive = (ev) => {
            if (root.dataset.hop !== "leave" || performance.now() - leftAt < 400) return;
            delete root.dataset.hop;
            for (const name of ["pointerdown", "keydown", "wheel", "touchstart"]) {
              removeEventListener(name, revive, true);
            }
          };
          for (const name of ["pointerdown", "keydown", "wheel", "touchstart"]) {
            addEventListener(name, revive, true);
          }
        });
        // Back to this page from the back/forward cache, where it is still
        // faded out from leaving, or frozen before its entrance played:
        // bring it back in.
        addEventListener("pageshow", (e) => {
          if (e.persisted && (root.dataset.hop === "leave" || root.dataset.hop === "arriving")) {
            sessionStorage.removeItem(LEFT);
            play();
          }
        });
      })();
    </script>
    <script is:inline>
      /*
       * The machine arrives. The site's homepage and the portal's board are the
       * same scene (src/lib/workshop3d.ts): the homepage draws the workshop,
       * the board draws it with the client's requests on it. Going from the
       * homepage to the portal, the canvas is named for that one navigation,
       * and the portal's first frame — which already has the board's window —
       * measures the window so the machine can slide to it. It keeps its size
       * and the page pushes past it: the room stays, everything written over it
       * leaves through the edges (base.css, "the machine stays").
       */
      (() => {
        const FROM = "scene-from";
        const BOX = "scene-box";
        const canvas = () => document.querySelector("[data-workshop]");
        addEventListener(
          "click",
          (e) => {
            if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            const a = e.target.closest?.("a[href]");
            if (!a) return;
            const url = new URL(a.href, location.href);
            if (url.origin !== location.origin) return;
            if (url.pathname.replace(/\/+$/, "") !== "/portal") return;
            const el = canvas();
            if (!el) return;
            // Out of the root snapshot, so the page can fly out around it.
            el.style.viewTransitionName = "scene";
            sessionStorage.setItem(FROM, "1");
            // Where the machine is, so the portal can land its own on it.
            const box = window.__workshopBox;
            if (box) sessionStorage.setItem(BOX, JSON.stringify(box));
            // A click that goes nowhere must not leave the name behind.
            setTimeout(() => el.style.removeProperty("view-transition-name"), 4000);
          },
          true,
        );

        addEventListener("pagereveal", (e) => {
          const from = sessionStorage.getItem(FROM);
          const box = sessionStorage.getItem(BOX);
          sessionStorage.removeItem(FROM);
          if (!from || !e.viewTransition) {
            sessionStorage.removeItem(BOX);
            return;
          }
          const root = document.documentElement;
          const win = document.querySelector("[data-board-window]")?.getBoundingClientRect();
          // The page pushes past the edges around the board's window; the
          // machine itself is held still until the board says where its own
          // machine is (Guest.jsx), then lands on it exactly.
          if (win) {
            root.style.setProperty("--vt-scene-cx", `${win.left + win.width / 2}px`);
            root.style.setProperty("--vt-scene-cy", `${win.top + win.height / 2}px`);
          }
          root.dataset.vtScene = "in";
          // No measurement from the site: the page still pushes in, the
          // machine just stays where it was instead of landing.
          if (!box) root.dataset.vtSceneReady = "1";
          const clear = () => {
            clearTimeout(guard);
            delete root.dataset.vtScene;
            delete root.dataset.vtSceneReady;
            for (const name of ["--vt-scene-cx", "--vt-scene-cy", "--vt-scene-tx", "--vt-scene-ty", "--vt-scene-s"]) {
              root.style.removeProperty(name);
            }
          };
          // No WebGL, or a board that never draws: let the transition end.
          const slow = parseFloat(getComputedStyle(root).getPropertyValue("--vt-slow")) || 1;
          const guard = setTimeout(() => {
            if (!root.dataset.vtSceneReady) clear();
          }, 1400 * slow);
          e.viewTransition.finished.then(clear, clear);
        });
      })();
    </script>
    <script is:inline>
      /*
       * A list title and the page it opens share one name, so the title grows
       * into that page's heading, and shrinks back into its row on the way
       * back. pageswap runs in the page being left, pagereveal in the one
       * arriving; both know the other page's address. Names are set only for
       * the trip and cleared after, so the page holds no names a later trip
       * could collide with.
       */
      (() => {
        const TITLES = ".post-link, .plugin-name, .box-title, .kb-item-title";
        const pathOf = (url) => {
          const u = new URL(url, location.href);
          return u.origin === location.origin ? u.pathname.replace(/\/+$/, "") || "/" : null;
        };
        // /blog/x opens from /blog and from the lab's home page.
        const opensFrom = (detail, list) => {
          const parts = detail.split("/").filter(Boolean);
          return parts.length === 2 && (list === "/" || list === `/${parts[0]}`);
        };
        const titleFor = (other) => {
          const here = pathOf(location.href);
          if (!other || other === here) return null;
          for (const el of document.querySelectorAll(TITLES)) {
            const a = el.closest("a[href]");
            if (a && pathOf(a.href) === other) return el;
          }
          return opensFrom(here, other) ? document.querySelector("main h1") : null;
        };
        const share = (transition, other) => {
          const el = transition && titleFor(other);
          if (!el) return;
          el.style.viewTransitionName = "page-title";
          // A block heading is as wide as the column; the morph should scale
          // the words, not a column-wide box.
          el.style.width = "fit-content";
          const clear = () => {
            el.style.removeProperty("view-transition-name");
            el.style.removeProperty("width");
          };
          transition.finished.then(clear, clear);
        };
        // A header scrolled out of view would swoop down from above the
        // window; for that trip it is not shared and the new one fades in.
        const HEAD = ".site-head, .wordmark-root, .wordmark-site, .nav-mark";
        addEventListener("pageswap", (e) => {
          const to = e.activation?.entry?.url;
          share(e.viewTransition, to && pathOf(to));
          if (e.viewTransition && document.querySelector(".site-head")?.getBoundingClientRect().bottom < 0) {
            document.querySelectorAll(HEAD).forEach((el) => (el.style.viewTransitionName = "none"));
          }
        });
        // Back from the back/forward cache: the header is shared again.
        addEventListener("pageshow", () => {
          document.querySelectorAll(HEAD).forEach((el) => el.style.removeProperty("view-transition-name"));
        });
        addEventListener("pagereveal", (e) => {
          const from = window.navigation?.activation?.from?.url;
          share(e.viewTransition, from && pathOf(from));
          // In from the portal, which has no site header: a layer only the new
          // page has is stacked above every layer the old page had, so the
          // header's opaque background would fade in over "malipetek" while
          // it travels, and the mark would pop back when the transition ends.
          // For this trip the header comes in with the page, under the mark.
          const head = document.querySelector(".site-head");
          if (e.viewTransition && head && /^\/portal(\/|$)/.test(pathOf(from ?? "") ?? "")) {
            head.style.viewTransitionName = "none";
            const back = () => head.style.removeProperty("view-transition-name");
            e.viewTransition.finished.then(back, back);
          }
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0f0e0c"
    />
    <link rel="canonical" href={canonical.href} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
          is:inline
        />
      )
    }
    {
      /* One alternate per language, the page's own included, as Google asks,
         plus x-default for the English URL. The codes in locales.js are all
         valid hreflang values (zh-Hans and zh-Hant script subtags, es-419
         region, bho and fil as ISO 639-3 tags). */
      site === "contracting" && languagePicker.length > 0 && (
        <>
          {languagePicker.map((l) => (
            <link
              rel="alternate"
              hreflang={l.code}
              href={new URL(localizedPath(l.code, pickerPath), origin).href}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(localizedPath(SOURCE_LOCALE, pickerPath), origin).href}
          />
        </>
      )
    }
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="M. Ali Petek" />
    <meta property="og:locale" content={locale.replace(/-/g, "_")} />
    {
      site === "contracting" &&
        languagePicker
          .filter((l) => l.code !== locale)
          .map((l) => (
            <meta property="og:locale:alternate" content={l.code.replace(/-/g, "_")} />
          ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <link rel="icon" href="/me.webp" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body data-site={site}>
    {chrome && (<>
    <a class="skip-link" href="#main">{t("site.skip")}</a>
    <header class="site-head">
      <div class="wrap site-head-inner">
        {
          /* "malipetek" is one element on every page of both sites and in the
             portal (view-transition name "brand"); the site's suffix is a
             second one, so it can slide out of the name or back into it. */
        }
        {
          /* "malipetek" always leads to the main site; the lab's "/lab" to
             the lab's home. */
        }
        <span class="wordmark">
          <a class="wordmark-root" href={site === "lab" ? "https://malipetek.dev" : localizedPath(locale)}>malipetek</a>{site === "lab" && <a class="wordmark-site" href="/">/lab</a>}
        </span>
        <nav class="site-nav" aria-label={t("site.nav.primary")}>
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
                {isCurrent(item.href) && <span class="nav-mark" aria-hidden="true" />}
              </a>
            ))
          }
        </nav>
        <div class="site-tools">
          {
            site === "lab" ? (
              <a class="nav-portal" href="https://malipetek.dev">
                Hire<span class="nav-portal__more">: malipetek.dev</span>
              </a>
            ) : (
              <a class="nav-portal" href="/portal">{t("site.nav.portal")}</a>
            )
          }
          {
            site === "contracting" && currentLanguage && (
              <details class="lang-menu" data-lang-menu>
                <summary aria-label={t("site.lang")}>
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4" />
                    <path
                      d="M1.6 8h12.8M8 1.6c1.7 1.8 2.6 4 2.6 6.4S9.7 12.6 8 14.4C6.3 12.6 5.4 10.4 5.4 8S6.3 3.4 8 1.6Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />
                  </svg>
                  <span class="lang-menu__name">{currentLanguage.native}</span>
                  <span class="lang-menu__caret" aria-hidden="true">⌄</span>
                </summary>
                <ul aria-label={t("site.lang.other")}>
                  <li>
                    <a href={localizedPath(locale, pickerPath)} aria-current="true" lang={locale}>
                      {currentLanguage.native}
                    </a>
                  </li>
                  {otherLanguages.map((l) => (
                    <li data-code={l.code}>
                      <a href={localizedPath(l.code, pickerPath)} lang={l.code} hreflang={l.code}>
                        {l.native}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            )
          }
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label={t("site.theme")}
            aria-pressed="false"
          >
            <svg
              class="icon-sun"
              viewBox="0 0 16 16"
              width="15"
              height="15"
              aria-hidden="true"
            >
              <circle
                cx="8"
                cy="8"
                r="3.2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"></circle>
              <path
                d="M8 1v2M8 13v2M1 8h2M13 8h2M3.1 3.1l1.4 1.4M11.5 11.5l1.4 1.4M3.1 12.9l1.4-1.4M11.5 4.5l1.4-1.4"
