---
import "../styles/base.css";
import { siteT, localePath } from "../lib/site.js";
import { SOURCE_LOCALE } from "../lib/locales.js";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  /** Open Graph type — 'article' for blog entries, 'website' everywhere else. */
  type?: string;
  image?: string;
  imageAlt?: string;
  /** The page's language; English unless a localized route says otherwise. */
  locale?: string;
  /** Every language this page exists in: renders hreflang links and the picker. */
  languagePicker?: { code: string; native: string }[];
}

/*
 * "Ask AI about malipetek.dev": the page's own audience often meets it through an
 * agent. Each link pre-fills that agent with the same description, so the answer
 * starts from what this site is rather than from a bare domain name.
 */
const aiPrompt = [
  "Summarize malipetek.dev and what it offers, then cite the site.",
  "Focus on: the DeepSeek Harness plugins on /plugins (an agentic work queue,",
  "project and AI-workspace panels, git graph, action cards), the client portal",
  "for AI-assisted development, and the work that uses Claude Code, Devin and",
  "opencode as agents. Be specific about what each thing does, who it is for,",
  "and what is still in progress. Use up-to-date information from malipetek.dev.",
].join(" ");
const aiAsk = encodeURIComponent(aiPrompt);
/** The assistants people actually reach for, each with the same pre-filled ask. */
const aiProviders = [
  { label: "ChatGPT", href: `https://chat.openai.com/?q=${aiAsk}` },
  { label: "Claude", href: `https://claude.ai/new?q=${aiAsk}` },
  { label: "Perplexity", href: `https://www.perplexity.ai/search/new?q=${aiAsk}` },
  { label: "Google", href: `https://www.google.com/search?udm=50&aep=11&q=${aiAsk}` },
  { label: "Grok", href: `https://grok.com/?q=${aiAsk}` },
];

const {
  title = "M. Ali Petek",
  description = "Self-serve software contracting by M. Ali Petek: human-approved, agent-built.",
  current = Astro.url.pathname,
  type = "website",
  image = "/me.webp",
  imageAlt = "Muhammet Ali Petek",
  locale = SOURCE_LOCALE,
  languagePicker = [],
} = Astro.props;

const t = siteT(locale);

// Astro.site is set in astro.config.mjs, so these are absolute for crawlers.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const nav = [
  { href: "/", label: t("site.nav.shelf") },
  { href: "/blog", label: t("site.nav.writing") },
  { href: "/kb", label: t("site.nav.kb") },
  { href: "/plugins", label: t("site.nav.plugins") },
  { href: "/experience", label: t("site.nav.work") },
  { href: "/contact", label: t("site.nav.contact") },
  { href: "/#talk", label: t("site.nav.talk") },
];

const isCurrent = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);

// The language menu shows the page's own language; the list holds every
// language this page exists in, the current one included.
const currentLanguage = languagePicker.find((l) => l.code === locale);
const otherLanguages = languagePicker.filter((l) => l.code !== locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Set the theme before first paint so a saved dark choice never flashes. */
    }
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0f0e0c"
    />
    <link rel="canonical" href={canonical.href} />
    {
      languagePicker.length > 0 && (
        <>
          <link rel="alternate" hreflang={locale} href={canonical.href} />
          {languagePicker
            .filter((l) => l.code !== locale)
            .map((l) => (
              <link rel="alternate" hreflang={l.code} href={new URL(localePath(l.code), Astro.site).href} />
            ))}
          <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />
        </>
      )
    }
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="M. Ali Petek" />
    <meta property="og:locale" content={locale.replace("-", "_")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <link rel="icon" href="/me.webp" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("site.skip")}</a>
    <header class="site-head">
      <div class="wrap site-head-inner">
        <a class="wordmark" href="/">malipetek</a>
        <nav class="site-nav" aria-label={t("site.nav.primary")}>
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a class="nav-portal" href="/portal">{t("site.nav.portal")}</a>
          {
            currentLanguage && (
              <details class="lang-menu" data-lang-menu>
                <summary aria-label={t("site.lang")}>
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4" />
                    <path
                      d="M1.6 8h12.8M8 1.6c1.7 1.8 2.6 4 2.6 6.4S9.7 12.6 8 14.4C6.3 12.6 5.4 10.4 5.4 8S6.3 3.4 8 1.6Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />
                  </svg>
                  <span>{currentLanguage.native}</span>
                  <span class="lang-menu__caret" aria-hidden="true">⌄</span>
                </summary>
                <ul aria-label={t("site.lang.other")}>
                  <li>
                    <a href={localePath(locale)} aria-current="true" lang={locale}>
                      {currentLanguage.native}
                    </a>
                  </li>
                  {otherLanguages.map((l) => (
                    <li data-code={l.code}>
                      <a href={localePath(l.code)} lang={l.code} hreflang={l.code}>
                        {l.native}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            )
          }
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label={t("site.theme")}
            aria-pressed="false"
          >
            <svg
              class="icon-sun"
              viewBox="0 0 16 16"
              width="15"
              height="15"
              aria-hidden="true"
            >
              <circle
                cx="8"
                cy="8"
                r="3.2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"></circle>
              <path
                d="M8 1v2M8 13v2M1 8h2M13 8h2M3.1 3.1l1.4 1.4M11.5 11.5l1.4 1.4M3.1 12.9l1.4-1.4M11.5 4.5l1.4-1.4"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"></path>
            </svg>
            <svg
              class="icon-moon"
              viewBox="0 0 16 16"
              width="15"
              height="15"
              aria-hidden="true"
            >
              <path
                d="M13.5 10.5A6 6 0 0 1 5.5 2.5a6 6 0 1 0 8 8z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    {
      languagePicker.length > 0 && (
        <div class="lang-suggest" data-lang-suggest hidden>
          <div class="wrap lang-suggest-inner">
            <a data-lang-suggest-link href="/">
              <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4" />
                <path
                  d="M1.6 8h12.8M8 1.6c1.7 1.8 2.6 4 2.6 6.4S9.7 12.6 8 14.4C6.3 12.6 5.4 10.4 5.4 8S6.3 3.4 8 1.6Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
              </svg>
              <span data-lang-suggest-name></span>
              <span aria-hidden="true">→</span>
            </a>
            <button type="button" class="lang-suggest-close" data-lang-dismiss aria-label="×">×</button>
          </div>
        </div>
      )
    }
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap site-foot-ai">
        <span class="site-foot-ai-label">{t("site.foot.askAi")}</span>
        <div class="site-foot-ai-links">
          {aiProviders.map((provider) => (
            <a href={provider.href} target="_blank" rel="noopener noreferrer">
              {provider.label}
            </a>
          ))}
        </div>
      </div>
      <div class="wrap site-foot-inner">
        <a href="mailto:malipetek@gmail.com">malipetek@gmail.com</a>
        <a href="https://github.com/malipetek">github.com/malipetek</a>
        <a href="/portal">{t("site.foot.portal")}</a>
        <span>{t("site.foot.built")}</span>
      </div>
    </footer>
  </body>
</html>

<script>
  import { registerSiteTools } from "../lib/webmcp.js";
  import { fromAcceptLanguage } from "../lib/locales.js";

  // WebMCP: expose this page's own tools to a browser-integrated agent.
  // No-op in browsers that do not implement document.modelContext.
  registerSiteTools();

  /*
   * The browser already says which language its reader wants. Offer that page
   * when it differs from the one they landed on — a strip, not a redirect:
   * auto-redirecting bounces crawlers and people who type the URL they meant.
   * Dismissing it sticks.
   */
  const suggest = document.querySelector<HTMLElement>("[data-lang-suggest]");
  if (suggest && !localStorage.getItem("lang-suggest-dismissed")) {
    const page = document.documentElement.lang;
    const detected = fromAcceptLanguage(
      navigator.languages?.join(",") || navigator.language || "",
    );
    const match =
      detected && detected !== page
        ? document.querySelector<HTMLAnchorElement>(
            `[data-lang-menu] li[data-code="${detected}"] a`,
          )
        : null;
    if (match) {
      const link = suggest.querySelector<HTMLAnchorElement>(
        "[data-lang-suggest-link]",
      )!;
      link.href = match.href;
      link.hreflang = detected;
      suggest.querySelector("[data-lang-suggest-name]")!.textContent =
        match.textContent?.trim() ?? "";
      match.parentElement?.classList.add("is-detected");
      suggest.hidden = false;
    }
    suggest
      .querySelector("[data-lang-dismiss]")
      ?.addEventListener("click", () => {
        localStorage.setItem("lang-suggest-dismissed", "1");
        suggest.hidden = true;
      });
  }

  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const metas = document.querySelectorAll<HTMLMetaElement>(
    'meta[name="theme-color"]',
  );
  const COLORS = { light: "#ffffff", dark: "#0f0e0c" } as const;

  const reflect = () => {
    const theme =
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    toggle?.setAttribute("aria-pressed", String(theme === "dark"));
    // Manual override wins over prefers-color-scheme — point both metas at it.
    metas.forEach((m) => (m.content = COLORS[theme]));
  };
  reflect();

  toggle?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    reflect();
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    background: var(--ink);
    color: var(--bone);
    padding: 0.6em 1em;
  }

  .skip-link:focus {
    left: 0;
  }

  .site-head {
    background: var(--bone) var(--dash-h);
    background-position: 0 100%;
    position: relative;
    z-index: 2;
  }

  .site-head-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.9rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    /* Seven entries now: let them wrap onto a second line on a phone rather
       than run off the edge. */
    flex-wrap: wrap;
    gap: 0.35rem clamp(0.9rem, 2.6vw, 1.6rem);
    font-size: 15px;
    font-weight: 500;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    background: var(--bone);
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .theme-toggle:hover {
    border-color: var(--ink);
  }

  :root[data-theme="light"] .theme-toggle .icon-sun {
    display: none;
  }
  :root[data-theme="dark"] .theme-toggle .icon-moon {
    display: none;
  }

  .site-nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .site-nav a[aria-current="page"] {
    color: var(--ink);
  }

  main {
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  .site-foot {
    margin-top: clamp(3rem, 8vw, 6rem);
    background: var(--bone) var(--dash-h);
    position: relative;
    z-index: 2;
  }

  .site-foot-ai {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    padding-block: 1.2rem 0.1rem;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .site-foot-ai-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .site-foot-ai-links a {
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 12px;
    color: var(--ink);
    text-decoration: none;
  }

  .site-foot-ai-links a:hover {
    background: var(--ink);
    color: var(--bone);
  }

  .site-foot-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    padding-block: 1.4rem;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .site-foot-inner a {
    color: var(--ink-soft);
  }

  /* The language menu sits in the header: the page's own language, then every
     language the page exists in. */
  .lang-menu {
    position: relative;
  }

  .lang-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
    padding: 0.15rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 14px;
  }

  .lang-menu summary:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .lang-menu summary::-webkit-details-marker {
    display: none;
  }

  .lang-menu__caret {
    font-size: 12px;
  }

  .lang-menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 30;
    margin: 0;
    padding: 0.4rem;
    max-height: 60vh;
    overflow-y: auto;
    columns: 2;
    column-gap: 1.2rem;
    max-width: min(28rem, calc(100vw - 2rem));
    list-style: none;
    background: var(--bone);
    border: 1px solid var(--rule-strong);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .lang-menu li {
    break-inside: avoid;
  }

  .lang-menu a {
    display: block;
    padding: 0.15rem 0.35rem;
    white-space: nowrap;
    text-decoration: none;
  }

  .lang-menu a[aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 32rem) {
    .lang-menu ul {
      columns: 1;
    }
  }

  /* The language the browser asked for, when it is not the one on screen. */
  .lang-menu li.is-detected a::after {
    content: " •";
    color: var(--orange);
  }

  /* The offer strip: one line, the reader's own language, dismissible. */
  .lang-suggest {
    background: var(--ink);
    color: var(--bone);
    font-size: 14px;
  }

  .lang-suggest-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.4rem;
  }

  .lang-suggest a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--bone);
    text-decoration: none;
  }

  .lang-suggest a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
  }

  .lang-suggest-close {
    background: none;
    border: 0;
    color: var(--bone);
    font-size: 18px;
    line-height: 1;
    padding: 0 0.3rem;
    cursor: pointer;
  }

  .nav-portal {
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
    text-decoration: none;
  }

  .nav-portal:hover {
    background: var(--ink);
    color: var(--bone);
    text-decoration: none;
  }
</style>
