---
import "../styles/base.css";
import { siteT, localePath } from "../lib/site.js";
import { SOURCE_LOCALE } from "../lib/locales.js";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  /** Open Graph type — 'article' for blog entries, 'website' everywhere else. */
  type?: string;
  image?: string;
  imageAlt?: string;
  /** The page's language; English unless a localized route says otherwise. */
  locale?: string;
  /** Every language this page exists in: renders hreflang links and the picker. */
  languagePicker?: { code: string; native: string }[];
}

const {
  title = "M. Ali Petek",
  description = "Self-serve software contracting by M. Ali Petek: human-approved, agent-built.",
  current = Astro.url.pathname,
  type = "website",
  image = "/me.webp",
  imageAlt = "Muhammet Ali Petek",
  locale = SOURCE_LOCALE,
  languagePicker = [],
} = Astro.props;

const t = siteT(locale);

// Astro.site is set in astro.config.mjs, so these are absolute for crawlers.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const nav = [
  { href: "/", label: t("site.nav.shelf") },
  { href: "/blog", label: t("site.nav.writing") },
  { href: "/kb", label: t("site.nav.kb") },
  { href: "/plugins", label: t("site.nav.plugins") },
  { href: "/experience", label: t("site.nav.work") },
  { href: "/contact", label: t("site.nav.contact") },
  { href: "/#talk", label: t("site.nav.talk") },
];

const isCurrent = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Set the theme before first paint so a saved dark choice never flashes. */
    }
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0f0e0c"
    />
    <link rel="canonical" href={canonical.href} />
    {
      languagePicker.length > 0 && (
        <>
          <link rel="alternate" hreflang={locale} href={canonical.href} />
          {languagePicker.map((l) => (
            <link rel="alternate" hreflang={l.code} href={new URL(localePath(l.code), Astro.site).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />
        </>
      )
    }
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="M. Ali Petek" />
    <meta property="og:locale" content={locale.replace("-", "_")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <link rel="icon" href="/me.webp" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("site.skip")}</a>
    <header class="site-head">
      <div class="wrap site-head-inner">
        <a class="wordmark" href="/">malipetek</a>
        <nav class="site-nav" aria-label={t("site.nav.primary")}>
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label={t("site.theme")}
            aria-pressed="false"
          >
            <svg
              class="icon-sun"
              viewBox="0 0 16 16"
              width="15"
              height="15"
              aria-hidden="true"
            >
              <circle
                cx="8"
                cy="8"
                r="3.2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"></circle>
              <path
                d="M8 1v2M8 13v2M1 8h2M13 8h2M3.1 3.1l1.4 1.4M11.5 11.5l1.4 1.4M3.1 12.9l1.4-1.4M11.5 4.5l1.4-1.4"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"></path>
            </svg>
            <svg
              class="icon-moon"
              viewBox="0 0 16 16"
              width="15"
              height="15"
              aria-hidden="true"
            >
              <path
                d="M13.5 10.5A6 6 0 0 1 5.5 2.5a6 6 0 1 0 8 8z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap site-foot-inner">
        <a href="mailto:malipetek@gmail.com">malipetek@gmail.com</a>
        <a href="https://github.com/malipetek">github.com/malipetek</a>
        <a href="/portal">{t("site.foot.portal")}</a>
        <span>{t("site.foot.built")}</span>
        {
          languagePicker.length > 0 && (
            <details class="lang-picker">
              <summary>{t("site.lang")}</summary>
              <ul aria-label={t("site.lang.other")}>
                {languagePicker.map((l) => (
                  <li>
                    <a href={localePath(l.code)} lang={l.code} hreflang={l.code}>
                      {l.native}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </div>
    </footer>
  </body>
</html>

<script>
  import { registerSiteTools } from "../lib/webmcp.js";

  // WebMCP: expose this page's own tools to a browser-integrated agent.
  // No-op in browsers that do not implement document.modelContext.
  registerSiteTools();

  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const metas = document.querySelectorAll<HTMLMetaElement>(
    'meta[name="theme-color"]',
  );
  const COLORS = { light: "#ffffff", dark: "#0f0e0c" } as const;

  const reflect = () => {
    const theme =
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    toggle?.setAttribute("aria-pressed", String(theme === "dark"));
    // Manual override wins over prefers-color-scheme — point both metas at it.
    metas.forEach((m) => (m.content = COLORS[theme]));
  };
  reflect();

  toggle?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    reflect();
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    background: var(--ink);
    color: var(--bone);
    padding: 0.6em 1em;
  }

  .skip-link:focus {
    left: 0;
  }

  .site-head {
    background: var(--bone) var(--dash-h);
    background-position: 0 100%;
    position: relative;
    z-index: 2;
  }

  .site-head-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.9rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    /* Seven entries now: let them wrap onto a second line on a phone rather
       than run off the edge. */
    flex-wrap: wrap;
    gap: 0.35rem clamp(0.9rem, 2.6vw, 1.6rem);
    font-size: 15px;
    font-weight: 500;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    background: var(--bone);
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .theme-toggle:hover {
    border-color: var(--ink);
  }

  :root[data-theme="light"] .theme-toggle .icon-sun {
    display: none;
  }
  :root[data-theme="dark"] .theme-toggle .icon-moon {
    display: none;
  }

  .site-nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .site-nav a[aria-current="page"] {
    color: var(--ink);
  }

  main {
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  .site-foot {
    margin-top: clamp(3rem, 8vw, 6rem);
    background: var(--bone) var(--dash-h);
    position: relative;
    z-index: 2;
  }

  .site-foot-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    padding-block: 1.4rem;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .site-foot-inner a {
    color: var(--ink-soft);
  }

  /* The language picker: a native name per locale, folded away until asked. */
  .lang-picker {
    position: relative;
  }

  .lang-picker summary {
    cursor: pointer;
    color: var(--ink-soft);
    list-style: none;
  }

  .lang-picker summary::-webkit-details-marker {
    display: none;
  }

  .lang-picker summary::after {
    content: " ⌄";
  }

  .lang-picker[open] summary::after {
    content: " ⌃";
  }

  .lang-picker ul {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 0;
    z-index: 20;
    margin: 0;
    padding: 0.4rem;
    max-height: 60vh;
    overflow-y: auto;
    columns: 2;
    column-gap: 1.2rem;
    list-style: none;
    background: var(--bone);
    border: 1px solid var(--rule-strong);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .lang-picker li {
    break-inside: avoid;
  }

  .lang-picker a {
    display: block;
    padding: 0.15rem 0.3rem;
    white-space: nowrap;
  }
</style>
