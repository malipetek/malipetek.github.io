---
import Base from './Base.astro';
import '../styles/lab-reading.css';

const { frontmatter = {} } = Astro.props;
---

<Base
  title={frontmatter.title ? `${frontmatter.title} — malipetek` : 'malipetek'}
  site={frontmatter.site}
  current={frontmatter.current}
>
  <article class:list={['prose', { 'lab-reading': frontmatter.site === 'lab' }]}>
    <slot />
  </article>
</Base>
