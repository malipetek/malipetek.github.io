---
import Base from '../layouts/Base.astro';
import { isLabRequest } from '../lib/siteHosts';

// Served by both hosts; the navigation and canonical origin follow the Host.
const site = isLabRequest(Astro.request) ? 'lab' : 'contracting';
---

<Base
  site={site}
  title="Not found — malipetek"
  description="Nothing at this address."
  current="/404"
>
  <div class="rails" aria-hidden="true"></div>
  <div class="notfound plate frame">
    <canvas class="notfound-signal" aria-hidden="true"></canvas>
    <h1>Nothing at this address.</h1>
    <p class="notfound-code">404 / Not found</p>
    <p class="lede">
      Whatever was here either never existed or moved when the site split in two.
    </p>
    <p class="notfound-actions">
      <a class="btn btn--solid" href="/">← Back to the homepage</a>
      {site === 'lab' ? (
        <a class="btn" href="/blog">Read something instead</a>
      ) : (
        <a class="btn" href="/contact">Tell me what you were looking for</a>
      )}
    </p>
  </div>
</Base>

<style>
  .notfound {
    --inset-x: clamp(1.25rem, 4vw, 2.5rem);
    padding-block: clamp(1.5rem, 6vw, 3rem);
    max-width: 60ch;
  }

  .notfound-signal {
    display: block;
    width: 100%;
    height: 40px;
    margin-bottom: 1.5rem;
  }

  .notfound-code {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .notfound h1 {
    margin-bottom: 0.4em;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: clamp(1.5rem, 4vw, 2.25rem) 0 0;
  }
</style>

<script>
  // A quiet, interrupted signal: static by design, including reduced motion.
  const signal = document.querySelector<HTMLCanvasElement>('.notfound-signal');
  const context = signal?.getContext('2d');
  if (signal && context) {
    const draw = () => {
      const width = signal.clientWidth;
      const height = signal.clientHeight;
      const scale = Math.min(devicePixelRatio || 1, 2);
      signal.width = Math.round(width * scale);
      signal.height = Math.round(height * scale);
      context.setTransform(scale, 0, 0, scale, 0, 0);
      const tokens = getComputedStyle(document.documentElement);
      context.strokeStyle = tokens.getPropertyValue('--rule-strong').trim();
      context.setLineDash([3, 5]);
      context.beginPath();
      context.moveTo(0, height / 2 + 0.5);
      context.lineTo(width, height / 2 + 0.5);
      context.stroke();
      context.setLineDash([]);
      context.strokeStyle = tokens.getPropertyValue('--ink').trim();
      context.beginPath();
      context.moveTo(0, height / 2 + 0.5);
      context.lineTo(width * 0.42, height / 2 + 0.5);
      context.stroke();
      context.fillStyle = tokens.getPropertyValue('--orange').trim();
      context.fillRect(Math.round(width * 0.42) - 2, height / 2 - 2, 5, 5);
    };
    new ResizeObserver(draw).observe(signal);
    new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    draw();
  }
</script>
