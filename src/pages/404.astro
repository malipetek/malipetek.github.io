---
import Base from '../layouts/Base.astro';
import { isLabRequest } from '../lib/siteHosts';

// Served by both hosts; the navigation and canonical origin follow the Host.
const site = isLabRequest(Astro.request) ? 'lab' : 'contracting';
---

<Base
  site={site}
  title="Not found — malipetek"
  description="Nothing at this address."
  current="/404"
>
  <div class="notfound">
    <p class="notfound-code">404</p>
    <h1>Nothing at this address.</h1>
    <p class="lede">
      Whatever was here either never existed or moved when the site split in two.
    </p>
    <p class="notfound-actions">
      <a class="btn btn--solid" href="/">← Back to the homepage</a>
      {site === 'lab' ? (
        <a class="btn" href="/blog">Read something instead</a>
      ) : (
        <a class="btn" href="/contact">Tell me what you were looking for</a>
      )}
    </p>
  </div>
</Base>

<style>
  .notfound {
    padding-block: clamp(1.5rem, 6vw, 4rem);
    max-width: 60ch;
  }

  .notfound-code {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--ink-soft);
  }

  .notfound h1 {
    margin-bottom: 0.4em;
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: clamp(1.5rem, 4vw, 2.25rem) 0 0;
  }
</style>
