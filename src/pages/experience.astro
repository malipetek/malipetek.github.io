---
import Base from '../layouts/Base.astro';
import { JOBS } from '../lib/experience.js';
---

<Base
  site="lab"
  title="Work — M. Ali Petek's lab"
  description="Where the time went, 2017 to present."
  current="/experience"
>
  <div class="rails" aria-hidden="true"></div>
  <header class="page-head">
    <h1>Work</h1>
    <p class="lede">2017 to present. Every row is real; the gaps are called burnout and hiking.</p>
  </header>

  <canvas class="signal-strip" data-signal-strip aria-hidden="true"></canvas>

  <ol class="jobs">
    {JOBS.map((j) => (
      <li class="job">
        <p class="job-years">{j.years}</p>
        <div class="job-main">
          <h2 class="job-name">{j.link ? <a href={j.link}>{j.name}</a> : j.name}</h2>
          <p class="job-where">{j.where}</p>
          <p class="job-blurb">{j.blurb}</p>
          <p class="job-tags">{j.tags.join(' · ')}</p>
        </div>
      </li>
    ))}
  </ol>

  <p class="muted jobs-note">
    Agencies billed, specifics under NDA. The long TRUTH note lives at
    <a href="/experience/truth">TRUTH NYC</a>, and a session diary written from
    the other side of the keyboard — an agent on a hardware reverse-engineering
    job — is at <a href="/experience/agent-experience">Agent experience</a>.
  </p>
</Base>

<style>
  .signal-strip {
    display: block;
    width: 100%;
    height: 74px;
    margin: 0;
    border-block: 1px solid var(--rule);
  }

  @media (max-width: 640px) {
    .signal-strip {
      height: 56px;
    }
  }

  .lede,
  .job-years {
    font-variant-numeric: tabular-nums;
  }

  .jobs {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .job {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: 0.35rem clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 3.5vw, 2rem) 0;
    border-bottom: 1px solid var(--rule);
    transition: background var(--dur) var(--ease);
  }

  .job:last-child {
    border-bottom: 2px solid var(--ink);
  }

  .job:hover {
    background: rgba(20, 19, 17, 0.035);
  }

  .job-years {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.2;
    color: var(--ink);
  }

  .job-main {
    min-width: 0;
  }

  .job-name {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .job-name a {
    text-decoration: none;
  }

  .job-name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
  }

  .job-where {
    margin: 0.25rem 0 0;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .job-blurb {
    margin: 0.55rem 0 0.5rem;
    max-width: 62ch;
  }

  .job-tags {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .jobs-note {
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    max-width: 62ch;
  }

  @media (max-width: 620px) {
    .job {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-signal-strip]').forEach((strip) => {
    const canvas = strip as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let pointerX = 0.5;
    let targetX = 0.5;

    const draw = (time: number) => {
      const css = getComputedStyle(canvas);
      const rule = css.getPropertyValue('--rule-strong').trim() || '#d2ccc2';
      const orange = css.getPropertyValue('--orange').trim() || '#ff5a1f';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);

      const cell = 10;
      const cols = Math.max(8, Math.floor(width / cell));
      const rows = Math.max(4, Math.floor(height / cell));
      const cw = width / cols;
      const ch = height / rows;

      for (let y = 0; y < rows; y += 1) {
        for (let x = 0; x < cols; x += 1) {
          const envelope = Math.sin((Math.PI * (x + 0.5)) / cols);
          const wave = Math.sin(x * 0.42 + time * 0.0011 + pointerX * Math.PI * 2);
          const drift = Math.cos(x * 0.13 - time * 0.0006) * 0.18;
          const target = rows * 0.5 + (wave + drift) * rows * 0.24 * envelope;
          const dist = Math.abs(y + 0.5 - target);
          let fill = rule;
          let alpha = 0.07 + 0.05 * Math.sin(x * 0.8 + y * 0.5 + time * 0.001);
          let radius = Math.min(cw, ch) * 0.13;
          if (dist < 0.85) {
            fill = orange;
            alpha = 0.92;
            radius = Math.min(cw, ch) * 0.31;
          } else if (dist < 1.7) {
            alpha = 0.34;
            radius = Math.min(cw, ch) * 0.18;
          }
          ctx.globalAlpha = alpha;
          ctx.fillStyle = fill;
          ctx.beginPath();
          ctx.arc((x + 0.5) * cw, (y + 0.5) * ch, radius, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      draw(reduced ? 0 : performance.now());
    };

    const loop = (now: number) => {
      if (reduced) return;
      pointerX += (targetX - pointerX) * 0.06;
      draw(now);
      requestAnimationFrame(loop);
    };

    window.addEventListener('pointermove', (event) => {
      targetX = event.clientX / window.innerWidth;
    }, { passive: true });
    new ResizeObserver(resize).observe(canvas);
    if (reduced) {
      new MutationObserver(() => draw(0)).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    }
    resize();
    if (!reduced) requestAnimationFrame(loop);
  });
</script>
