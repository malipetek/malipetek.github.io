---
import Base from '../../layouts/Base.astro';
import { getPlugins, fmtCount, fmtDay } from '../../lib/plugins';

// Prerender is off: the npm numbers are fetched per request and cached at the
// edge, so a release shows up here without a redeploy.
export const prerender = false;

const plugins = await getPlugins();
const published = plugins.filter((p) => p.npm.published).length;

function versionCell(p: (typeof plugins)[number]) {
  if (p.npm.published) return p.npm.version ?? '—';
  return p.npm.checked ? 'unpublished' : 'unavailable';
}
---

<Base
  site="lab"
  title="DeepSeek plugins — M. Ali Petek's lab"
  description="Plugins for DeepSeek Harness: a projects panel, momentum tracking, managed dev processes, and action cards."
  current="/plugins"
>
  <div class="rails" aria-hidden="true"></div>
  <header class="page-head">
    <h1>DeepSeek plugins</h1>
    <p class="lede">
      Tools I built for my own harness and kept. Each one is a package on npm —
      install it by name and the harness wires up both halves.
    </p>
  </header>

  <canvas class="signal-strip" data-signal-strip aria-hidden="true"></canvas>

  <section class="block intro frame">
    <div class="block-head">
      <h2>Install</h2>
      <span class="label">
        {plugins.length} plugin{plugins.length === 1 ? '' : 's'}
        {published > 0 ? ` · ${published} on npm` : ' · none published yet'}
      </span>
    </div>
    <p class="intro-note">
      In DeepSeek Harness, open the plugin manager and use <strong>Add plugin</strong>,
      or run the command directly:
    </p>
    <pre><code>dsh plugin add @malipetek/dsh-action-cards</code></pre>
    <p class="intro-note muted">
      Installed plugins do not update themselves — upgrading means removing the
      old version and adding the new one.
    </p>
  </section>

  <section class="block">
    <div class="block-head">
      <h2>The set</h2>
    </div>

    <ul class="plugin-list">
      {
        plugins.map((p) => (
          <li>
            <div class="plugin-main">
              <div class="plugin-head">
                <a class="plugin-name" href={`/plugins/${p.slug}`}>
                  {p.title}
                </a>
                {!p.npm.published && (
                  <span class="pill pill--soon" title="Not on npm yet">
                    {p.npm.checked ? 'unpublished' : 'registry unreachable'}
                  </span>
                )}
              </div>
              <code class="plugin-pkg">{p.name}</code>
              <p class="plugin-blurb">{p.blurb}</p>
              <button
                class="btn btn--copy"
                type="button"
                data-copy-agent={p.agentInstructions}
                data-label="Copy agent instructions"
                title="A prompt you can hand an agent to install and configure this plugin"
              >
                Copy agent instructions
              </button>
            </div>

            <dl class="plugin-meta">
              <div>
                <dt>Version</dt>
                <dd>{versionCell(p)}</dd>
              </div>
              <div>
                <dt>Installs / mo</dt>
                <dd>{fmtCount(p.npm.downloads) ?? '—'}</dd>
              </div>
              <div>
                <dt>Published</dt>
                <dd>{fmtDay(p.npm.modified) ?? '—'}</dd>
              </div>
              <div>
                <dt>Surface</dt>
                <dd>{p.hasClient ? 'host + client' : 'host'}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>

    <p class="section-foot">
      Each package keeps its README on npm, its source at
      <a href="https://github.com/malipetek/malipetek.github.io/tree/master/packages"
        >github.com/malipetek</a
      >, and its long-form docs on its own page here.
    </p>
  </section>
</Base>

<script>
  import { initCopyAgentInstructions } from '../../scripts/copy-agent-instructions';
  initCopyAgentInstructions();
</script>

<script>
  document.querySelectorAll('[data-signal-strip]').forEach((strip) => {
    const canvas = strip as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let pointerX = 0.5;
    let targetX = 0.5;

    const draw = (time: number) => {
      const css = getComputedStyle(canvas);
      const rule = css.getPropertyValue('--rule-strong').trim() || '#d2ccc2';
      const orange = css.getPropertyValue('--orange').trim() || '#ff5a1f';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);

      const cell = 10;
      const cols = Math.max(8, Math.floor(width / cell));
      const rows = Math.max(4, Math.floor(height / cell));
      const cw = width / cols;
      const ch = height / rows;

      for (let y = 0; y < rows; y += 1) {
        for (let x = 0; x < cols; x += 1) {
          const envelope = Math.sin((Math.PI * (x + 0.5)) / cols);
          const wave = Math.sin(x * 0.42 + time * 0.0011 + pointerX * Math.PI * 2);
          const drift = Math.cos(x * 0.13 - time * 0.0006) * 0.18;
          const target = rows * 0.5 + (wave + drift) * rows * 0.24 * envelope;
          const dist = Math.abs(y + 0.5 - target);
          let fill = rule;
          let alpha = 0.07 + 0.05 * Math.sin(x * 0.8 + y * 0.5 + time * 0.001);
          let radius = Math.min(cw, ch) * 0.13;
          if (dist < 0.85) {
            fill = orange;
            alpha = 0.92;
            radius = Math.min(cw, ch) * 0.31;
          } else if (dist < 1.7) {
            alpha = 0.34;
            radius = Math.min(cw, ch) * 0.18;
          }
          ctx.globalAlpha = alpha;
          ctx.fillStyle = fill;
          ctx.beginPath();
          ctx.arc((x + 0.5) * cw, (y + 0.5) * ch, radius, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      draw(reduced ? 0 : performance.now());
    };

    const loop = (now: number) => {
      if (reduced) return;
      pointerX += (targetX - pointerX) * 0.06;
      draw(now);
      requestAnimationFrame(loop);
    };

    window.addEventListener('pointermove', (event) => {
      targetX = event.clientX / window.innerWidth;
    }, { passive: true });
    new ResizeObserver(resize).observe(canvas);
    if (reduced) {
      new MutationObserver(() => draw(0)).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    }
    resize();
    if (!reduced) requestAnimationFrame(loop);
  });
</script>

<style>
  .signal-strip {
    display: block;
    width: 100%;
    height: 74px;
    margin: 0;
    border-block: 1px solid var(--rule);
  }

  @media (max-width: 640px) {
    .signal-strip {
      height: 56px;
    }
  }

  .intro.frame {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .block-head .label,
  .plugin-meta dd {
    font-variant-numeric: tabular-nums;
  }

  .intro-note {
    max-width: 62ch;
    font-size: 16px;
    color: var(--ink-soft);
  }

  .intro pre {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.6;
    background: var(--astro-code-background);
    color: var(--astro-code-foreground);
    border: 2px solid var(--ink);
    padding: 1em 1.1em;
    margin: 1.1rem 0;
    overflow-x: auto;
    max-width: 100%;
    width: fit-content;
  }

  .btn--copy {
    font: inherit;
    cursor: pointer;
    margin-top: 0.6rem;
  }

  .btn--copy[data-copied='true'] {
    border-color: var(--ink);
  }

  .section-foot {
    margin-top: 1.5rem;
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 72ch;
  }

  /* Rows, not a <table>: the metadata column collapses under the copy on
     narrow screens instead of forcing a horizontal scroll. */
  .plugin-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .plugin-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
    gap: clamp(1rem, 3vw, 3rem);
    padding: 1.4rem 0;
    border-top: 1px solid var(--rule);
  }

  .plugin-list li:first-child {
    border-top: 2px solid var(--ink);
  }

  .plugin-list li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .plugin-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .plugin-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .plugin-name:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15em 0.5em;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
  }

  .plugin-pkg {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .plugin-blurb {
    margin: 0.6rem 0 0;
    max-width: 62ch;
    font-family: var(--font-body);
    font-size: 16.5px;
    line-height: 1.5;
  }

  .plugin-meta {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
    align-content: start;
  }

  .plugin-meta dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .plugin-meta dd {
    margin: 0.1rem 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
  }

  @media (max-width: 62rem) {
    .plugin-list li {
      grid-template-columns: minmax(0, 1fr);
    }

    .plugin-meta {
      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
      padding-top: 0.4rem;
      border-top: 1px solid var(--rule);
    }
  }
</style>
