---
// Static shell; every action goes through /mcp with the admin session, which
// is where the platform key lives. Nothing privileged is baked in here.
export const prerender = true;

import Base from '../layouts/Base.astro';
import '../styles/portal.css';
import '../styles/kb.css';
---

<Base
  title="GPTflare — malipetek.dev"
  description="Owner view of the GPTflare control plane: sites, previews and deploys, driven over this site's own MCP endpoint."
  current="/platform"
>
  <div class="portal">
    <div class="portal-bar">
      <h1>GPTflare</h1>
      <div class="portal-who">
        <a href="/portal/admin">Portal admin</a>
        <a href="/agents">MCP docs</a>
      </div>
    </div>

    <p class="portal-note" data-loading>Loading…</p>
    <p class="portal-note" data-denied hidden>
      This page is for the site owner. <a href="/portal">Sign in</a>.
    </p>

    <div data-app hidden>
      <p class="portal-note" data-auth-line></p>

      <!-- step 1: platform sign-in -->
      <section data-step="signin" hidden>
        <p class="portal-note">
          The control plane keeps its own sign-in, separate from this portal. Send yourself a magic link, open it,
          and this page picks it up.
        </p>
        <form class="portal-form" data-auth-form>
          <div class="portal-field">
            <label class="portal-label" for="pf-email">GPTflare account email</label>
            <input id="pf-email" name="email" type="email" required />
          </div>
          <div class="portal-actions">
            <button class="btn btn--solid" type="submit">Send sign-in link</button>
          </div>
          <p class="portal-note" data-auth-note role="status" aria-live="polite"></p>
        </form>
      </section>

      <!-- step 2: waiting -->
      <section data-step="pending" hidden>
        <p class="portal-note">
          Link sent. Open it in this browser, then come back — this page polls until the sign-in is verified.
        </p>
        <div class="portal-actions">
          <button class="btn" type="button" data-resend>Send a new link</button>
          <button class="btn" type="button" data-forget>Sign out of GPTflare</button>
        </div>
      </section>

      <!-- step 3: sites -->
      <section data-step="sites" hidden>
        <div class="portal-actions">
          <button class="btn btn--solid" type="button" data-refresh>Sites</button>
          <button class="btn" type="button" data-forget>Sign out of GPTflare</button>
        </div>
        <ul class="ticket-list" data-sites></ul>
        <div class="kb-prose" data-site-detail hidden></div>
      </section>

      <p class="portal-note" data-error role="status" aria-live="polite"></p>
    </div>
  </div>

  <script>
    import { api, session } from '../lib/portal';

    const ARID_KEY = 'gptflare-auth-request';
    const loading = document.querySelector<HTMLElement>('[data-loading]')!;
    const denied = document.querySelector<HTMLElement>('[data-denied]')!;
    const app = document.querySelector<HTMLElement>('[data-app]')!;
    const authLine = document.querySelector<HTMLElement>('[data-auth-line]')!;
    const errorLine = document.querySelector<HTMLElement>('[data-error]')!;
    const authForm = document.querySelector<HTMLFormElement>('[data-auth-form]')!;
    const authNote = document.querySelector<HTMLElement>('[data-auth-note]')!;
    const sitesList = document.querySelector<HTMLElement>('[data-sites]')!;
    const siteDetail = document.querySelector<HTMLElement>('[data-site-detail]')!;
    const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];

    const show = (step: string) => steps.forEach((s) => (s.hidden = s.dataset.step !== step));
    const say = (text: string, bad = false) => {
      errorLine.textContent = text;
      errorLine.classList.toggle('portal-note--bad', bad);
    };

    /**
     * Call this site's own MCP server. The browser is just another MCP client:
     * the portal session goes in the Authorization header, and the platform key
     * never leaves the Worker.
     */
    async function mcp(name: string, args: Record<string, unknown> = {}) {
      const token = session.get();
      const res = await fetch('/mcp', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          ...(token ? { authorization: `Bearer ${token}` } : {}),
        },
        body: JSON.stringify({
          jsonrpc: '2.0',
          id: Date.now(),
          method: 'tools/call',
          params: { name, arguments: args },
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (data.error) throw new Error(data.error.message ?? 'MCP error');
      const text = data.result?.content?.[0]?.text ?? '';
      if (data.result?.isError) throw new Error(text);
      try {
        return JSON.parse(text);
      } catch {
        return text;
      }
    }

    const arid = {
      get: () => localStorage.getItem(ARID_KEY),
      set: (id: string) => localStorage.setItem(ARID_KEY, id),
      clear: () => localStorage.removeItem(ARID_KEY),
    };

    function renderSites(sites: any[]) {
      siteDetail.hidden = true;
      siteDetail.innerHTML = '';
      if (!sites.length) {
        sitesList.replaceChildren();
        say('No sites yet. Ask the GPTflare app to draft one.');
        return;
      }
      sitesList.replaceChildren(
        ...sites.map((site) => {
          const li = document.createElement('li');
          const title = document.createElement('p');
          const strong = document.createElement('strong');
          strong.textContent = site.siteName ?? site.site_slug ?? site.id;
          title.append(strong);
          const meta = document.createElement('p');
          meta.className = 'portal-note';
          meta.textContent = [
            site.status,
            site.workerName ?? site.worker_name,
            site.productionUrl ?? site.production_url,
          ]
            .filter(Boolean)
            .join(' · ');
          li.append(title, meta);

          const actions = document.createElement('div');
          actions.className = 'portal-actions';

          const statusBtn = document.createElement('button');
          statusBtn.className = 'btn';
          statusBtn.type = 'button';
          statusBtn.textContent = 'Status';
          statusBtn.addEventListener('click', async () => {
            say('Reading status…');
            try {
              const detail = await mcp('platform_site_status', {
                auth_request_id: arid.get(),
                site_id: site.id,
              });
              siteDetail.hidden = false;
              siteDetail.innerHTML = '';
              const pre = document.createElement('pre');
              pre.textContent = JSON.stringify(detail, null, 2);
              siteDetail.append(pre);
              say('');
            } catch (error) {
              say((error as Error).message, true);
            }
          });
          actions.append(statusBtn);

          const previewBtn = document.createElement('button');
          previewBtn.className = 'btn';
          previewBtn.type = 'button';
          previewBtn.textContent = 'Preview';
          previewBtn.addEventListener('click', async () => {
            say('Reading preview…');
            try {
              const detail = await mcp('platform_preview_status', {
                auth_request_id: arid.get(),
                site_id: site.id,
              });
              siteDetail.hidden = false;
              siteDetail.innerHTML = '';
              const pre = document.createElement('pre');
              pre.textContent = JSON.stringify(detail, null, 2);
              siteDetail.append(pre);
              say('');
            } catch (error) {
              say((error as Error).message, true);
            }
          });
          actions.append(previewBtn);

          // Destructive: promoting a preview is the one step that reaches
          // production, so it never happens without an explicit confirmation.
          const approveBtn = document.createElement('button');
          approveBtn.className = 'btn';
          approveBtn.type = 'button';
          approveBtn.textContent = 'Approve preview → production';
          approveBtn.addEventListener('click', async () => {
            if (!confirm(`Promote the preview of ${site.siteName ?? site.id} to production?`)) return;
            say('Approving…');
            try {
              const result = await mcp('platform_approve_preview', {
                auth_request_id: arid.get(),
                site_id: site.id,
              });
              say('Approved. ' + (result?.message ?? ''));
              await loadSites();
            } catch (error) {
              say((error as Error).message, true);
            }
          });
          actions.append(approveBtn);

          li.append(actions);
          return li;
        }),
      );
    }

    async function loadSites() {
      show('sites');
      sitesList.replaceChildren();
      try {
        const result = await mcp('platform_list_sites', { auth_request_id: arid.get() });
        const sites = result?.sites ?? result?.recentSites ?? [];
        authLine.textContent = `Signed in to GPTflare · ${sites.length} site${sites.length === 1 ? '' : 's'}`;
        renderSites(sites);
      } catch (error) {
        const message = (error as Error).message;
        if (/sign-in|AUTH_REQUEST/i.test(message)) {
          arid.clear();
          show('signin');
          authLine.textContent = 'Not signed in to GPTflare.';
          say(message, true);
        } else {
          say(message, true);
        }
      }
    }

    async function checkAuth() {
      const id = arid.get();
      if (!id) {
        show('signin');
        authLine.textContent = 'Not signed in to GPTflare.';
        return;
      }
      try {
        const status = await mcp('platform_auth_status', { auth_request_id: id });
        if (status?.status === 'verified' || status?.canCreateSite) {
          await loadSites();
        } else {
          show('pending');
          authLine.textContent = `Sign-in pending for ${status?.email ?? 'your account'}.`;
        }
      } catch (error) {
        // An expired request is not an error worth shouting about — start over.
        arid.clear();
        show('signin');
        authLine.textContent = 'Not signed in to GPTflare.';
        say((error as Error).message);
      }
    }

    authForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = String(new FormData(authForm).get('email') ?? '');
      const button = authForm.querySelector('button')!;
      button.disabled = true;
      authNote.textContent = 'Sending…';
      try {
        const result = await mcp('platform_start_auth', { email });
        arid.set(result.authRequestId);
        authNote.textContent = 'Link sent. Check that inbox.';
        show('pending');
        authLine.textContent = `Sign-in pending for ${email}.`;
      } catch (error) {
        authNote.textContent = (error as Error).message;
      } finally {
        button.disabled = false;
      }
    });

    document.querySelector('[data-resend]')?.addEventListener('click', () => {
      arid.clear();
      show('signin');
      authLine.textContent = 'Not signed in to GPTflare.';
    });
    document.querySelector('[data-forget]')?.addEventListener('click', () => {
      arid.clear();
      show('signin');
      authLine.textContent = 'Signed out of GPTflare on this browser.';
    });
    document.querySelector('[data-refresh]')?.addEventListener('click', () => loadSites());

    (async () => {
      if (!session.get()) return location.replace('/portal');
      try {
        const me = await api<{ user: { role: string; email: string } }>('/portal/me');
        if (me.user.role !== 'admin') {
          loading.hidden = true;
          denied.hidden = false;
          return;
        }
        loading.hidden = true;
        app.hidden = false;
        const emailField = authForm.querySelector<HTMLInputElement>('input[name=email]')!;
        emailField.value = me.user.email;
        await checkAuth();
        // While a link is outstanding, keep asking — the user may open it in
        // another tab, and there is nothing else to do until they do.
        setInterval(() => {
          if (!steps.find((s) => s.dataset.step === 'pending')?.hidden) checkAuth();
        }, 5000);
      } catch {
        location.replace('/portal');
      }
    })();
  </script>
</Base>
