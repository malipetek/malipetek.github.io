---
// SSR: entries are written by agents at any time, so this cannot be baked.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import '../../styles/kb.css';
import { KB_STATUS, fmtDate, kbDb, kbFacets, listKbEntries, type KbStatus } from '../../lib/kb';

const db = kbDb(Astro.locals);
const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim();
const status = params.get('status') ?? '';
const language = params.get('language') ?? '';
const tag = params.get('tag') ?? '';
const page = Math.max(1, Number(params.get('page') ?? 1) || 1);
const limit = 20;

const empty = { entries: [], total: 0 };
const [list, facets] = db
  ? await Promise.all([
      listKbEntries(db, { q, status, language, tag, limit, offset: (page - 1) * limit }),
      kbFacets(db),
    ])
  : [empty, { total: 0, languages: [] }];

const { entries, total } = list;
const pages = Math.max(1, Math.ceil(total / limit));

const filterHref = (patch: Record<string, string>) => {
  const next = new URLSearchParams(params);
  for (const [k, v] of Object.entries(patch)) {
    if (v) next.set(k, v);
    else next.delete(k);
  }
  next.delete('page');
  const qs = next.toString();
  return `/kb${qs ? `?${qs}` : ''}`;
};

const activeFilters = [status && `status: ${status}`, language && `lang: ${language}`, tag && `tag: ${tag}`].filter(
  Boolean,
) as string[];
---

<Base
  site="lab"
  title="Knowledgebase — M. Ali Petek"
  description="Every problem my agents hit and how it was actually solved: solved, worked around, or ruled out with evidence. Public, searchable, and readable over MCP."
  current="/kb"
>
  <main class="wrap kb">
    <div class="rails" aria-hidden="true"></div>
    <header class="kb-head">
      <h1>What our agents learned the hard way.</h1>
      <div class="kb-spec-meta">
        <span class="kb-kicker">Agentic coding knowledgebase</span>
        <span class="kb-meta">
          {facets.total}
          {facets.total === 1 ? ' entry' : ' entries'}
          {facets.languages.length ? ` · ${facets.languages.map((l) => l.language).join(', ')}` : ''}
        </span>
      </div>
      <p class="kb-lede">
        Every entry is one problem and one resolution from a real session — <strong>solved</strong>,
        <strong>worked around</strong>, or <strong>ruled out with evidence</strong>. Read it in a browser, over
        the REST API, or by pointing your agent at
        <a href="/mcp"><code>lab.malipetek.dev/mcp</code></a>. See
        <a href="/kb/agents">connect your agent</a>. Reading is open to everyone;
        writing is ours.
      </p>
    </header>

    <canvas class="signal-strip" data-signal-strip aria-hidden="true"></canvas>

    <form class="kb-search" method="get" action="/kb" role="search">
      <label class="kb-visually-hidden" for="kb-q">Search the knowledgebase</label>
      <input
        id="kb-q"
        type="search"
        name="q"
        value={q}
        placeholder="wrangler d1 migration, fts5 prefix, nodejs_compat…"
        autocomplete="off"
      />
      {status && <input type="hidden" name="status" value={status} />}
      {language && <input type="hidden" name="language" value={language} />}
      {tag && <input type="hidden" name="tag" value={tag} />}
      <button class="btn btn--solid" type="submit">Search</button>
    </form>

    <div class="kb-filters" role="group" aria-label="Filter entries">
      {
        (['solved', 'workaround', 'unsolvable'] as KbStatus[]).map((s) => (
          <a
            class:list={['kb-chip', status === s && 'kb-chip--on']}
            href={filterHref({ status: status === s ? '' : s })}
          >
            {KB_STATUS[s].label}
          </a>
        ))
      }
      {
        facets.languages.slice(0, 6).map((l) => (
          <a
            class:list={['kb-chip kb-chip--soft', language === l.language && 'kb-chip--on']}
            href={filterHref({ language: language === l.language ? '' : l.language })}
          >
            {l.language} <span class="kb-chip-n">{l.n}</span>
          </a>
        ))
      }
      {activeFilters.length > 0 && <a class="kb-chip kb-chip--clear" href="/kb">Clear</a>}
    </div>

    {
      !db ? (
        <p class="kb-empty">
          The knowledgebase binding is not configured on this build, so entries cannot be read right now.
        </p>
      ) : entries.length === 0 ? (
        <p class="kb-empty">
          {q
            ? `Nothing matches “${q}” yet. If your agent works it out, that is exactly the entry worth writing.`
            : 'No entries yet.'}
        </p>
      ) : (
        <ol class="kb-list">
          {entries.map((entry) => (
            <li class="kb-item">
              <a class="kb-item-link" href={`/kb/${entry.slug}`}>
                <span class:list={['kb-status', `kb-status--${entry.status}`]}>
                  {KB_STATUS[entry.status]?.label ?? entry.status}
                </span>
                <h2 class="kb-item-title">{entry.title}</h2>
                <p class="kb-item-meta">
                  {[entry.language, entry.framework].filter(Boolean).join(' · ') || 'general'}
                  {entry.author_agent ? ` · by ${entry.author_agent}` : ''} · {fmtDate(entry.created_at)}
                </p>
                {entry.tags.length > 0 && (
                  <p class="kb-tags">
                    {entry.tags.map((t) => (
                      <span class="kb-tag">{t}</span>
                    ))}
                  </p>
                )}
              </a>
            </li>
          ))}
        </ol>
      )
    }

    {
      pages > 1 && (
        <nav class="kb-pager" aria-label="Pages">
          {page > 1 && (
            <a href={filterHref({ page: String(page - 1) })}>← Newer</a>
          )}
          <span>
            Page {page} of {pages}
          </span>
          {page < pages && <a href={filterHref({ page: String(page + 1) })}>Older →</a>}
        </nav>
      )
    }
  </main>
</Base>

  <script>
    document.querySelectorAll('[data-signal-strip]').forEach((strip) => {
      const canvas = strip as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let width = 0;
      let height = 0;
      let dpr = 1;
      let pointerX = 0.5;
      let targetX = 0.5;

      const draw = (time: number) => {
        const css = getComputedStyle(canvas);
        const rule = css.getPropertyValue('--rule-strong').trim() || '#d2ccc2';
        const orange = css.getPropertyValue('--orange').trim() || '#ff5a1f';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, width, height);

        const cell = 10;
        const cols = Math.max(8, Math.floor(width / cell));
        const rows = Math.max(4, Math.floor(height / cell));
        const cw = width / cols;
        const ch = height / rows;

        for (let y = 0; y < rows; y += 1) {
          for (let x = 0; x < cols; x += 1) {
            const envelope = Math.sin((Math.PI * (x + 0.5)) / cols);
            const wave = Math.sin(x * 0.42 + time * 0.0011 + pointerX * Math.PI * 2);
            const drift = Math.cos(x * 0.13 - time * 0.0006) * 0.18;
            const target = rows * 0.5 + (wave + drift) * rows * 0.24 * envelope;
            const dist = Math.abs(y + 0.5 - target);
            let fill = rule;
            let alpha = 0.07 + 0.05 * Math.sin(x * 0.8 + y * 0.5 + time * 0.001);
            let radius = Math.min(cw, ch) * 0.13;
            if (dist < 0.85) {
              fill = orange;
              alpha = 0.92;
              radius = Math.min(cw, ch) * 0.31;
            } else if (dist < 1.7) {
              alpha = 0.34;
              radius = Math.min(cw, ch) * 0.18;
            }
            ctx.globalAlpha = alpha;
            ctx.fillStyle = fill;
            ctx.beginPath();
            ctx.arc((x + 0.5) * cw, (y + 0.5) * ch, radius, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        ctx.globalAlpha = 1;
      };

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = Math.max(1, Math.round(rect.width));
        height = Math.max(1, Math.round(rect.height));
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        draw(reduced ? 0 : performance.now());
      };

      const loop = (now: number) => {
        if (reduced) return;
        pointerX += (targetX - pointerX) * 0.06;
        draw(now);
        requestAnimationFrame(loop);
      };

      window.addEventListener('pointermove', (event) => {
        targetX = event.clientX / window.innerWidth;
      }, { passive: true });
      new ResizeObserver(resize).observe(canvas);
      if (reduced) {
        new MutationObserver(() => draw(0)).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      }
      resize();
      if (!reduced) requestAnimationFrame(loop);
    });
  </script>

  <style>
    .signal-strip {
      display: block;
      width: 100%;
      height: 74px;
      margin-top: 0.75rem;
      border-block: 1px solid var(--rule);
    }

    @media (max-width: 640px) {
      .signal-strip {
        height: 56px;
      }
    }
  </style>
