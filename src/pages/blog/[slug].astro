---
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate, readMinutes } from '../../lib/posts.js';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} — malipetek`}
  description={post.data.summary}
  current="/blog"
  type="article"
>
  <article class="entry">
    <header class="entry-head">
      <p class="post-meta">{fmtDate(post.data.date)} · {post.data.category} · {readMinutes(post.body)} min</p>
      <h1>{post.data.title}</h1>
      {post.data.summary && <p class="entry-lede">{post.data.summary}</p>}
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="entry-nav" aria-label="More writing">
      {prev && <a href={`/blog/${prev.id}`}>← {prev.data.title}</a>}
      {next && <a class="entry-next" href={`/blog/${next.id}`}>{next.data.title} →</a>}
    </nav>
  </article>
</Base>

<style>
  .entry-head {
    margin-bottom: clamp(1.75rem, 4.5vw, 2.75rem);
  }

  .entry-head h1 {
    /* The reading title carries the page: big, tight, Bricolage. */
    font-size: clamp(2.2rem, 6vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin-bottom: 0;
    max-width: 20ch;
  }

  .entry-lede {
    margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 58ch;
  }

  .entry-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 15px;
  }

  .entry-next {
    margin-left: auto;
    text-align: right;
  }
</style>
