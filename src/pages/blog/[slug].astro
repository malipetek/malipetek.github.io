---
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate, readMinutes } from '../../lib/posts.js';
import { render } from 'astro:content';

// Content is bundled at build time — prerender so getStaticPaths applies and
// the page serves as a static asset instead of crashing in SSR.
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} — malipetek`}
  description={post.data.summary}
  current="/blog"
  type="article"
>
  <article class="entry">
    <p class="entry-back"><a href="/blog">← All writing</a></p>
    <header class="entry-head">
      <p class="post-meta">{fmtDate(post.data.date)} · {post.data.category} · {readMinutes(post.body)} min</p>
      <h1>{post.data.title}</h1>
      {post.data.summary && <p class="entry-lede">{post.data.summary}</p>}
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="entry-nav" aria-label="More writing">
      {prev && (
        <a class="entry-step" href={`/blog/${prev.id}`}>
          <span class="entry-step-dir">← Older</span>
          <span class="entry-step-title">{prev.data.title}</span>
        </a>
      )}
      {next && (
        <a class="entry-step entry-next" href={`/blog/${next.id}`}>
          <span class="entry-step-dir">Newer →</span>
          <span class="entry-step-title">{next.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .entry-back {
    margin: 0 0 1.5rem;
    font-size: 15px;
  }

  .entry-head {
    margin-bottom: clamp(1.75rem, 4.5vw, 2.75rem);
  }

  .entry-head h1 {
    /* The reading title carries the page: big, tight, Bricolage. */
    font-size: clamp(2.2rem, 6vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin-bottom: 0;
    max-width: 20ch;
  }

  .entry-lede {
    margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 58ch;
  }

  .entry-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 76ch;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }

  .entry-step {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 2px solid var(--ink);
    text-decoration: none;
    transition: background var(--dur) var(--ease);
  }

  .entry-step:hover {
    background: var(--orange);
  }

  .entry-step-dir {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  .entry-step:hover .entry-step-dir {
    color: var(--ink);
  }

  .entry-step-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.25;
  }

  .entry-next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 620px) {
    .entry-nav {
      grid-template-columns: minmax(0, 1fr);
    }

    .entry-next {
      grid-column: 1;
    }
  }
</style>
