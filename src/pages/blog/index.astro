---
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate, readMinutes } from '../../lib/posts.js';

const posts = await getPosts();

// Posts arrive newest-first, so walking them once yields year groups in order.
const groups = [];
for (const post of posts) {
  const year = post.data.date.getFullYear();
  let group = groups.at(-1);
  if (!group || group.year !== year) {
    group = { year, posts: [] };
    groups.push(group);
  }
  group.posts.push(post);
}
---

<Base
  site="lab"
  title="Writing — M. Ali Petek's lab"
  description="Real fixes and technical writing from the desk of malipetek."
  current="/blog"
>
  <div class="rails" aria-hidden="true"></div>
  <header class="page-head">
    <h1>Writing</h1>
    <p class="lede">{posts.length} entries, mostly fixes for problems I hit myself.</p>
  </header>

  <canvas class="signal-strip" data-signal-strip aria-hidden="true"></canvas>

  <div class="years">
    {groups.map((group) => (
      <section class="year-group">
        <h2 class="year">
          {group.year}
          <span class="year-count" aria-hidden="true">{group.posts.length}</span>
        </h2>
        <ul class="post-list">
          {group.posts.map((p) => (
            <li>
              <a class="post-link post-link--row" href={`/blog/${p.id}`}>{p.data.title}</a>
              {p.data.summary && <span class="post-summary">{p.data.summary}</span>}
              <span class="post-meta">{fmtDate(p.data.date)} · {p.data.category} · {readMinutes(p.body)} min</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .signal-strip {
    display: block;
    width: 100%;
    height: 74px;
    margin: 0;
    border-block: 1px solid var(--rule);
  }

  @media (max-width: 640px) {
    .signal-strip {
      height: 56px;
    }
  }

  .years {
    margin-top: 1.5rem;
  }

  .lede,
  .year,
  .year-count,
  .post-meta {
    font-variant-numeric: tabular-nums;
  }

  .year-group + .year-group {
    margin-top: clamp(2rem, 5vw, 3.25rem);
  }

  .year {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.4rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .year-count {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  /* The whole row is the link target, like the lab index panels: the title
     carries the underline cue and the row takes the hover tint. */
  .post-list li {
    position: relative;
    transition: background var(--dur) var(--ease);
  }

  .post-list li:has(.post-link--row:hover) {
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }

  .post-list li:has(.post-link--row:hover) .post-meta {
    color: var(--ink);
  }

  .post-list li:first-child {
    border-top: 2px solid var(--ink);
  }
</style>

<script>
  import { initSignalStrips } from '../../scripts/signal-strip';
  initSignalStrips();
</script>
