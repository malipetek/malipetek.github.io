---
import Base from '../../layouts/Base.astro';
import AdminWorkbench from '../../components/AdminWorkbench.jsx';

// Static shell. The Worker enforces the admin role on every /admin/* call;
// this page only decides what to draw. The workbench is the same app the
// Harness Admin plugin mounts (packages/admin-ui).
export const prerender = true;
---

<Base title="Portal admin — malipetek" description="Portal admin." current="/portal">
  <AdminWorkbench client:only="react" />
</Base>
