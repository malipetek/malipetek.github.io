---
import Base from '../../layouts/Base.astro';
import '../../styles/portal.css';
import { ACCEPT } from '../../lib/attachments.js';

// Static shell: the ticket id rides in the hash (#id=12).
export const prerender = true;
---

<Base title="Request — malipetek" description="A client portal request." current="/portal">
  <div class="portal">
    <p class="project-back" style="margin: 0 0 1.5rem; font-size: 15px">
      <a href="/portal">← All requests</a>
    </p>

    <p class="portal-note" data-loading>Loading…</p>

    <article data-ticket hidden>
      <header style="margin-bottom: 1.5rem">
        <p class="portal-label portal-label--plain" data-ticket-meta></p>
        <h1 data-ticket-title style="margin-bottom: 0.5rem"></h1>
        <div data-ticket-status></div>
      </header>

      <!-- Where it is: the homepage machine with this request on the belt. -->
      <section class="track" aria-label="Where your request is">
        <canvas class="track-canvas" data-track-canvas aria-hidden="true"></canvas>
        <div data-track-steps></div>
        <div data-track-now></div>
      </section>

      <section class="track-controls" aria-label="Cost and budget">
        <div data-ticket-cost></div>
        <div data-ticket-gauge></div>
      </section>

      <div data-thread></div>

      <form class="portal-form" data-reply>
        <div class="portal-field">
          <label class="portal-label" for="tr-body">Reply</label>
          <textarea id="tr-body" name="body" rows="5" maxlength="8000"></textarea>
        </div>
        <div class="portal-field">
          <label class="portal-label" for="tr-files">Files <span style="text-transform:none;letter-spacing:0">(optional: screenshots, PDFs — up to 5, 10 MB each)</span></label>
          <input id="tr-files" class="portal-files" name="files" type="file" multiple accept={ACCEPT} />
        </div>
        <div class="portal-actions">
          <button class="btn btn--solid" type="submit">Send reply →</button>
          <p class="portal-note" data-reply-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </article>
  </div>
</Base>

<script>
  import {
    api,
    costBlock,
    errorText,
    renderThread,
    session,
    h,
    statusBadge,
    type Message,
    type Ticket,
  } from '../../lib/portal';
  import { field, openDialog } from '../../lib/fleetAdmin';
  import { checkPicked } from '../../lib/attachments.js';
  import { budgetGauge, nowLine, stepStrip } from '../../lib/tracker';
  import type { TrackStage } from '../../lib/workshop3d';

  // The machine reads this every frame; load() only has to change it.
  let stage: TrackStage = 'new';
  let machineStarted = false;
  /** Start the 3D machine once, lazily: three.js is only fetched on this page. */
  function startMachine() {
    if (machineStarted) return;
    machineStarted = true;
    const canvas = document.querySelector<HTMLCanvasElement>('[data-track-canvas]');
    if (!canvas) return;
    import('../../lib/workshop3d')
      .then(({ initTracker }) => initTracker(canvas, () => stage))
      .catch(() => canvas.remove()); // no WebGL: the strip below says the same thing
  }

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const id = Number(new URLSearchParams(location.hash.slice(1)).get('id'));
  const loading = $('[data-loading]');

  async function load() {
    const { ticket, messages } = await api<{ ticket: Ticket; messages: Message[] }>(
      `/portal/tickets/${id}`,
    );
    document.title = `#${ticket.id} ${ticket.title} — malipetek`;
    $('[data-ticket-meta]').textContent = [`#${ticket.id}`, ticket.project_name]
      .filter(Boolean)
      .join(' · ');
    $('[data-ticket-title]').textContent = ticket.title;
    $('[data-ticket-status]').replaceChildren(statusBadge(ticket.status));
    stage = ticket.status;
    startMachine();
    $('[data-track-steps]').replaceChildren(stepStrip(ticket, messages));
    $('[data-track-now]').replaceChildren(nowLine(ticket));
    const open = ticket.status !== 'done' && ticket.status !== 'declined';
    $('[data-ticket-cost]').replaceChildren(costBlock(ticket));
    $('[data-ticket-gauge]').replaceChildren(
      budgetGauge(ticket),
      open ? h('p', { class: 'portal-actions' }, budgetButton(ticket), ticket.status === 'new' ? withdrawButton() : '') : '',
    );
    // Only redraw the thread when it changed, so a refresh never jumps the page.
    const seen = `${ticket.status}:${messages.length}:${messages.at(-1)?.id ?? 0}`;
    if (seen !== lastSeen) {
      lastSeen = seen;
      $('[data-thread]').replaceChildren(renderThread(messages, 'client', `/portal/tickets/${id}/files`));
    }
    loading.hidden = true;
    $('[data-ticket]').hidden = false;
  }

  /** Work stops when the meter reaches the budget; this is how a client lets it go on. */
  function budgetButton(ticket: Ticket) {
    const b = h('button', { type: 'button', class: 'btn' }, ticket.budget_cents === null ? 'Set a budget' : 'Change the budget');
    b.addEventListener('click', () => {
      const input = h('input', {
        type: 'number',
        min: 1,
        max: 10000,
        step: 1,
        inputmode: 'numeric',
        placeholder: 'No limit',
        value: ticket.budget_cents === null ? undefined : String(ticket.budget_cents / 100),
        style: 'max-width: 12rem',
      });
      const save = async (dollars: number | null, close: () => void, error: (t: string) => void) => {
        try {
          await api(`/portal/tickets/${id}/budget`, {
            method: 'PATCH',
            body: { budgetCents: dollars === null ? null : Math.round(dollars * 100) },
          });
          close();
          await load();
        } catch (e) {
          error(errorText(e));
        }
      };
      openDialog({
        title: 'Budget for this request',
        subtitle: 'Work pauses when the cost reaches it, until you or Ali raise it.',
        body: [field('Budget in USD', input, 'Leave empty for no limit.')],
        actions: (close, error) => {
          const cancel = h('button', { type: 'button', class: 'btn' }, 'Cancel');
          cancel.addEventListener('click', close);
          const ok = h('button', { type: 'button', class: 'btn btn--solid' }, 'Save budget');
          ok.addEventListener('click', () => {
            const raw = input.value.trim();
            const dollars = raw === '' ? null : Number(raw);
            if (dollars !== null && !(Number.isInteger(dollars) && dollars >= 1 && dollars <= 10000)) {
              return error('A whole number of dollars, from 1 to 10,000.');
            }
            void save(dollars, close, error);
          });
          return [cancel, ok];
        },
      });
    });
    return b;
  }

  /** Before Ali has approved it, a request can be taken back at no cost. */
  function withdrawButton() {
    const b = h('button', { type: 'button', class: 'btn' }, 'Withdraw request');
    b.addEventListener('click', () => {
      openDialog({
        title: 'Withdraw this request?',
        subtitle: 'Ali has not started on it, so it costs nothing. It closes, and he is told.',
        body: [],
        actions: (close, error) => {
          const cancel = h('button', { type: 'button', class: 'btn' }, 'Keep it');
          cancel.addEventListener('click', close);
          const ok = h('button', { type: 'button', class: 'btn btn--solid' }, 'Withdraw');
          ok.addEventListener('click', async () => {
            try {
              await api(`/portal/tickets/${id}/withdraw`, { method: 'POST' });
              close();
              await load();
            } catch (e) {
              error(errorText(e));
            }
          });
          return [cancel, ok];
        },
      });
    });
    return b;
  }

  let lastSeen = '';
  // Status changes and Ali's replies show up without a reload while the tab is
  // open: every 10s while the request is moving through the machine, so the
  // ticket on the belt moves soon after it really does, and every 30s otherwise.
  const ACTIVE = new Set(['approved', 'in_progress', 'review']);
  let lastPoll = 0;
  setInterval(() => {
    if (document.visibilityState !== 'visible' || $('[data-ticket]').hidden) return;
    const every = ACTIVE.has(stage) ? 10_000 : 30_000;
    if (Date.now() - lastPoll < every) return;
    lastPoll = Date.now();
    load().catch(() => undefined);
  }, 2_000);

  async function boot() {
    if (!session.get()) return location.replace('/portal');
    if (!Number.isInteger(id) || id <= 0) {
      loading.textContent = 'No request selected.';
      return;
    }
    try {
      await load();
    } catch (error) {
      if (!session.get()) return location.replace('/portal');
      loading.textContent = errorText(error);
      loading.classList.add('is-error');
    }
  }

  $<HTMLFormElement>('[data-reply]').addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const status = $('[data-reply-status]');
    const button = form.querySelector('button')!;
    const data = new FormData(form);
    const files = ($<HTMLInputElement>('#tr-files').files ?? []) as FileList;
    const text = String(data.get('body') || '').trim();
    status.classList.remove('is-error');
    const problem = files.length ? checkPicked(files) : text ? null : 'Write something, or attach a file.';
    if (problem) {
      status.textContent = problem;
      status.classList.add('is-error');
      return;
    }
    button.disabled = true;
    status.textContent = files.length ? 'Uploading…' : 'Sending…';
    try {
      await api(`/portal/tickets/${id}/messages`, files.length ? { form: data } : { body: { body: text } });
      form.reset();
      status.textContent = 'Sent.';
      await load();
    } catch (error) {
      status.textContent = errorText(error);
      status.classList.add('is-error');
    } finally {
      button.disabled = false;
    }
  });

  window.addEventListener('hashchange', () => location.reload());
  boot();
</script>
