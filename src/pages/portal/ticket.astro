---
import Base from '../../layouts/Base.astro';
import ClientPortal from '../../components/portal/ClientPortal.jsx';
import PortalFrame from '../../components/portal/PortalFrame.astro';
import '../../styles/client-portal.css';

// The address in notification emails (/portal/ticket#id=12). The portal app
// moves it onto its own route, #/ticket/12.
export const prerender = true;
---

<Base title="Request — malipetek" description="A client portal request." current="/portal" chrome={false} expect="#portal-frame">
  <PortalFrame />
  <ClientPortal client:only="react" />
</Base>
