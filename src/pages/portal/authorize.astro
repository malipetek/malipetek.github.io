---
import Base from '../../layouts/Base.astro';
import '../../styles/portal.css';

// OAuth consent for an MCP client (ChatGPT and others). The Worker checks
// every parameter; this page only asks the person. See worker/src/oauth.ts.
export const prerender = true;
---

<Base title="Connect an assistant — malipetek" description="Allow an assistant to work on your account." current="/portal">
  <div class="portal">
    <p class="portal-note" data-loading>Checking the request…</p>

    <section class="consent" data-bad hidden>
      <h1>This request cannot be used</h1>
      <p class="portal-note" data-bad-text></p>
      <p class="portal-actions"><a class="btn" href="/portal">Go to the portal</a></p>
    </section>

    <section class="consent" data-signin hidden>
      <h1>Sign in first</h1>
      <p class="lede">
        <strong data-client-name></strong> wants to connect to your malipetek.dev
        account. Sign in here, in this window, and decide straight after. New
        here? The same email makes your account.
      </p>
      <form class="portal-form" data-email-form>
        <label class="portal-field">
          <span class="portal-label">Your email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <div class="portal-actions">
          <button type="submit" class="btn btn--solid">Email me a code</button>
        </div>
      </form>
      <form class="portal-form" data-code-form hidden>
        <p class="portal-note">
          We sent a six-digit code to <strong data-sent-to></strong>. Type it
          here. Opening the email’s link in this browser works too: this window
          carries on by itself.
        </p>
        <label class="portal-field">
          <span class="portal-label">Code</span>
          <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required />
        </label>
        <div class="portal-actions">
          <button type="submit" class="btn btn--solid">Sign in</button>
          <button type="button" class="btn" data-other-email>Use another address</button>
        </div>
      </form>
      <p class="portal-note" data-signin-status role="status" aria-live="polite"></p>
    </section>

    <section class="consent" data-ask hidden>
      <h1>Connect <span data-client-name></span>?</h1>
      <p class="lede">
        It will act for <strong data-email></strong> and send you back to
        <strong class="consent-host" data-host></strong>.
      </p>
      <p class="portal-note">Only allow this if you started connecting an assistant just now, and that address is the one you expect.</p>
      <h2 class="portal-label">It will be able to</h2>
      <ul class="consent-list">
        <li>see your projects and how ready they are</li>
        <li>read your requests and their conversations</li>
        <li>file requests, reply, and change a request’s budget</li>
      </ul>
      <h2 class="portal-label">It will not be able to</h2>
      <ul class="consent-list">
        <li>start any work: Ali still reads every request first</li>
        <li>see other people’s projects, or make keys for other assistants</li>
      </ul>
      <p class="portal-note">You can disconnect it any time under “Connect an assistant” in the portal.</p>
      <div class="portal-actions">
        <button type="button" class="btn btn--solid" data-allow>Allow</button>
        <button type="button" class="btn" data-deny>Cancel</button>
        <p class="portal-note" data-status role="status" aria-live="polite"></p>
      </div>
    </section>
  </div>
</Base>

<script>
  import { api, codeLogin, errorText, requestLink, session, type User } from '../../lib/portal';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const q = new URLSearchParams(location.search);
  const params = {
    client_id: q.get('client_id') ?? '',
    redirect_uri: q.get('redirect_uri') ?? '',
    code_challenge: q.get('code_challenge') ?? '',
    code_challenge_method: q.get('code_challenge_method') ?? '',
    state: q.get('state') ?? undefined,
  };

  function show(which: 'bad' | 'signin' | 'ask', text = '') {
    $('[data-loading]').hidden = true;
    for (const name of ['bad', 'signin', 'ask']) $(`[data-${name}]`).hidden = name !== which;
    if (which === 'bad') $('[data-bad-text]').textContent = text;
  }

  /** Back to the app, with an OAuth error. Only after the Worker confirmed the URI is registered. */
  function sendBack(error: string) {
    const back = new URL(params.redirect_uri);
    back.searchParams.set('error', error);
    if (params.state) back.searchParams.set('state', params.state);
    location.href = back.toString();
  }

  let me: User | null = null;

  async function signedIn() {
    if (!session.get()) return false;
    try {
      ({ user: me } = await api<{ user: User }>('/portal/me'));
      return true;
    } catch {
      return false;
    }
  }

  /** Resolves once this window has a session: from the code form, or from another tab's sign-in link. */
  function waitForSignIn() {
    return new Promise<void>((resolve) => {
      const status = $('[data-signin-status]');
      const emailForm = $<HTMLFormElement>('[data-email-form]');
      const codeForm = $<HTMLFormElement>('[data-code-form]');
      const channel = 'BroadcastChannel' in window ? new BroadcastChannel('portal-oauth') : null;
      let done = false;
      let email = '';
      const finish = async () => {
        if (done || !(await signedIn())) return;
        done = true;
        localStorage.removeItem('portal-return');
        window.removeEventListener('storage', onStorage);
        resolve();
      };
      const onStorage = (e: StorageEvent) => {
        if (e.key === 'portal-session' && e.newValue) void finish();
      };
      window.addEventListener('storage', onStorage);
      // The link's tab asks whether a consent window is waiting, so it can
      // send the person back here instead of finishing in a tab no one watches.
      channel?.addEventListener('message', (e) => {
        // It keeps answering after sign-in: this window shows the consent next.
        if (e.data?.type === 'who-waits') channel.postMessage({ type: 'waiting' });
      });
      const say = (text: string, error = false) => {
        status.textContent = text;
        status.classList.toggle('is-error', error);
      };

      emailForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const button = emailForm.querySelector('button')!;
        email = String(new FormData(emailForm).get('email') ?? '').trim();
        button.disabled = true;
        say('Sending…');
        try {
          const res = await requestLink(email);
          $('[data-sent-to]').textContent = email;
          emailForm.hidden = true;
          codeForm.hidden = false;
          say(res.devCode ? `Local dev: the code is ${res.devCode}.` : '');
          codeForm.querySelector('input')!.focus();
        } catch (error) {
          say(errorText(error), true);
        } finally {
          button.disabled = false;
        }
      });
      codeForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const button = codeForm.querySelector<HTMLButtonElement>('button[type=submit]')!;
        const code = String(new FormData(codeForm).get('code') ?? '').replace(/\s+/g, '');
        button.disabled = true;
        say('Signing in…');
        try {
          const res = await codeLogin(email, code);
          session.set(res.session);
          say('');
          await finish();
        } catch (error) {
          say(errorText(error), true);
          button.disabled = false;
        }
      });
      $('[data-other-email]').addEventListener('click', () => {
        codeForm.reset();
        codeForm.hidden = true;
        emailForm.hidden = false;
        say('');
        emailForm.querySelector('input')!.focus();
      });
    });
  }

  (async () => {
    if (q.get('response_type') !== 'code') return show('bad', 'It does not ask for an authorization code.');
    if (params.code_challenge_method !== 'S256' || !params.code_challenge) {
      return show('bad', 'It does not use PKCE (S256), which this server requires.');
    }
    let client: { name: string; redirectHost: string };
    try {
      const query = new URLSearchParams({ client_id: params.client_id, redirect_uri: params.redirect_uri });
      client = await api(`/oauth/client?${query}`);
    } catch (error) {
      const code = (error as { code?: string }).code;
      return show('bad', code === 'bad_redirect' ? 'It would send you somewhere the app never registered.' : code === 'unknown_client' ? 'The app is not registered here.' : errorText(error));
    }
    document.querySelectorAll('[data-client-name]').forEach((el) => (el.textContent = client.name));
    $('[data-host]').textContent = client.redirectHost;

    if (!(await signedIn())) {
      // The sign-in email may be opened anywhere. A code typed here, or a link
      // opened in another tab of this browser, both bring the session back to
      // this window, the one the assistant is waiting on.
      localStorage.setItem('portal-return', location.href);
      show('signin');
      await waitForSignIn();
    }
    const user = me!;
    if (user.role !== 'client') return show('bad', 'Only a client account can connect an assistant.');
    $('[data-email]').textContent = user.email;
    show('ask');

    $('[data-allow]').addEventListener('click', async () => {
      const status = $('[data-status]');
      $<HTMLButtonElement>('[data-allow]').disabled = true;
      status.textContent = 'Connecting…';
      try {
        const { redirect } = await api<{ redirect: string }>('/oauth/approve', { body: params });
        location.href = redirect;
      } catch (error) {
        status.textContent = (error as { code?: string }).code === 'too_many_tokens' ? 'Five assistants are connected already. Disconnect one in the portal first.' : errorText(error);
        status.classList.add('is-error');
        $<HTMLButtonElement>('[data-allow]').disabled = false;
      }
    });
    $('[data-deny]').addEventListener('click', () => sendBack('access_denied'));
  })();
</script>
