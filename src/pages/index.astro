---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { siteT, copy, OTHER_LOCALES } from "../lib/site.js";
import { SOURCE_LOCALE } from "../lib/locales.js";

const t = siteT(SOURCE_LOCALE);
// A static shell per language; the homepage is the one page that exists in all
// of them so far, so it is also where the language picker points.
export const prerender = true;
---

<Base
  title={t("site.home.title")}
  description={t("site.home.description")}
  current="/"
  locale={SOURCE_LOCALE}
  languagePicker={OTHER_LOCALES.map((l) => ({ code: l.code, native: l.native }))}
>
  <Home t={t} locale={SOURCE_LOCALE} />
</Base>
