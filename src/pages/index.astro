---
import Base from "../layouts/Base.astro";
import Intercom from "../components/Intercom.astro";
import WorkshopScene from "../components/WorkshopScene.astro";
import "../styles/kb.css";
import { getCollection } from "astro:content";
import { getPosts, fmtDate, readMinutes } from "../lib/posts.js";
import { JOBS } from "../lib/experience.js";
import {
  KIND as OFFER_KIND,
  ONE_LINE,
  PRICE_NOTE,
  PRICE_RULE,
  PRICE_WHY,
  SERVERLESS,
  STEPS,
  WHO,
} from "../lib/offer.js";
import { ATTENTION, clock, money, timeCents } from "../lib/pricing.js";
import { kbDb, listKbEntries, kbFacets, type KbSummary } from "../lib/kb";
import { getPluginSummaries } from "../lib/plugins";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    a.data.order - b.data.order || (a.data.year ?? 0) - (b.data.year ?? 0),
);

const site = (await getCollection("site"))[0]?.data;
const tagline = site?.tagline ?? ONE_LINE;
const intercomGreeting =
  site?.intercomGreeting ??
  "Ali's line. I'm the assistant that knows how he works. Tell me what you need built or fixed.";
const intercomSuggestions = site?.intercomSuggestions ?? [];
const email = site?.email ?? "malipetek@gmail.com";
const availability = site?.availability ?? "limited";

const posts = await getPosts();
const latest = posts.slice(0, 5);

// Manifest-only, so the front page never waits on the npm registry. Versions
// and install counts live on /plugins, which does read npm.
const plugins = getPluginSummaries();

// The knowledgebase is written by agents between deploys, so it is read at
// request time rather than baked into the build. A KB problem must never take
// the front page down with it.
const kb = kbDb(Astro.locals);
let kbRecent: KbSummary[] = [];
let kbTotal = 0;
if (kb) {
  try {
    const [list, facets] = await Promise.all([
      listKbEntries(kb, { limit: 4 }),
      kbFacets(kb),
    ]);
    kbRecent = list.entries;
    kbTotal = facets.total;
  } catch {
    kbRecent = [];
    kbTotal = 0;
  }
}

// Shelf vocabulary. The kind band is the only color signal on a box.
const KIND = {
  "shopify-app": {
    label: "Shopify app",
    plural: "Shopify apps",
    color: "#95bf47",
  },
  game: { label: "Game", plural: "Games", color: "var(--orange)" },
  "mobile-app": {
    label: "Mobile app",
    plural: "Mobile apps",
    color: "#2f6fb5",
  },
  tool: { label: "Tool", plural: "Tools", color: "var(--ink)" },
  experiment: { label: "Experiment", plural: "Experiments", color: "#5b574f" },
};

const FILTERS = [
  { value: "all", label: "All" },
  { value: "shopify-app", label: "Shopify apps" },
  { value: "mobile-app", label: "Mobile apps" },
  { value: "game", label: "Games" },
  { value: "tool", label: "Tools" },
  { value: "experiment", label: "Experiments" },
];

const STATUS = {
  live: "Live",
  beta: "Beta",
  archived: "Archived",
  wip: "Work in progress",
};

const initial = (title) =>
  title
    .replace(/^\[placeholder\]\s*/i, "")
    .trim()
    .charAt(0)
    .toUpperCase();
---

<Base
  title="M. Ali Petek — human-approved, agent-built software work"
  description="Self-serve software contracting. You send a request, Ali approves it, an AI agent builds it, and he reviews it before anything ships."
  current="/"
>
  <div class="rails" aria-hidden="true"></div>
  <WorkshopScene />

  <section class="room room--masthead" data-station="hero">
    <div class="masthead-inner">
      <p class="masthead-who">
        <img
          class="masthead-portrait"
          src="/me.webp"
          alt="Muhammet Ali Petek"
          width="120"
          height="120"
          loading="eager"
        />
        <span>
          <strong>M. Ali Petek</strong>
          <span class="masthead-kind">{OFFER_KIND}</span>
        </span>
      </p>
      <h1 class="masthead-name">Human-approved,<br />agent-built.</h1>
      <div class="masthead-body">
        <p class="masthead-lede">{tagline}</p>
        <div class="masthead-actions">
          <a class="btn btn--solid" href="/portal">Open a ticket →</a>
          <a class="btn" href="#how">How it works ↓</a>
        </div>
        <p class="masthead-note">{PRICE_NOTE}</p>
      </div>
    </div>
  </section>

  <section class="room room--panel" id="how" data-station="how">
    <div class="plate frame">
      <div class="block-head">
        <h2><span class="room-no" aria-hidden="true">01</span>How it works</h2>
        <p class="block-note">{WHO}</p>
      </div>

      <ol class="steps">
        {
          STEPS.map((step, i) => (
            <li class="step">
              <span class="step-no" aria-hidden="true">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="price">
        <div class="price-head">
          <h3>What it costs</h3>
          <p>{PRICE_RULE}</p>
          <p>{PRICE_WHY}</p>
        </div>
        <div class="terms">
          {
            ATTENTION.map((a) => (
              <div class="term">
                <h3>
                  {a.name}
                  <span>
                    {a.typicalSeconds
                      ? `e.g. ${clock(a.typicalSeconds)} of my time = ${money(timeCents(a.typicalSeconds))}`
                      : `by the clock = ${money(timeCents(3600))} an hour`}
                  </span>
                </h3>
                <p>{a.what}</p>
              </div>
            ))
          }
        </div>
        <p class="price-foot">
          <strong>{SERVERLESS.title}.</strong>
          {SERVERLESS.body}
        </p>
      </div>
    </div>
  </section>

  <section class="room shelf-section" id="shelf" data-station="shelf">
    <div class="block-head">
      <h2><span class="room-no" aria-hidden="true">02</span>The shelf</h2>
      <p class="block-note">{projects.length} things I built and still answer for. Proof there is a developer behind the agent.</p>
    </div>

    <div class="chips" role="group" aria-label="Filter projects">
      {
        FILTERS.map((f) => (
          <button
            type="button"
            class="chip"
            data-filter={f.value}
            aria-pressed={f.value === "all" ? "true" : "false"}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <ul class="shelf" data-shelf>
      {
        projects.map((p) => {
          const kind = KIND[p.data.kind];
          return (
            <li
              class="box"
              data-kind={p.data.kind}
              style={`--kind:${kind.color}`}
            >
              <span class="box-band" aria-hidden="true" />
              <a
                class="box-cover"
                href={`/projects/${p.id}`}
                tabindex="-1"
                aria-hidden="true"
              >
                {p.data.cover ? (
                  <img src={p.data.cover} alt="" loading="lazy" />
                ) : (
                  <span class="box-initial">{initial(p.data.title)}</span>
                )}
              </a>
              <div class="box-face">
                <a class="box-title" href={`/projects/${p.id}`}>
                  {p.data.title}
                </a>
                <p class="box-meta">
                  {kind.label}
                  {p.data.year ? ` · ${p.data.year}` : ""}
                </p>
                {p.data.tagline && <p class="box-tagline">{p.data.tagline}</p>}
              </div>
              <div class="box-foot">
                <p class="box-status">{STATUS[p.data.status]}</p>
                <div class="box-links">
                  {p.data.links.map((l) => (
                    <a class="btn" href={l.url}>
                      {l.label}
                    </a>
                  ))}
                  <a class="btn" href={`/projects/${p.id}`}>
                    Details
                  </a>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
    <p class="shelf-empty" data-shelf-empty hidden>
      Nothing on this shelf with that label.
    </p>
  </section>

  <section class="room room--panel" id="writing" data-station="writing">
    <div class="plate frame">
    <div class="block-head">
      <h2><span class="room-no" aria-hidden="true">03</span>Writing</h2>
      <a href="/blog">All {posts.length} posts →</a>
    </div>
    <ul class="post-list">
      {
        latest.map((p) => (
          <li>
            <a class="post-link post-link--row" href={`/blog/${p.id}`}>
              {p.data.title}
            </a>
            <span class="post-meta">
              {fmtDate(p.data.date)} · {p.data.category} · {readMinutes(p.body)}{" "}
              min
            </span>
          </li>
        ))
      }
    </ul>
    </div>
  </section>

  <section class="room room--panel" id="work" data-station="work">
    <div class="plate frame">
    <div class="block-head">
      <h2><span class="room-no" aria-hidden="true">04</span>Where I've worked</h2>
      <a href="/experience">Full record →</a>
    </div>

    <ol class="timeline" data-timeline>
      {
        JOBS.map((j) => (
          <li class="tl-item">
            <span class="tl-years">{j.years}</span>
            <span class="tl-rail" aria-hidden="true">
              <span class="tl-dot" />
            </span>
            <button
              class="tl-node"
              type="button"
              aria-expanded="false"
              data-blurb={j.blurb}
              data-tags={j.tags.join(" · ")}
            >
              {j.name}
              {j.where ? <span class="tl-where">{j.where}</span> : null}
            </button>
          </li>
        ))
      }
    </ol>

    <div class="tl-readout" data-tl-readout aria-live="polite">
      <p class="tl-readout-blurb tl-hint">
        Hover a stop, or tab through and press, to read the damage.
      </p>
      <p class="tl-readout-tags"></p>
    </div>
    </div>
  </section>

  <section class="room room--panel" id="knowledge" data-station="library">
    <div class="plate frame">
    <div class="block-head">
      <h2><span class="room-no" aria-hidden="true">05</span>Agent knowledgebase</h2>
      <a href="/kb">All {kbTotal} entries →</a>
    </div>

    {
      kbRecent.length > 0 ? (
        <ul class="kb-home">
          {kbRecent.map((entry) => (
            <li>
              <a href={`/kb/${entry.slug}`}>
                <span class={`kb-home-status kb-home-status--${entry.status}`}>
                  {entry.status === "unsolvable" ? "dead end" : entry.status}
                </span>
                <span class="kb-home-title">{entry.title}</span>
                <span class="kb-home-meta">
                  {[entry.language, entry.framework].filter(Boolean).join(" · ") || "general"}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="block-note">Nothing published yet.</p>
      )
    }

    <p class="kb-home-foot">
      Every problem my agents hit, and what actually fixed it — public, searchable, and
      mountable by your own agent at <code>malipetek.dev/mcp</code>.
    </p>
    </div>
  </section>

  <section class="room room--panel" id="plugins" data-station="library">
    <div class="plate frame">
    <div class="block-head">
      <h2><span class="room-no" aria-hidden="true">06</span>DeepSeek plugins</h2>
      <a href="/plugins">All {plugins.length} plugins →</a>
    </div>

    <ul class="post-list plugin-home">
      {
        plugins.map((p) => (
          <li>
            <a class="post-link post-link--row" href={`/plugins/${p.slug}`}>
              {p.title}
            </a>
            <span class="plugin-home-pkg">{p.name}</span>
            <span class="post-summary">{p.blurb}</span>
          </li>
        ))
      }
    </ul>

    <p class="kb-home-foot">
      I build these for my own harness and publish them to npm under{" "}
      <code>@malipetek</code>. Install one with{" "}
      <code>dsh plugin add &lt;name&gt;</code>, or read the whole set at{" "}
      <a href="/plugins">malipetek.dev/plugins</a>.
    </p>
    </div>
  </section>

  <Intercom
    greeting={intercomGreeting}
    suggestions={intercomSuggestions}
    email={email}
    availability={availability}
  />
</Base>

<script>
  // The shelf: one box open at a time, opened by click, hover (fine pointers),
  // or keyboard focus. aria-expanded mirrors the visual state so screen readers
  // get the same story.
  const shelf = document.querySelector<HTMLElement>("[data-shelf]");
  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".chip[data-filter]"),
  );
  const emptyNote = document.querySelector<HTMLElement>("[data-shelf-empty]");

  if (shelf) {
    const boxes = Array.from(shelf.querySelectorAll<HTMLLIElement>(".box"));

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) =>
          c.setAttribute("aria-pressed", String(c === chip)),
        );
        const filter = chip.dataset.filter;
        let visible = 0;
        boxes.forEach((box) => {
          const match = filter === "all" || box.dataset.kind === filter;
          box.hidden = !match;
          if (match) visible += 1;
        });
        if (emptyNote) emptyNote.hidden = visible > 0;
      });
    });
  }

  // The timeline: one stop expanded at a time. Readout is aria-live so the
  // blurb arrives for screen readers too.
  const timeline = document.querySelector<HTMLElement>("[data-timeline]");
  const readout = document.querySelector<HTMLElement>("[data-tl-readout]");

  if (timeline && readout) {
    const items = Array.from(
      timeline.querySelectorAll<HTMLLIElement>(".tl-item"),
    );
    const blurbEl = readout.querySelector<HTMLElement>(".tl-readout-blurb");
    const tagsEl = readout.querySelector<HTMLElement>(".tl-readout-tags");

    const activate = (item: HTMLLIElement) => {
      items.forEach((other) => {
        const node = other.querySelector<HTMLButtonElement>(".tl-node")!;
        const on = other === item;
        other.classList.toggle("is-open", on);
        node.setAttribute("aria-expanded", String(on));
      });
      const node = item.querySelector<HTMLButtonElement>(".tl-node")!;
      if (blurbEl) {
        blurbEl.classList.remove("tl-hint");
        blurbEl.textContent = node.dataset.blurb ?? "";
      }
      if (tagsEl) tagsEl.textContent = node.dataset.tags ?? "";
    };

    const canHover = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;
    items.forEach((item) => {
      const node = item.querySelector<HTMLButtonElement>(".tl-node")!;
      node.addEventListener("click", () => activate(item));
      if (canHover) node.addEventListener("mouseenter", () => activate(item));
      node.addEventListener("focus", () => activate(item));
    });
  }

  // On a direct load with a hash (e.g. /#talk), the browser's fragment scroll
  // races scroll restoration + snap proximity and can land one room short.
  // Re-assert the target once everything has settled.
  if (location.hash) {
    const land = () =>
      document
        .querySelector<HTMLElement>(location.hash)
        ?.scrollIntoView({ behavior: "instant", block: "start" });
    window.addEventListener("load", () => setTimeout(land, 60));
    setTimeout(land, 600);
  }
</script>

<style>
  /* ————— rooms ————— */

  /* The canvas is flat --bone where no station objects sit, so DOM text stays
     readable without extra backing. Opaque pieces (shelf boxes, the intercom)
     cover the scene — that's the "2d on top" split. No z-index on main: the
     page rails (z 0), the transparent canvas (z 0, later in the DOM) and the
     rooms (z 1) must share one stacking context, so the props occlude the
     rails and the text sits over both. */
  :global(main) {
    position: relative;
  }

  /* Everything in a room insets from the rails by the same amount a plate
     pads its content, so text never sits on a rail line. */
  .room {
    --inset-x: clamp(1rem, 3.2vw, 2.5rem);
  }

  /* Rooms are full-viewport; the layout's main padding would push the first
     room down. */
  :global(main) {
    padding-block: 0;
  }

  /* The intercom is the last room; its translucent orange field lets the
     beacon glow through. Needs position/z-index to paint over the fixed
     canvas. */
  :global(.intercom) {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  /* ————— room furniture ————— */

  /* Room numbers: the spec-sheet index that ties the four rooms together. */
  .room-no {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  .room-no::after {
    content: " /";
    color: var(--orange);
  }

  /* Headings carry a room number above them, so align the right-hand link to
     the heading's bottom edge rather than the number's baseline. */
  .block-head {
    align-items: flex-end;
  }

  /* The shelf's note reads as a caption under its heading, not a far-right
     link slot. */
  .shelf-section .block-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .block-note {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* Plugin rows reuse the Writing room's list. The package name is the one
     extra line, in mono so it reads as an identifier and not as prose. */
  .plugin-home-pkg {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .room--panel .post-list li:has(.post-link--row:hover) .plugin-home-pkg {
    color: var(--ink);
  }

  /* Plates: an opaque sheet the list/timeline sits on, so the station behind
     frames the content instead of running through it. The hairline and the
     corner handles come from .frame; the plate spans the column, so its
     edges land on the page rails. */
  .plate {
    padding: clamp(1.25rem, 3.2vw, 2.25rem) var(--inset-x)
      clamp(1.25rem, 3.2vw, 2rem);
  }

  .room--masthead,
  .shelf-section {
    padding-inline: var(--inset-x);
  }

  /* Seams: a full-bleed dashed rule where one room meets the next, with a
     handle where it crosses each rail. */
  .room + .room::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 1px;
    transform: translateX(-50%);
    background: var(--dash-h);
    pointer-events: none;
  }

  .room + .room::after {
    content: "";
    position: absolute;
    top: calc((var(--handle) - 1px) / -2);
    left: calc((var(--handle) - 1px) / -2);
    right: calc((var(--handle) - 1px) / -2);
    height: var(--handle);
    --in: linear-gradient(var(--bone) 0 0);
    --out: linear-gradient(var(--rule-strong) 0 0);
    --i: calc(var(--handle) - 2px);
    background:
      var(--in) 1px 1px / var(--i) var(--i),
      var(--in) calc(100% - 1px) 1px / var(--i) var(--i),
      var(--out) 0 0 / var(--handle) var(--handle),
      var(--out) 100% 0 / var(--handle) var(--handle);
    background-repeat: no-repeat;
    pointer-events: none;
  }

  .plate .block-head {
    margin-bottom: 1rem;
  }

  .plate .post-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  /* The whole row is the link target; the title carries the underline cue. */
  .room--panel .post-list li {
    position: relative;
    transition: background var(--dur) var(--ease);
  }

  .post-link--row::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-link--row:hover {
    background: none;
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
  }

  .room--panel .post-list li:has(.post-link--row:hover) .post-meta {
    color: var(--ink);
  }

  /* ————— masthead ————— */

  .masthead-inner {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    /* The diorama owns the right side on wide screens (see workshop3d). */
    max-width: min(100%, 46rem);
  }

  /* Who is behind it: small, human, first — a pill badge above the headline. */
  .masthead-who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    margin: 0;
    padding: 5px 18px 5px 5px;
    font-size: 15px;
    line-height: 1.25;
    background: var(--bone);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .masthead-who strong {
    display: block;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  .masthead-kind {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .masthead-portrait {
    flex: none;
    width: 40px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }

  .masthead-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
    /* Optical: pull the H's stem onto the column edge. */
    margin-left: -0.04em;
  }

  .masthead-body {
    max-width: 52ch;
  }

  .masthead-lede {
    margin: 0;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.005em;
    color: var(--ink-soft);
    max-width: 38ch;
  }

  .masthead-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1rem, 2.5vw, 1.6rem);
  }

  .masthead-note {
    margin: 0.9rem 0 0;
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* ————— how it works ————— */

  #how .block-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }

  .step {
    padding: 1.25rem 1.25rem 1.4rem 0;
  }

  .step + .step {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .step-no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
  }

  /* The two steps a person does are the ones that carry the signal colour. */
  .step:nth-child(2) .step-no,
  .step:nth-child(4) .step-no {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--ink);
  }

  .step h3,
  .term h3 {
