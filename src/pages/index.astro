---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Muhammet Ali Petek"
  description="Full stack developer with build experience and love for building things"
>
  <section class="portfolio-hero">
    <div class="container">
      <img src="/me.webp" alt="Muhammet Ali Petek" class="hero-image" />
      <h1 class="gradient-title">Muhammet Ali Petek</h1>
      <p class="tagline">
        Full stack developer with build experience and love for building things
      </p>
      <div class="cta-row">
        <a class="btn primary" href="/chat">💬 Let's talk</a>
        <a class="btn secondary" href="/experience">🔖 Experience</a>
      </div>
    </div>
  </section>

  <section class="container section-block">
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">🫡</div>
        <h3>Full Stack (Node + Anything)</h3>
        <p>
          I sometimes just delete the modules I wrote to prove myself I can
          rewrite the thing once it is figured out.
        </p>
        <a href="/experience">Learn more →</a>
      </div>
      <div class="feature-card">
        <div class="feature-icon">😑</div>
        <h3>Loves Simplicity & the Cheap</h3>
        <p>
          I love to use simple and open source tools, offer my clients cheap and
          open source solutions.
        </p>
      </div>
