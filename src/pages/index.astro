---
import Base from "../layouts/Base.astro";
import Intercom from "../components/Intercom.astro";
import WorkshopScene from "../components/WorkshopScene.astro";
import { getCollection } from "astro:content";
import { getPosts, fmtDate, readMinutes } from "../lib/posts.js";
import { JOBS } from "../lib/experience.js";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    a.data.order - b.data.order || (a.data.year ?? 0) - (b.data.year ?? 0),
);

const site = (await getCollection("site"))[0]?.data;
const tagline =
  site?.tagline ??
  "Full-stack developer. I build Shopify apps, small games, and the tools I wish existed.";
const intercomGreeting =
  site?.intercomGreeting ??
  "Ali's line. He's probably debugging something — I'm the assistant that knows his work. What are you building?";
const intercomSuggestions = site?.intercomSuggestions ?? [];
const email = site?.email ?? "malipetek@gmail.com";
const availability = site?.availability ?? "limited";

const posts = await getPosts();
const latest = posts.slice(0, 5);

// Shelf vocabulary. The kind band is the only color signal on a box.
const KIND = {
  "shopify-app": {
    label: "Shopify app",
    plural: "Shopify apps",
    color: "#95bf47",
  },
  game: { label: "Game", plural: "Games", color: "var(--orange)" },
  tool: { label: "Tool", plural: "Tools", color: "var(--ink)" },
  experiment: { label: "Experiment", plural: "Experiments", color: "#5b574f" },
};

const FILTERS = [
  { value: "all", label: "All" },
  { value: "shopify-app", label: "Shopify apps" },
  { value: "game", label: "Games" },
  { value: "tool", label: "Tools" },
  { value: "experiment", label: "Experiments" },
];

const STATUS = {
  live: "Live",
  beta: "Beta",
  archived: "Archived",
  wip: "Work in progress",
};

const initial = (title) =>
  title
    .replace(/^\[placeholder\]\s*/i, "")
    .trim()
    .charAt(0)
    .toUpperCase();
---

<Base
  title="Muhammet Ali Petek — full-stack developer"
  description="Muhammet Ali Petek (malipetek) builds Shopify apps, small games, and the tools he wishes existed."
  current="/"
>
  <WorkshopScene />

  <section class="room room--masthead">
    <div class="masthead-inner">
      <h1 class="masthead-name">M. Ali<br />Petek</h1>
      <img
        class="masthead-portrait"
        src="/me.webp"
        alt="Muhammet Ali Petek"
        width="360"
        height="360"
        loading="eager"
      />
      <div class="masthead-body">
        <p class="masthead-lede">{tagline}</p>
        <div class="masthead-actions">
          <a class="btn" href="#shelf">See the shelf ↓</a>
          <a class="btn btn--solid" href="#talk">Talk to me →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="room shelf-section" id="shelf">
    <div class="block-head">
      <h2>The shelf</h2>
    </div>

    <div class="chips" role="group" aria-label="Filter projects">
      {
        FILTERS.map((f) => (
          <button
            type="button"
            class="chip"
            data-filter={f.value}
            aria-pressed={f.value === "all" ? "true" : "false"}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <ul class="shelf" data-shelf>
      {
        projects.map((p) => {
          const kind = KIND[p.data.kind];
          return (
            <li
              class="box"
              data-kind={p.data.kind}
              style={`--kind:${kind.color}`}
            >
              <span class="box-band" aria-hidden="true" />
              <a
                class="box-cover"
                href={`/projects/${p.id}`}
                tabindex="-1"
                aria-hidden="true"
              >
                {p.data.cover ? (
                  <img src={p.data.cover} alt="" loading="lazy" />
                ) : (
                  <span class="box-initial">{initial(p.data.title)}</span>
                )}
              </a>
              <div class="box-face">
                <a class="box-title" href={`/projects/${p.id}`}>
                  {p.data.title}
                </a>
                <p class="box-meta">
                  {kind.label}
                  {p.data.year ? ` · ${p.data.year}` : ""}
                </p>
                <p class="box-tagline">{p.data.tagline}</p>
              </div>
              <div class="box-foot">
                <p class="box-status">{STATUS[p.data.status]}</p>
                <div class="box-links">
                  {p.data.links.map((l) => (
                    <a class="btn" href={l.url}>
                      {l.label}
                    </a>
                  ))}
                  <a class="btn" href={`/projects/${p.id}`}>
                    Details
                  </a>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
    <p class="shelf-empty" data-shelf-empty hidden>
      Nothing on this shelf with that label.
    </p>
  </section>

  <section class="room room--panel" id="writing">
    <div class="block-head">
      <h2>Writing</h2>
      <a href="/blog">All writing →</a>
    </div>
    <ul class="post-list">
      {
        latest.map((p) => (
          <li>
            <a class="post-link" href={`/blog/${p.id}`}>
              {p.data.title}
            </a>
            <span class="post-meta">
              {fmtDate(p.data.date)} · {p.data.category} · {readMinutes(p.body)}{" "}
              min
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="room room--panel" id="work">
    <div class="block-head">
      <h2>Where I've worked</h2>
      <a href="/experience">Full record →</a>
    </div>

    <ol class="timeline" data-timeline>
      {
        JOBS.map((j) => (
          <li class="tl-item">
            <span class="tl-years">{j.years}</span>
            <span class="tl-rail" aria-hidden="true">
              <span class="tl-dot" />
            </span>
            <button
              class="tl-node"
              type="button"
              aria-expanded="false"
              data-blurb={j.blurb}
              data-tags={j.tags.join(" · ")}
            >
              {j.name}
              {j.where ? <span class="tl-where">{j.where}</span> : null}
            </button>
          </li>
        ))
      }
    </ol>

    <div class="tl-readout" data-tl-readout aria-live="polite">
      <p class="tl-readout-blurb tl-hint">
        Hover a stop, or tab through and press, to read the damage.
      </p>
      <p class="tl-readout-tags"></p>
    </div>
  </section>

  <Intercom
    greeting={intercomGreeting}
    suggestions={intercomSuggestions}
    email={email}
    availability={availability}
  />
</Base>

<script>
  // The shelf: one box open at a time, opened by click, hover (fine pointers),
  // or keyboard focus. aria-expanded mirrors the visual state so screen readers
  // get the same story.
  const shelf = document.querySelector<HTMLElement>("[data-shelf]");
  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".chip[data-filter]"),
  );
  const emptyNote = document.querySelector<HTMLElement>("[data-shelf-empty]");

  if (shelf) {
    const boxes = Array.from(shelf.querySelectorAll<HTMLLIElement>(".box"));

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) =>
          c.setAttribute("aria-pressed", String(c === chip)),
        );
        const filter = chip.dataset.filter;
        let visible = 0;
        boxes.forEach((box) => {
          const match = filter === "all" || box.dataset.kind === filter;
          box.hidden = !match;
          if (match) visible += 1;
        });
        if (emptyNote) emptyNote.hidden = visible > 0;
      });
    });
  }

  // The timeline: one stop expanded at a time. Readout is aria-live so the
  // blurb arrives for screen readers too.
  const timeline = document.querySelector<HTMLElement>("[data-timeline]");
  const readout = document.querySelector<HTMLElement>("[data-tl-readout]");

  if (timeline && readout) {
    const items = Array.from(
      timeline.querySelectorAll<HTMLLIElement>(".tl-item"),
    );
    const blurbEl = readout.querySelector<HTMLElement>(".tl-readout-blurb");
    const tagsEl = readout.querySelector<HTMLElement>(".tl-readout-tags");

    const activate = (item: HTMLLIElement) => {
      items.forEach((other) => {
        const node = other.querySelector<HTMLButtonElement>(".tl-node")!;
        const on = other === item;
        other.classList.toggle("is-open", on);
        node.setAttribute("aria-expanded", String(on));
      });
      const node = item.querySelector<HTMLButtonElement>(".tl-node")!;
      if (blurbEl) {
        blurbEl.classList.remove("tl-hint");
        blurbEl.textContent = node.dataset.blurb ?? "";
      }
      if (tagsEl) tagsEl.textContent = node.dataset.tags ?? "";
    };

    const canHover = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;
    items.forEach((item) => {
      const node = item.querySelector<HTMLButtonElement>(".tl-node")!;
      node.addEventListener("click", () => activate(item));
      if (canHover) node.addEventListener("mouseenter", () => activate(item));
      node.addEventListener("focus", () => activate(item));
    });
  }

  // On a direct load with a hash (e.g. /#talk), the browser's fragment scroll
  // races scroll restoration + snap proximity and can land one room short.
  // Re-assert the target once everything has settled.
  if (location.hash) {
    const land = () =>
      document
        .querySelector<HTMLElement>(location.hash)
        ?.scrollIntoView({ behavior: "instant", block: "start" });
    window.addEventListener("load", () => setTimeout(land, 60));
    setTimeout(land, 600);
  }
</script>

<style>
  /* ————— rooms ————— */

  /* The canvas is flat --bone where no station objects sit, so DOM text stays
     readable without extra backing. Opaque pieces (shelf boxes, the intercom)
     cover the scene — that's the "2d on top" split. */
  :global(main) {
    position: relative;
    z-index: 1;
  }

  /* Rooms are full-viewport; the layout's main padding would push the first
     room down. */
  :global(main) {
    padding-block: 0;
  }

  /* The intercom is the last room; its translucent orange field lets the
     beacon glow through. Needs position/z-index to paint over the fixed
     canvas. */
  :global(.intercom) {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  /* ————— masthead ————— */

  .masthead-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name name"
      "body portrait";
    align-items: end;
    column-gap: clamp(1rem, 3vw, 3rem);
    row-gap: clamp(0.9rem, 2vw, 1.6rem);
  }

  .masthead-name {
    grid-area: name;
    /* Escape the centred .wrap so the name crops against the viewport edge. */
    margin: 0 0 0
      calc(-1 * (var(--pad) + max(0px, (100vw - 78rem) / 2)) - 0.035em);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(64px, 14vw, 200px);
    line-height: 0.86;
    letter-spacing: -0.05em;
  }

  .masthead-portrait {
    grid-area: portrait;
    justify-self: end;
    width: clamp(160px, 18vw, 260px);
    aspect-ratio: 1;
    object-fit: cover;
    padding: clamp(5px, 0.7vw, 10px);
    background: var(--bone);
    border: 2px solid var(--ink);
    /* Nudge off-grid with a transform, not a negative margin: a negative
       margin would shrink the auto grid track under `max-width: 100%`. */
    transform: rotate(-2deg) translateX(clamp(0.5rem, 2vw, 2rem));
    /* Ride up into the name row's empty right side so the masthead stays
       inside the first viewport without shrinking the portrait. */
    margin-top: calc(-1 * clamp(1rem, 3vw, 3rem));
    margin-bottom: clamp(0.25rem, 1.5vw, 1rem);
  }

  .masthead-body {
    grid-area: body;
    align-self: start;
    max-width: 52ch;
  }

  .masthead-lede {
    margin: 0;
    font-size: clamp(1.05rem, 1.9vw, 1.35rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 44ch;
  }

  .masthead-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1rem, 2.5vw, 1.6rem);
  }

  /* ————— shelf ————— */

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.4rem 0 1.4rem;
  }

  .chip {
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
    background: transparent;
    border: 2px solid var(--ink);
    border-radius: 0;
    padding: 0.45em 0.85em;
    cursor: pointer;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .chip:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--ink);
  }

  .chip[aria-pressed="true"] {
    background: var(--ink);
    color: var(--bone);
  }

  .chip[aria-pressed="true"]:hover {
    color: var(--bone);
    border-color: var(--ink);
  }

  .shelf {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: stretch;
    gap: 14px;
    /* Boxes stand on the plank; it ends shortly after the last one and the
       ::after tail is the "room for more" gap. Overflow scrolls sideways so
       every box stays on the board. */
    width: fit-content;
    min-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 3px solid var(--ink);
  }

  .shelf::after {
    content: "";
    flex: 0 0 clamp(2.5rem, 6vw, 4.5rem);
    height: 1px;
    align-self: flex-end;
  }

  .box {
    flex: 0 0 auto;
    width: 238px;
    min-height: 316px;
    display: flex;
    flex-direction: column;
    background: var(--bone);
    border: 2px solid var(--ink);
  }

  .box[hidden] {
    display: none;
  }

  .box-band {
    flex: 0 0 14px;
    background: var(--kind);
    border-bottom: 2px solid var(--ink);
  }

  .box-cover {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 110px;
    overflow: hidden;
    text-decoration: none;
  }

  .box-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .box-initial {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 52px;
    line-height: 1;
    color: var(--kind);
  }

  .box-face {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 14px 0;
    border-top: 2px solid var(--ink);
  }

  .box-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .box-title:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }

  .box-meta {
    margin: 0;
    font-size: 11.5px;
    color: var(--ink-soft);
  }

  .box-tagline {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--ink);
  }

  .box-foot {
    margin-top: auto;
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .box-status {
    margin: 0;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .box-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .box-links .btn {
    font-size: 12.5px;
    padding: 0.45em 0.7em;
  }

  .shelf-empty {
    margin: 1rem 0 0;
    color: var(--ink-soft);
  }

  /* ————— timeline ————— */

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }

  .tl-item {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .tl-years {
    font-size: 12px;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tl-rail {
    position: relative;
    height: 20px;
    border-top: 2px solid var(--ink);
  }

  .tl-dot {
    position: absolute;
    top: -4px;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--bone);
    transition:
      background var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .tl-item.is-open .tl-dot {
    background: var(--orange);
    transform: scale(1.3);
  }

  .tl-node {
    display: block;
    width: 100%;
    padding: 8px 14px 8px 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.15;
    text-align: left;
    color: var(--ink);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .tl-node:hover,
  .tl-item.is-open .tl-node {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }

  .tl-where {
    display: block;
    font-weight: 400;
    font-size: 12px;
    color: var(--ink-soft);
  }

  .tl-readout {
    margin-top: 1rem;
    min-height: 4rem;
    max-width: 68ch;
  }

  .tl-readout-blurb {
    margin: 0 0 0.35rem;
    min-height: 1.5em;
  }

  .tl-readout-tags {
    margin: 0;
    font-size: 13px;
    color: var(--ink-soft);
    min-height: 1em;
  }

  .tl-hint {
    color: var(--ink-soft);
  }

  #shelf,
  #writing,
  #work,
  #talk {
    scroll-margin-top: 1rem;
  }

  /* ————— tablet + mobile ————— */

  @media (max-width: 760px) {
    .masthead-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "name"
        "body"
        "portrait";
      align-items: start;
    }

    .masthead-portrait {
      justify-self: start;
      transform: rotate(-2deg);
      margin-left: clamp(0.5rem, 8vw, 3rem);
      margin-top: 0.5rem;
    }

    .shelf {
      display: block;
      width: auto;
      border-bottom: 0;
      overflow: visible;
    }

    .shelf::after {
      display: none;
    }

    .box {
      width: 100%;
      min-height: 0;
    }

    .box-cover {
      height: 140px;
    }

    .box + .box {
      margin-top: 14px;
    }

    .timeline {
      display: block;
      border-left: 2px solid var(--ink);
      padding-left: 16px;
    }

    .tl-item {
      display: block;
      position: relative;
      padding-bottom: 0.4rem;
    }

    .tl-item::before {
      content: "";
      position: absolute;
      left: -22px;
      top: 4px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--ink);
      border: 2px solid var(--bone);
    }

    .tl-item.is-open::before {
      background: var(--orange);
    }

    .tl-years {
      font-size: 12px;
    }

    .tl-rail {
      display: none;
    }

    .tl-node {
      padding: 0.15rem 0 0.5rem;
    }

    .tl-node:hover,
    .tl-item.is-open .tl-node {
      color: var(--ink);
      text-decoration: underline;
      text-decoration-color: var(--orange);
      text-decoration-thickness: 3px;
      text-underline-offset: 3px;
    }
  }
</style>
