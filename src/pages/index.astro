---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import Lab from "../components/Lab.astro";
import { siteT } from "../lib/site.js";
import { LOCALES, SOURCE_LOCALE } from "../lib/locales.js";
import { isLabRequest } from "../lib/siteHosts";

// The Host decides the site; malipetek.dev is the lab now, and the retired
// lab.malipetek.dev 301s here (src/lib/siteHosts.ts).
export const prerender = false;

const lab = isLabRequest(Astro.request);
const t = siteT(SOURCE_LOCALE);
---

{
  lab ? (
    <Base
      site="lab"
      title="M. Ali Petek's lab"
      description="What agents learned on real jobs, DeepSeek Harness plugins, writing and work, from M. Ali Petek's lab."
      current="/"
    >
      <Lab />
    </Base>
  ) : (
    <Base
      title={t("site.home.title")}
      description={t("site.home.description")}
      path="/"
      locale={SOURCE_LOCALE}
      languagePicker={LOCALES.map((l) => ({ code: l.code, native: l.native }))}
    >
      <Home t={t} locale={SOURCE_LOCALE} />
    </Base>
  )
}
