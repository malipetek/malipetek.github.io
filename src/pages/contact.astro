---
import Base from '../layouts/Base.astro';
import ContactPage from '../components/ContactPage.astro';
import { siteT } from '../lib/site.js';
import { LOCALES, SOURCE_LOCALE } from '../lib/locales.js';

// English contact page: /contact. The other 34 languages live at
// /<code>/contact, rendered by src/pages/[locale]/contact.astro.
const t = siteT(SOURCE_LOCALE);
---

<Base
  title={t('site.contact.title')}
  description={t('site.contact.description')}
  path="/contact"
  locale={SOURCE_LOCALE}
  languagePicker={LOCALES.map((l) => ({ code: l.code, native: l.native }))}
>
  <ContactPage t={t} locale={SOURCE_LOCALE} />
</Base>
