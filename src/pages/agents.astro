---
// Static: the tool list is our own contract, not live data.
export const prerender = true;

import Base from '../layouts/Base.astro';
import '../styles/kb.css';

const ENDPOINT = String(import.meta.env.PUBLIC_CHAT_ENDPOINT || '').replace(/\/+$/, '');

const KB_TOOLS = [
  { name: 'search_knowledge', auth: 'public', text: 'Full-text search over every entry. Prefix matching, so `migra` finds `migration`.' },
  { name: 'get_knowledge', auth: 'public', text: 'One entry in full — problem and solution markdown — by id or slug.' },
  { name: 'list_knowledge', auth: 'public', text: 'Newest entries first, without bodies.' },
  { name: 'create_knowledge', auth: 'ack_ key', text: 'Record a problem/solution pair from a session.' },
  { name: 'update_knowledge', auth: 'ack_ key', text: 'Patch an entry this key authored.' },
];

const PORTAL_TOOLS = [
  { name: 'portal_projects / portal_requests / portal_request', auth: 'client key', text: 'The account\'s projects and requests, with status and cost.' },
  { name: 'portal_file_request', auth: 'client key', text: 'File a request for Ali — nothing starts until he reads it.' },
  { name: 'portal_reply', auth: 'client key', text: 'Add a message to a request\'s conversation.' },
  { name: 'portal_set_budget', auth: 'client key', text: 'Raise, lower or remove a request\'s budget.' },
  { name: 'portal_withdraw', auth: 'client key', text: 'Take back a request Ali has not approved yet.' },
];
---

<Base
  title="Connect your agent — M. Ali Petek"
  description="One MCP endpoint for this site: a public agentic coding knowledgebase plus the client portal. Works with ChatGPT apps, Claude, and any MCP client."
  current="/agents"
>
  <main class="wrap kb">
    <header class="kb-head">
      <p class="kb-kicker">Model Context Protocol</p>
      <h1>Point an agent at this site.</h1>
      <p class="kb-lede">
        Everything here is reachable over one endpoint:
        <a href="/mcp"><code>https://malipetek.dev/mcp</code></a> — streamable HTTP, protocol
        <code>2025-06-18</code>. The knowledgebase tools are open to anyone. The portal tools work for a client
        with an agent key they mint in the portal — they see exactly their own account.
      </p>
    </header>

    <section class="kb-block">
      <h2>Connect, per client</h2>
      <div class="kb-prose">
        <p>
          One URL serves everything: <code>https://malipetek.dev/mcp</code> — streamable HTTP, protocol
          <code>2025-06-18</code>. Discovery is also published at
          <a href="/.well-known/mcp-server.json"><code>/.well-known/mcp-server.json</code></a>.
        </p>

        <h3>ChatGPT</h3>
        <p>
          ChatGPT builds apps on MCP connectors now, not Custom GPT Actions. Turn on
          <strong>Settings → Connectors → Advanced → Developer mode</strong>, then add a connector:
        </p>
        <pre><code>Name:  malipetek.dev
URL:   https://malipetek.dev/mcp
Auth:  No authentication    # the public tools
       Bearer cat_…         # a client's agent key (portal → Connect an assistant)</code></pre>

        <h3>Claude, Cursor, anything else</h3>
        <p>
          Same URL. Claude: <strong>Settings → Connectors → Add custom connector</strong>. Cursor, in
          <code>mcp.json</code>:
        </p>
        <pre><code>&#123; "mcpServers": &#123; "malipetek": &#123; "url": "https://malipetek.dev/mcp" &#125; &#125; &#125;</code></pre>

        <h3>No client at all</h3>
        <pre><code>curl -s https://malipetek.dev/mcp -H 'content-type: application/json' \
  -d '&#123;"jsonrpc":"2.0","id":1,"method":"tools/list"&#125;'</code></pre>
      </div>
    </section>

    <section class="kb-block">
      <h2>Onboarding: what an agent needs, and what it does not</h2>
      <div class="kb-prose">
        <p>
          <strong>Reading needs nothing.</strong> <code>search_knowledge</code>,
          <code>get_knowledge</code>, <code>list_knowledge</code>, every <code>kb://entry/…</code> resource
          and the whole REST API are open — no key, no sign-up, no handshake.
        </p>
        <p>
          <strong>Writing needs a key we mint</strong>, and that is the point: open to read, authored only by
          us. There is deliberately no self-serve route.
        </p>
        <ol>
          <li>The owner signs in at <a href="/portal">/portal</a> and opens <a href="/kb/new">/kb/new</a>.</li>
          <li>Mint a key named after the agent that will hold it (<code>claude-code</code>, <code>cursor</code>…).</li>
          <li>The agent sends it as <code>Authorization: Bearer ack_…</code>. Stored only as a SHA-256 hash, shown once.</li>
          <li>Every use updates <code>last_used_at</code>; revoking is one click, so a leaked key is visible and short-lived.</li>
        </ol>
        <p>
          The portal tools are a third tier: the client's own agent key (<code>cat_…</code>), which they mint
          and revoke in the portal. It sees exactly their own account — the same routes the browser uses.
        </p>
      </div>
    </section>

    <section class="kb-block">
      <h2>WebMCP: the same capabilities, inside the page</h2>
      <div class="kb-prose">
        <p>
          A backend MCP server is something the agent's platform reaches. <strong>WebMCP</strong>
          (<code>document.modelContext</code>) is the other direction: the page registers tools that reuse its
          own code and keep the visible UI in sync with what the agent just did.
        </p>
        <p>
          This site registers three, feature-detected — a browser without the API loads the module and does
          nothing at all:
        </p>
        <ul>
          <li>
            <code>search_knowledge(query, status?)</code> — returns entries, and updates the visible results
            when the visitor is on <a href="/kb">/kb</a>.
          </li>
          <li><code>open_knowledge_entry(slug)</code> — opens the entry in the visitor's own browser.</li>
          <li>
            <code>open_intercom()</code> — scrolls to the intercom and focuses the bell. Registered only on
            pages that have one, because tools should match the page state.
          </li>
        </ul>
        <p>
          Three, not thirty: every registered tool spends context window and invites tool confusion, which is
          the failure mode the spec itself warns about.
        </p>
      </div>
    </section>

    <section class="kb-block">
      <h2>Knowledgebase tools</h2>
      <ul class="kb-tool-list">
        {KB_TOOLS.map((tool) => (
          <li>
            <code>{tool.name}</code>
            <span class="kb-tool-auth">{tool.auth}</span>
            <span class="kb-tool-text">{tool.text}</span>
          </li>
        ))}
      </ul>
      <p class="kb-entry-foot">
        Mint an <code>ack_</code> key at <a href="/kb/new"><code>/kb/new</code></a> (owner only) and pass it as
        <code>Authorization: Bearer ack_…</code>. Keys are stored hashed and can be revoked there.
      </p>
    </section>

    <section class="kb-block">
      <h2>Client portal tools</h2>
      <div class="kb-prose">
        <p>
          The <strong>portal</strong> is where clients file requests and watch them get done. An agent with a
          client's key can do the same: file, reply, set a budget, withdraw — every one still waits for Ali
          before work starts. Client sites are hosted on <code>malipetek.online</code>; a change lands on the
          preview first and only goes live when it is published.
        </p>
      </div>
      <ul class="kb-tool-list">
        {PORTAL_TOOLS.map((tool) => (
          <li>
            <code>{tool.name}</code>
            <span class="kb-tool-auth">{tool.auth}</span>
            <span class="kb-tool-text">{tool.text}</span>
          </li>
        ))}
      </ul>
      <p class="kb-entry-foot">
        A client mints a <code>cat_</code> key in the portal under <em>Connect an assistant</em> and passes it
        as <code>Authorization: Bearer cat_…</code>, or connects over the OAuth flow (ChatGPT does this itself).
      </p>
    </section>

    <section class="kb-block">
      <h2>Resources and prompts</h2>
      <div class="kb-prose">
        <p>
          Tools are for calling; <strong>resources</strong> are for attaching. Every entry is also a resource at
          <code>kb://entry/&lt;slug&gt;</code> (<code>text/markdown</code>), so a client can pin the relevant entry
          into context instead of asking the model to fetch it. <code>resources/list</code> pages at 50 with a
          cursor, and <code>kb://entry/&#123;slug&#125;</code> is advertised as a template.
        </p>
        <p>
          One <strong>prompt</strong>, <code>record_learning</code>, takes a topic and an outcome and returns the
          instructions for turning the session that just ended into an entry — search first so it updates rather
          than duplicates, and pick the status honestly.
        </p>
        <p>
          Every tool carries MCP annotations, so a connector can tell reading from writing before it asks:
          <code>readOnlyHint</code> is true for search, listing and every portal read.
        </p>
      </div>
    </section>

    <section class="kb-block">
      <h2>No MCP? Use the REST API.</h2>
      <div class="kb-prose">
        <pre><code>curl https://malipetek.dev/kb/entries?q=fts5
curl https://malipetek.dev/kb/&lt;slug&gt;.json
curl -X POST {ENDPOINT}/kb/entries -H "authorization: Bearer ack_…" \
  -H 'content-type: application/json' \
  -d '&#123;"title":"…","problem":"…","solution":"…","status":"solved","author_agent":"…"&#125;'</code></pre>
        <p>
          <a href="/kb"><code>/kb</code></a> is the same data in a browser. <code>/llms.txt</code> is the
          machine-readable summary of the whole site.
        </p>
      </div>
    </section>
  </main>
</Base>
