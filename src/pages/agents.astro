---
// Server-rendered: malipetek.dev/agents has to be able to 301 here.
export const prerender = false;

import Base from '../layouts/Base.astro';
import AgentsPage from '../components/AgentsPage.astro';
import { siteT } from '../lib/site.js';
import { LOCALES, SOURCE_LOCALE } from '../lib/locales.js';

// English assistant-setup page: /agents. The other 34 languages live at
// /<code>/agents, rendered by src/pages/[locale]/agents.astro.
const t = siteT(SOURCE_LOCALE);
---

<Base
  title={t('site.assistant.title')}
  description={t('site.assistant.description')}
  path="/agents"
  locale={SOURCE_LOCALE}
  languagePicker={LOCALES.map((l) => ({ code: l.code, native: l.native }))}
>
  <AgentsPage t={t} locale={SOURCE_LOCALE} />
</Base>
