---
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import { siteT } from "../../lib/site.js";
import { LOCALES } from "../../lib/locales.js";

// One homepage per language: /tr/, /de-DE/, /ja-JP/ … English stays at /.
// Server-rendered because the lab host has to be able to redirect these to
// malipetek.dev; a prerendered page would be served before middleware runs.
export const prerender = false;

const code = Astro.params.locale ?? "";
const locale = LOCALES.find((l) => l.code === code);

if (!locale || locale.code === "en-US") {
  return new Response("Not found", { status: 404 });
}

const t = siteT(locale.code);
---

<Base
  title={t("site.home.title")}
  description={t("site.home.description")}
  path="/"
  locale={locale.code}
  languagePicker={LOCALES.map((l) => ({ code: l.code, native: l.native }))}
>
  <Home t={t} locale={locale.code} />
</Base>
