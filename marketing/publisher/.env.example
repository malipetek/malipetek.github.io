# Copy to .env (gitignored) and fill in. publish.sh loads it.

# The secret the Worker checks on /marketing/publisher/*.
# Set it once with: cd worker && npx wrangler secret put MARKETING_TOKEN
MARKETING_TOKEN=

# Where the desk is. Defaults to https://malipetek.dev/api; use the zone mount,
# not *.workers.dev (that hostname answers 404/1042 here).
# MARKETING_API=http://127.0.0.1:8787

# The browser to drive. Auto-detected on macOS; set only if Chrome is elsewhere.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
