---
import '../styles/site.css';
const name = 'A new site';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <h1>{name}</h1>
      <p class="muted">Your site is up. Every change lands on the preview first and goes live when it is published.</p>
      <p>Start by telling this page what it is for.</p>
    </main>
  </body>
</html>
