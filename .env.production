# Build-time config baked into the client bundle. Public values only —
# never secrets. The Turnstile widget (domains include malipetek.dev) exists, so
# the client can request tokens; the matching secret is what turns enforcement
# on. Without this sitekey, setting TURNSTILE_SECRET_KEY on the Worker would
# break sign-in and chat with turnstile_failed.
PUBLIC_CHAT_ENDPOINT=https://malipetek-intercom.malipetek.workers.dev
PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAAewEfh8oJlivkPx
# GitHub App slug for the Keystatic admin auth flow (github.com/apps/<slug>).
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=malipetek-dev-keystatic
