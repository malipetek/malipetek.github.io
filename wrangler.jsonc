{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malipetek-site",
  "account_id": "a60af2542282e283101650bebed42dcf",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets built by `astro build` (prerendered pages, /_astro bundles,
  // public/*) are served by the assets binding; everything else SSRs.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },

  // Zone routes — the worker intercepts requests for proxied DNS records on
  // the zone. (Custom domains would manage DNS for us, but they refuse to
  // attach while the old GitHub Pages records exist.)
  "routes": [
    {
      "pattern": "malipetek.dev/*",
      "zone_name": "malipetek.dev"
    },
    {
      "pattern": "www.malipetek.dev/*",
      "zone_name": "malipetek.dev"
    },
  ],

  // Keystatic admin: set these three with `wrangler secret put` (see below) —
  // KEYSTATIC_GITHUB_CLIENT_ID / KEYSTATIC_GITHUB_CLIENT_SECRET come from the
  // GitHub OAuth app, KEYSTATIC_SECRET is a random string.
}
