{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malipetek-site",
  "account_id": "a60af2542282e283101650bebed42dcf",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Branch builds are reviewed at <branch>-malipetek-site.malipetek.workers.dev.
  // preview_urls defaults to workers_dev, so without it every master deploy
  // switches those URLs off. The plain workers.dev URL stays off.
  "workers_dev": false,
  "preview_urls": true,

  // Static assets built by `astro build` (prerendered pages, /_astro bundles,
  // public/*) are served by the assets binding; everything else SSRs.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Host redirects for prerendered pages have to run before the adapter
    // serves them from ASSETS (middleware never sees an asset response). These
    // are the only paths the split touches before Astro runs: /portal*,
    // /.well-known/* and /chat move to malipetek.dev, /blog/* and /projects/*
    // move to lab. Everything else is a server route and is handled by
    // src/middleware.ts. See src/worker.ts.
    "run_worker_first": [
      "/portal",
      "/portal/*",
      "/.well-known/*",
      "/chat",
      "/blog/*",
      "/projects/*",
    ],
  },

  // The public agentic coding knowledgebase, read directly by the SSR /kb
  // pages. Writes go through malipetek-intercom (which owns the API keys), so
  // this Worker only ever reads it.
  "d1_databases": [
    {
      "binding": "KB_DB",
      "database_name": "agentic-coding-kb",
      "database_id": "70a1d6f4-f3b9-4b31-b372-e9bc5d78a20c",
    },
  ],

  // Zone routes — the worker intercepts requests for proxied DNS records on
  // the zone. The apex and www keep zone routes because custom domains refuse
  // to attach while the old GitHub Pages records exist.
  //
  // The lab is a fresh subdomain with no old records, so it is a custom
  // domain: the same Worker answers both hosts and tells them apart by Host
  // (src/middleware.ts, src/worker.ts). Deploying creates the
  // lab.malipetek.dev DNS record and certificate in the zone.
  "routes": [
    {
      "pattern": "malipetek.dev/*",
      "zone_name": "malipetek.dev"
    },
    {
      "pattern": "www.malipetek.dev/*",
      "zone_name": "malipetek.dev"
    },
    {
      "pattern": "lab.malipetek.dev",
      "custom_domain": true
    },
  ],

  // /mcp and the OAuth discovery documents are answered by the intercom
  // Worker, proxied through this one (src/lib/workerProxy.ts). A service
  // binding is the only reliable hop between two Workers on the same zone —
  // a same-zone fetch is answered by the zone origin (the old GitHub Pages
  // site), not by the other Worker's route.
  "services": [
    {
      "binding": "INTERCOM",
      "service": "malipetek-intercom"
    }
  ],

  // Keystatic admin: set these three with `wrangler secret put` (see below) —
  // KEYSTATIC_GITHUB_CLIENT_ID / KEYSTATIC_GITHUB_CLIENT_SECRET come from the
  // GitHub OAuth app, KEYSTATIC_SECRET is a random string.
}
