{
  "name": "@malipetek/dsh-ai-workspace",
  "version": "1.0.0",
  "description": "Managed dev processes for a project folder: start them in the background, capture their logs, show them in a panel, and tell the agent to read those logs instead of re-running build/dev commands.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "meta": {
      "title": "AI Workspace",
      "description": "Managed dev processes with captured logs, a live panel, and agent instructions to read the logs instead of re-running commands."
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "dev-server",
    "logs"
  ],
  "author": "Muhammet Ali Petek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malipetek/malipetek.github.io.git",
    "directory": "packages/dsh-ai-workspace"
  },
  "homepage": "https://malipetek.dev/plugins/dsh-ai-workspace",
  "bugs": "https://github.com/malipetek/malipetek.github.io/issues",
  "publishConfig": {
    "access": "public"
  }
}
