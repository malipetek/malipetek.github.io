{
  "name": "@malipetek/dsh-action-cards",
  "version": "1.0.0",
  "description": "Action cards: the agent proposes a concrete action (create a file, edit a value, run a command), you edit it and apply it in one click, and the Host executes it and reports back.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "meta": {
      "title": "Action cards",
      "description": "Turn the agent's proposed actions into editable, one-click action cards."
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "approvals",
    "tooling"
  ],
  "author": "Muhammet Ali Petek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malipetek/malipetek.github.io.git",
    "directory": "packages/dsh-action-cards"
  },
  "homepage": "https://malipetek.dev/plugins/dsh-action-cards",
  "bugs": "https://github.com/malipetek/malipetek.github.io/issues",
  "publishConfig": {
    "access": "public"
  }
}
