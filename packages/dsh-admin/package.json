{
  "name": "@malipetek/dsh-admin",
  "version": "1.0.0",
  "description": "Admin panel for malipetek.dev: the ticket queue, clients and projects, with tools so an agent can triage them too.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "meta": {
      "title": "Admin",
      "description": "The malipetek.dev portal from inside the Harness: ticket queue with approve, reply and internal notes, plus clients and projects."
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "author": "Muhammet Ali Petek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malipetek/malipetek.github.io.git",
    "directory": "packages/dsh-admin"
  },
  "homepage": "https://malipetek.dev/plugins/dsh-admin",
  "bugs": "https://github.com/malipetek/malipetek.github.io/issues",
  "publishConfig": {
    "access": "public"
  }
}
